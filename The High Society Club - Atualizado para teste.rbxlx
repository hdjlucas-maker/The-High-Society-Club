        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">AchievementService</string>
            <string name="Source"><![CDATA[local EconomyService = require(script.Parent.EconomyService)

local AchievementService = {}

local catalog = {
	{
		Id = "first_job",
		Name = "Primeiro passo",
		Description = "Conclua sua primeira profissão.",
		Points = 10,
	},
	{
		Id = "five_jobs",
		Name = "Profissional em ascensão",
		Description = "Conclua cinco trabalhos.",
		Points = 25,
	},
	{
		Id = "city_guide",
		Name = "Embaixador da cidade",
		Description = "Conclua um passeio como guia turístico.",
		Points = 15,
	},
	{
		Id = "chauffeur",
		Name = "Rota de excelência",
		Description = "Conclua uma corrida como motorista particular.",
		Points = 15,
	},
	{
		Id = "photographer",
		Name = "Olhar de artista",
		Description = "Conclua um ensaio como fotógrafo virtual.",
		Points = 15,
	},
	{
		Id = "first_property",
		Name = "Novo endereço",
		Description = "Adquira sua primeira propriedade.",
		Points = 20,
	},
	{
		Id = "first_vehicle",
		Name = "Chaves do clube",
		Description = "Adquira seu primeiro veículo.",
		Points = 20,
	},
	{
		Id = "first_style",
		Name = "Estilo próprio",
		Description = "Adquira seu primeiro item de moda.",
		Points = 10,
	},
	{
		Id = "first_event",
		Name = "Presença marcante",
		Description = "Participe do seu primeiro evento.",
		Points = 15,
	},
}

local achievementsById = {}
for _, achievement in ipairs(catalog) do
	achievementsById[achievement.Id] = achievement
end

local unlockedRemote

local function unlock(player, achievementId)
	local profile = EconomyService.GetProfile(player)
	local definition = achievementsById[achievementId]
	if not profile or not definition then
		return false
	end

	profile.achievements = profile.achievements or {}
	if profile.achievements[achievementId] then
		return false
	end

	local unlockedAt = os.time()
	profile.achievements[achievementId] = unlockedAt
	if unlockedRemote and unlockedRemote.Parent then
		unlockedRemote:FireClient(player, {
			Id = achievementId,
			Name = definition.Name,
			Description = definition.Description,
			Points = definition.Points,
			UnlockedAt = unlockedAt,
		})
	end
	return true
end

function AchievementService.Init(remote)
	unlockedRemote = remote
end

function AchievementService.GetCatalog(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	local result = {}
	local reputation = 0
	for _, achievement in ipairs(catalog) do
		local unlockedAt = profile.achievements and profile.achievements[achievement.Id]
		if
			type(unlockedAt) == "number"
			and unlockedAt == unlockedAt
			and unlockedAt >= 0
			and unlockedAt <= 253_402_300_799
		then
			unlockedAt = math.floor(unlockedAt)
			reputation += achievement.Points
		else
			unlockedAt = nil
		end

		table.insert(result, {
			Id = achievement.Id,
			Name = achievement.Name,
			Description = achievement.Description,
			Points = achievement.Points,
			UnlockedAt = unlockedAt,
		})
	end

	local reputationTitle = "Visitante"
	if reputation >= 100 then
		reputationTitle = "Ícone da Alta Sociedade"
	elseif reputation >= 60 then
		reputationTitle = "Referência do Clube"
	elseif reputation >= 25 then
		reputationTitle = "Membro da Sociedade"
	end

	return {
		Achievements = result,
		Reputation = reputation,
		ReputationTitle = reputationTitle,
		CompletedJobs = profile.completedJobs or 0,
	}
end

function AchievementService.RecordJobCompleted(player, jobId)
	local profile = EconomyService.GetProfile(player)
	if not profile or type(jobId) ~= "string" then
		return
	end

	profile.completedJobs = math.min((profile.completedJobs or 0) + 1, 2_000_000_000)
	unlock(player, "first_job")
	if profile.completedJobs >= 5 then
		unlock(player, "five_jobs")
	end
	unlock(player, jobId)
end

function AchievementService.RecordMilestone(player, milestone)
	local achievementIdByMilestone = {
		PropertyPurchased = "first_property",
		VehiclePurchased = "first_vehicle",
		FashionPurchased = "first_style",
	}
	local achievementId = achievementIdByMilestone[milestone]
	if achievementId then
		unlock(player, achievementId)
	end
end

function AchievementService.RecordEventAttendance(player)
	unlock(player, "first_event")
end

return AchievementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("HSC")
local Config = require(Shared:WaitForChild("Config"))
local Logger = require(Shared:WaitForChild("Logger"))

local AdminService = {}
local RateLimitService = require(script.Parent.RateLimitService)

local initialized = false
local groupOwnerUserId
local groupLookupComplete = false
local MAX_MODERATION_LOGS = 50
local moderationLogs = {}

local function normalizeUserId(value)
	if
		type(value) ~= "number"
		or value ~= value
		or value <= 0
		or value > 9_007_199_254_740_991
		or value % 1 ~= 0
	then
		return nil
	end

	return value
end

local function recordModerationAction(admin, action, target, targetUserId, success, reason)
	local entry = {
		Timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time()),
		ActorUserId = admin.UserId,
		ActorName = admin.Name,
		Action = action,
		TargetUserId = target and target.UserId or targetUserId,
		TargetName = target and target.Name or nil,
		Success = success,
		Reason = reason,
	}

	table.insert(moderationLogs, entry)
	if #moderationLogs > MAX_MODERATION_LOGS then
		table.remove(moderationLogs, 1)
	end

	local targetDescription = entry.TargetUserId and (" targetUserId=" .. tostring(entry.TargetUserId)) or ""
	local targetName = entry.TargetName and string.format(" targetName=%q", entry.TargetName) or ""
	local message = string.format(
		"action=%s actorUserId=%d actorName=%q%s%s success=%s reason=%q",
		action,
		entry.ActorUserId,
		entry.ActorName,
		targetDescription,
		targetName,
		tostring(success),
		reason
	)
	if success then
		Logger.Info("Moderation", message)
	else
		Logger.Warn("Moderation", message)
	end
end

function AdminService.Init()
	if initialized then
		return
	end
	initialized = true

	if game.CreatorType ~= Enum.CreatorType.Group then
		groupLookupComplete = true
		return
	end

	task.spawn(function()
		local ok, groupInfo = pcall(function()
			return GroupService:GetGroupInfoAsync(game.CreatorId)
		end)
		if not ok then
			Logger.Warn("Admin", "Não foi possível consultar o proprietário do grupo: " .. tostring(groupInfo))
			groupLookupComplete = true
			return
		end

		local owner = type(groupInfo) == "table" and groupInfo.Owner
		if type(owner) == "table" and type(owner.Id) == "number" then
			groupOwnerUserId = owner.Id
		else
			Logger.Warn("Admin", "A resposta do Roblox não contém o proprietário do grupo.")
		end
		groupLookupComplete = true
	end)
end

function AdminService.IsCreator(player)
	if not player or not player:IsA("Player") then
		return false
	end

	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end

	return groupOwnerUserId ~= nil and player.UserId == groupOwnerUserId
end

function AdminService.GetStatus(player)
	if not player or not player:IsA("Player") then
		return false, "Jogador inválido"
	end
	for _, userId in ipairs(Config.AdminUserIds) do
		if userId == player.UserId then
			return true
		end
	end

	if game.CreatorType == Enum.CreatorType.Group then
		local deadline = os.clock() + 10
		while not groupLookupComplete and os.clock() < deadline do
			task.wait(0.1)
		end
		if not groupLookupComplete or not groupOwnerUserId then
			return false, "Não foi possível verificar o proprietário do grupo"
		end
	end

	return Config.AdminAllowExperienceCreator and AdminService.IsCreator(player)
end

function AdminService.KickPlayer(admin, targetUserId)
	if typeof(admin) ~= "Instance" or not admin:IsA("Player") then
		return false, "Jogador administrativo inválido"
	end
	if not RateLimitService.Allow(admin, "admin.action", Config.RateLimits.AdminActionCooldown) then
		return false, "Aguarde antes de executar outra ação administrativa"
	end

	local normalizedTargetUserId = normalizeUserId(targetUserId)
	local isAdmin, statusError = AdminService.GetStatus(admin)
	if not isAdmin then
		recordModerationAction(
			admin,
			"Kick",
			nil,
			normalizedTargetUserId,
			false,
			statusError or "Acesso administrativo negado"
		)
		return false, "Apenas o criador verificado pode usar este controle"
	end
	if not normalizedTargetUserId then
		recordModerationAction(admin, "Kick", nil, nil, false, "Identificador do jogador inválido")
		return false, "Identificador do jogador inválido"
	end

	local target = Players:GetPlayerByUserId(normalizedTargetUserId)
	if not target then
		recordModerationAction(
			admin,
			"Kick",
			nil,
			normalizedTargetUserId,
			false,
			"O jogador não está mais nesta sessão"
		)
		return false, "O jogador não está mais nesta sessão"
	end
	if target == admin then
		recordModerationAction(
			admin,
			"Kick",
			target,
			normalizedTargetUserId,
			false,
			"Tentativa de expulsar a própria conta"
		)
		return false, "Não é possível expulsar a própria conta por este painel"
	end
	if AdminService.IsCreator(target) then
		recordModerationAction(admin, "Kick", target, normalizedTargetUserId, false, "Proteção do criador")
		return false, "O criador do jogo não pode ser expulso por este painel"
	end

	recordModerationAction(admin, "Kick", target, normalizedTargetUserId, true, "Removido da sessão atual")
	target:Kick("Você foi removido desta sessão pelo criador do jogo.")
	return true, "Jogador removido desta sessão"
end

function AdminService.RecordInvalidAction(admin)
	if
		typeof(admin) ~= "Instance"
		or not admin:IsA("Player")
		or not RateLimitService.Allow(admin, "admin.action", Config.RateLimits.AdminActionCooldown)
	then
		return
	end

	recordModerationAction(admin, "InvalidAction", nil, nil, false, "Ação administrativa inválida")
end

function AdminService.GetRecentModerationLogs(player)
	if not RateLimitService.Allow(player, "admin.logs", Config.RateLimits.EventCatalogCooldown) then
		return nil, "Aguarde antes de consultar os logs de moderação"
	end
	local isAdmin, reason = AdminService.GetStatus(player)
	if not isAdmin then
		return nil, reason or "Acesso administrativo restrito"
	end

	local result = {}
	local firstIndex = math.max(1, #moderationLogs - 19)
	for index = #moderationLogs, firstIndex, -1 do
		local entry = moderationLogs[index]
		table.insert(result, {
			Timestamp = entry.Timestamp,
			ActorUserId = entry.ActorUserId,
			ActorName = entry.ActorName,
			Action = entry.Action,
			TargetUserId = entry.TargetUserId,
			TargetName = entry.TargetName,
			Success = entry.Success,
			Reason = entry.Reason,
		})
	end

	return result
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">AppearanceService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EconomyService = require(script.Parent.EconomyService)
local Logger = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("Logger"))
local fashionCatalog = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("FashionCatalog"))
local PlayerMarketService = require(script.Parent.PlayerMarketService)

local AppearanceService = {}

local ITEM_DEFINITIONS = {}
for _, item in ipairs(fashionCatalog) do
	ITEM_DEFINITIONS[item.Id] = {
		Slot = item.Slot,
		Color = item.Color,
	}
end

local function getBodyPart(character, preferredName, fallbackName)
	return character:FindFirstChild(preferredName) or character:FindFirstChild(fallbackName)
end

local function removeItemVisuals(character, itemId)
	for _, child in ipairs(character:GetChildren()) do
		if child:GetAttribute("SocietyWearable") and child:GetAttribute("SocietyItemId") == itemId then
			child:Destroy()
		end
	end
end

local function removeAllVisuals(character)
	for _, child in ipairs(character:GetChildren()) do
		if child:GetAttribute("SocietyWearable") then
			child:Destroy()
		end
	end
end

local function attachPart(character, itemId, bodyPart, name, size, offset, color, material)
	local part = Instance.new("Part")
	part.Name = "SocietyWearable_" .. itemId .. "_" .. name
	part.Size = size
	part.CFrame = bodyPart.CFrame * offset
	part.Color = color
	part.Material = material
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("SocietyWearable", true)
	part:SetAttribute("SocietyItemId", itemId)
	part.Parent = character

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = bodyPart
	weld.Part1 = part
	weld.Parent = part

	return part
end

local function applyJacket(character, color)
	local torso = getBodyPart(character, "UpperTorso", "Torso")
	if not torso or not torso:IsA("BasePart") then
		return false, "Não foi possível encontrar o torso do avatar"
	end

	local fit = Vector3.new(0.12, 0.08, 0.12)
	attachPart(character, "elite_jacket", torso, "Jacket", torso.Size + fit, CFrame.new(), color, Enum.Material.Fabric)

	local frontZ = -(torso.Size.Z / 2 + 0.075)
	for side = -1, 1, 2 do
		attachPart(
			character,
			"elite_jacket",
			torso,
			"GoldTrim",
			Vector3.new(0.07, math.max(0.35, torso.Size.Y * 0.62), 0.04),
			CFrame.new(side * 0.13, 0, frontZ),
			Color3.fromRGB(221, 183, 93),
			Enum.Material.Metal
		)
	end

	return true
end

local function applyWatch(character, color)
	local arm = getBodyPart(character, "RightHand", "Right Arm")
	if not arm or not arm:IsA("BasePart") then
		return false, "Não foi possível encontrar a mão direita do avatar"
	end

	local wristOffset = CFrame.new(0, -arm.Size.Y * 0.38, 0)
	attachPart(
		character,
		"luxury_watch",
		arm,
		"WatchBand",
		Vector3.new(math.max(0.35, arm.Size.X * 0.85), 0.2, math.max(0.35, arm.Size.Z * 0.85)),
		wristOffset,
		color,
		Enum.Material.Metal
	)
	attachPart(
		character,
		"luxury_watch",
		arm,
		"WatchFace",
		Vector3.new(0.28, 0.08, 0.28),
		wristOffset * CFrame.new(0, 0.12, -arm.Size.Z * 0.44),
		Color3.fromRGB(30, 32, 38),
		Enum.Material.Metal
	)

	return true
end

local function applyGlasses(character, color)
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return false, "Não foi possível encontrar a cabeça do avatar"
	end

	local lensSize = Vector3.new(head.Size.X * 0.34, head.Size.Y * 0.22, 0.08)
	local lensY = -head.Size.Y * 0.05
	local frontZ = -(head.Size.Z / 2 + 0.045)
	for side = -1, 1, 2 do
		attachPart(
			character,
			"sunset_glasses",
			head,
			"Lens",
			lensSize,
			CFrame.new(side * head.Size.X * 0.2, lensY, frontZ),
			color,
			Enum.Material.Glass
		)
		attachPart(
			character,
			"sunset_glasses",
			head,
			"Frame",
			Vector3.new(lensSize.X + 0.08, 0.06, 0.1),
			CFrame.new(side * head.Size.X * 0.2, lensY + lensSize.Y / 2, frontZ),
			Color3.fromRGB(34, 32, 35),
			Enum.Material.Metal
		)
	end

	attachPart(
		character,
		"sunset_glasses",
		head,
		"Bridge",
		Vector3.new(head.Size.X * 0.12, 0.06, 0.1),
		CFrame.new(0, lensY, frontZ),
		Color3.fromRGB(34, 32, 35),
		Enum.Material.Metal
	)

	return true
end

local function applySneakers(character, color)
	for _, side in ipairs({ "Left", "Right" }) do
		local foot = getBodyPart(character, side .. "Foot", side .. " Leg")
		if not foot or not foot:IsA("BasePart") then
			return false, "Não foi possível encontrar os pés do avatar"
		end
	end

	for _, side in ipairs({ "Left", "Right" }) do
		local foot = getBodyPart(character, side .. "Foot", side .. " Leg")
		local shoeSize = Vector3.new(
			math.max(0.65, foot.Size.X * 1.08),
			math.max(0.25, math.min(0.45, foot.Size.Y * 0.55)),
			math.max(0.75, foot.Size.Z * 1.12)
		)
		local shoeOffset = CFrame.new(0, -foot.Size.Y * 0.36, -foot.Size.Z * 0.08)

		attachPart(
			character,
			"island_sneakers",
			foot,
			side .. "Sneaker",
			shoeSize,
			shoeOffset,
			color,
			Enum.Material.SmoothPlastic
		)
		attachPart(
			character,
			"island_sneakers",
			foot,
			side .. "Sole",
			Vector3.new(shoeSize.X * 1.04, 0.08, shoeSize.Z * 1.04),
			shoeOffset * CFrame.new(0, -shoeSize.Y / 2, 0),
			Color3.fromRGB(46, 47, 51),
			Enum.Material.Rubber
		)
	end

	return true
end

local function applyItem(character, itemId)
	local definition = ITEM_DEFINITIONS[itemId]
	if not definition then
		return false, "Item visual não encontrado"
	end

	if itemId == "elite_jacket" then
		return applyJacket(character, definition.Color)
	elseif itemId == "luxury_watch" then
		return applyWatch(character, definition.Color)
	elseif itemId == "sunset_glasses" then
		return applyGlasses(character, definition.Color)
	elseif itemId == "island_sneakers" then
		return applySneakers(character, definition.Color)
	end

	return false, "Item visual não suportado"
end

local function applyProfile(player, character)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return false, "Perfil do jogador ainda não foi carregado"
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
	if not humanoid or not character.Parent then
		return false, "Avatar não ficou pronto para equipar os itens"
	end

	removeAllVisuals(character)
	for itemId, equipped in pairs(profile.equippedItems or {}) do
		if equipped == true and profile.inventory[itemId] then
			local success, reason = applyItem(character, itemId)
			if not success then
				Logger.Warn("Appearance", string.format("Não foi possível equipar %s: %s", itemId, reason))
			end
		end
	end

	return true
end

function AppearanceService.SetEquipped(player, itemId, shouldEquip)
	if typeof(itemId) ~= "string" or typeof(shouldEquip) ~= "boolean" then
		return false, "Solicitação de equipagem inválida"
	end

	local definition = ITEM_DEFINITIONS[itemId]
	if not definition then
		return false, "Item não encontrado"
	end

	local profile = EconomyService.GetProfile(player)
	if not profile then
		return false, "Perfil do jogador ainda não foi carregado"
	end
	if not profile.inventory[itemId] then
		return false, "Você não possui este item"
	end
	if shouldEquip and PlayerMarketService.IsItemListed(player, itemId) then
		return false, "Retire o anúncio do mercado antes de equipar este item"
	end

	local character = player.Character
	if not character then
		return false, "Personagem não encontrado"
	end

	if not shouldEquip then
		profile.equippedItems[itemId] = nil
		removeItemVisuals(character, itemId)
		return true, "Item removido"
	end

	if profile.equippedItems[itemId] then
		removeItemVisuals(character, itemId)
		return applyItem(character, itemId)
	end

	local success, reason = applyItem(character, itemId)
	if not success then
		return false, reason
	end

	for equippedId in pairs(profile.equippedItems) do
		local equippedDefinition = ITEM_DEFINITIONS[equippedId]
		if equippedDefinition and equippedDefinition.Slot == definition.Slot then
			profile.equippedItems[equippedId] = nil
			removeItemVisuals(character, equippedId)
		end
	end
	profile.equippedItems[itemId] = true
	return true, "Item equipado"
end

function AppearanceService.Init()
	local function applyWhenReady(player, character)
		task.spawn(function()
			local deadline = os.clock() + 30
			while player.Parent and os.clock() < deadline do
				if player.Character ~= character then
					return
				end
				if EconomyService.GetProfile(player) then
					local success, reason = applyProfile(player, character)
					if not success then
						Logger.Warn("Appearance", string.format("Falha no avatar de %s: %s", player.Name, reason))
					end
					return
				end
				task.wait(0.25)
			end
		end)
	end

	local function trackPlayer(player)
		local appearanceLoaded = {}
		player.CharacterAppearanceLoaded:Connect(function(character)
			appearanceLoaded[character] = true
			applyWhenReady(player, character)
		end)

		player.CharacterAdded:Connect(function(character)
			task.spawn(function()
				local deadline = os.clock() + 10
				while player.Parent and player.Character == character and not appearanceLoaded[character] do
					if os.clock() >= deadline then
						applyWhenReady(player, character)
						return
					end
					task.wait(0.25)
				end
			end)
		end)

		if player.Character then
			applyWhenReady(player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(trackPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		trackPlayer(player)
	end
end

return AppearanceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">ClubService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("Config"))
local WorkService = require(script.Parent.WorkService)

local ClubService = {}

local styles = {
	golden_gala = {
		Name = "Gala dourada",
		Colors = {
			Color3.fromRGB(255, 215, 120),
			Color3.fromRGB(255, 244, 205),
			Color3.fromRGB(222, 174, 76),
		},
	},
	ocean_lounge = {
		Name = "Lounge oceânico",
		Colors = {
			Color3.fromRGB(76, 195, 220),
			Color3.fromRGB(140, 225, 238),
			Color3.fromRGB(60, 120, 185),
		},
	},
	neon_night = {
		Name = "Noite neon",
		Colors = {
			Color3.fromRGB(206, 100, 240),
			Color3.fromRGB(78, 196, 255),
			Color3.fromRGB(245, 96, 155),
		},
	},
}

local stageLight
local stageBeams = {}
local stageModel
local music
local performance

local function findStage()
	local world = workspace:FindFirstChild(Config.Map.WorldName)
	local decorations = world and world:FindFirstChild("EventDecorations")
	local stage = decorations and decorations:FindFirstChild("ClubStage")
	return stage
end

local function updateLights(style, beat)
	if not stageLight or not stageModel then
		return
	end

	local colorIndex = (beat - 1) % #style.Colors + 1
	local color = style.Colors[colorIndex]
	stageLight.Color = color
	stageLight.Brightness = 1 + (beat % 2) * 0.7
	stageModel:SetAttribute("ShowColor", color)

	for index, beam in ipairs(stageBeams) do
		beam.Color = color
		beam.Brightness = index == colorIndex and 2 or 0.6
	end
end

local function stopPerformance()
	performance = nil
	if stageModel then
		stageModel:SetAttribute("ShowActive", false)
		stageModel:SetAttribute("DJName", nil)
	end
	if stageLight then
		stageLight.Color = Color3.fromRGB(218, 180, 91)
		stageLight.Brightness = 0.6
	end
	for _, beam in ipairs(stageBeams) do
		beam.Brightness = 0
	end
	if music and music.IsPlaying then
		music:Stop()
	end
end

local function getPublicStatus(player)
	local canOperate = WorkService.CanOperateDJBooth(player)
	local remaining = performance and math.max(0, math.ceil(performance.ExpiresAt - os.clock())) or 0
	return {
		ShowActive = performance ~= nil,
		DJName = performance and performance.DJName or nil,
		StyleId = performance and performance.StyleId or nil,
		StyleName = performance and styles[performance.StyleId].Name or nil,
		SecondsRemaining = remaining,
		CanOperate = canOperate,
		IsPerformer = performance ~= nil and performance.UserId == player.UserId,
		MusicConfigured = music ~= nil and music.SoundId ~= "",
		Styles = {
			{ Id = "golden_gala", Name = styles.golden_gala.Name },
			{ Id = "ocean_lounge", Name = styles.ocean_lounge.Name },
			{ Id = "neon_night", Name = styles.neon_night.Name },
		},
	}
end

function ClubService.Init()
	stageModel = findStage()
	if not stageModel or not stageModel:IsA("Model") then
		error("Workspace.HighSocietyWorld.EventDecorations.ClubStage precisa existir antes de inicializar ClubService")
	end
	local lightBar = stageModel:FindFirstChild("LightBar")
	stageLight = lightBar and lightBar:FindFirstChild("StageLight")
	if not lightBar or not lightBar:IsA("BasePart") or not stageLight or not stageLight:IsA("PointLight") then
		error("ClubStage precisa conter LightBar.StageLight")
	end
	for index = 1, 3 do
		local beam = lightBar:FindFirstChild("StageBeam" .. index)
		if not beam or not beam:IsA("SpotLight") then
			error(string.format("ClubStage precisa conter StageBeam%d", index))
		end
		table.insert(stageBeams, beam)
	end

	local soundId = Config.Club.MusicSoundId
	if typeof(soundId) ~= "string" or (soundId ~= "" and not string.match(soundId, "^rbxassetid://%d+$")) then
		error("Config.Club.MusicSoundId precisa estar vazio ou usar o formato rbxassetid://<ID>")
	end
	if
		typeof(Config.Club.MaxPerformanceDuration) ~= "number"
		or Config.Club.MaxPerformanceDuration <= 0
		or Config.Club.MaxPerformanceDuration ~= math.floor(Config.Club.MaxPerformanceDuration)
	then
		error("Config.Club.MaxPerformanceDuration precisa ser um inteiro positivo")
	end
	if soundId ~= "" then
		music = lightBar:FindFirstChild("ClubMusic")
		if music and not music:IsA("Sound") then
			error("ClubStage.LightBar.ClubMusic precisa ser Sound")
		end
		if not music then
			music = Instance.new("Sound")
			music.Name = "ClubMusic"
			music.Parent = lightBar
		end
		music.SoundId = soundId
		music.Looped = true
		music.Volume = 0.35
	end

	stageModel:SetAttribute("ShowActive", false)
	task.spawn(function()
		local beat = 0
		while true do
			task.wait(1.25)
			if not performance then
				continue
			end

			local performer = Players:GetPlayerByUserId(performance.UserId)
			if not performer or os.clock() >= performance.ExpiresAt or not WorkService.CanOperateDJBooth(performer) then
				stopPerformance()
				continue
			end

			beat += 1
			updateLights(styles[performance.StyleId], beat)
		end
	end)
end

function ClubService.GetStatus(player)
	if not player or player.Parent ~= Players then
		return nil, "Jogador inválido"
	end
	return getPublicStatus(player)
end

function ClubService.HandleRequest(player, action, styleId)
	if not player or player.Parent ~= Players then
		return false, "Jogador inválido"
	end
	if typeof(action) ~= "string" then
		return false, "Solicitação da cabine inválida"
	end
	if not WorkService.CanOperateDJBooth(player) then
		return false, "Conclua a rota de DJ e aproxime-se da cabine do Grand Society Club"
	end

	if action == "Start" then
		if performance then
			return false, "Já existe uma apresentação em andamento"
		end
		if styleId ~= nil and (typeof(styleId) ~= "string" or not styles[styleId]) then
			return false, "Estilo de apresentação inválido"
		end
		local selectedStyle = styleId or "golden_gala"
		performance = {
			UserId = player.UserId,
			DJName = player.DisplayName,
			StyleId = selectedStyle,
			ExpiresAt = os.clock() + Config.Club.MaxPerformanceDuration,
		}
		stageModel:SetAttribute("ShowActive", true)
		stageModel:SetAttribute("DJName", player.DisplayName)
		stageModel:SetAttribute("StyleId", selectedStyle)
		if music and not music.IsPlaying then
			music:Play()
		end
		updateLights(styles[selectedStyle], 1)
		return true, "Apresentação iniciada no Grand Society Club"
	end

	if not performance or performance.UserId ~= player.UserId then
		return false, "Somente o DJ da apresentação atual pode controlar a cabine"
	end
	if action == "Stop" then
		stopPerformance()
		return true, "Apresentação encerrada"
	end
	if action == "SetStyle" then
		if typeof(styleId) ~= "string" or not styles[styleId] then
			return false, "Estilo de apresentação inválido"
		end
		performance.StyleId = styleId
		stageModel:SetAttribute("StyleId", styleId)
		updateLights(styles[styleId], 1)
		return true, "Estilo alterado: " .. styles[styleId].Name
	end

	return false, "Ação de cabine inválida"
end

function ClubService.CleanupPlayer(player)
	if performance and performance.UserId == player.UserId then
		stopPerformance()
	end
end

return ClubService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">CreationBuilder</string>
            <string name="Source"><![CDATA[local CreationBuilder = {}

local EXHIBIT_NAME = "ApprovedCreationExhibits"
local DISPLAY_LIMIT = 6
local PLOT_SIZE = Vector3.new(20, 1, 18)
local PLOT_POSITIONS = {
	Vector2.new(-24, -60),
	Vector2.new(16, -60),
	Vector2.new(56, -60),
	Vector2.new(-24, -90),
	Vector2.new(16, -90),
	Vector2.new(56, -90),
}

local themes = {
	Jardim = {
		Ground = Color3.fromRGB(84, 121, 76),
		Accent = Color3.fromRGB(203, 181, 111),
		Structure = Color3.fromRGB(226, 221, 199),
		Material = Enum.Material.Grass,
	},
	Costeiro = {
		Ground = Color3.fromRGB(207, 188, 143),
		Accent = Color3.fromRGB(70, 146, 174),
		Structure = Color3.fromRGB(231, 236, 224),
		Material = Enum.Material.Sand,
	},
	Urbano = {
		Ground = Color3.fromRGB(75, 79, 87),
		Accent = Color3.fromRGB(219, 180, 90),
		Structure = Color3.fromRGB(171, 181, 190),
		Material = Enum.Material.Concrete,
	},
}

local function makePart(parent, name, size, cframe, color, material, shape)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = true
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		part.Shape = shape
	end
	part.Parent = parent
	return part
end

local function makeSign(parent, text, position, color)
	local sign = makePart(
		parent,
		"CreatorSign",
		Vector3.new(12, 2.4, 0.3),
		CFrame.new(position),
		Color3.fromRGB(24, 27, 32),
		Enum.Material.SmoothPlastic
	)
	local surface = Instance.new("SurfaceGui")
	surface.Name = "SignSurface"
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 24
	surface.Parent = sign

	local label = Instance.new("TextLabel")
	label.Name = "Title"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = surface
end

local function buildPavilion(model, origin, palette)
	for _, offset in ipairs({
		Vector3.new(-5, 3.2, -4),
		Vector3.new(5, 3.2, -4),
		Vector3.new(-5, 3.2, 4),
		Vector3.new(5, 3.2, 4),
	}) do
		makePart(
			model,
			"PavilionColumn",
			Vector3.new(0.9, 5, 0.9),
			CFrame.new(origin + Vector3.new(offset.X, 2.5, offset.Z)),
			palette.Structure,
			Enum.Material.Marble
		)
	end
	makePart(
		model,
		"PavilionRoof",
		Vector3.new(13, 0.8, 11),
		CFrame.new(origin + Vector3.new(0, 5.4, 0)),
		palette.Accent,
		Enum.Material.Metal
	)
end

local function buildPlaza(model, origin, palette)
	makePart(
		model,
		"PlazaFountainBasin",
		Vector3.new(7, 0.8, 7),
		CFrame.new(origin + Vector3.new(0, 0.4, 0)),
		palette.Accent,
		Enum.Material.Marble,
		Enum.PartType.Cylinder
	)
	makePart(
		model,
		"PlazaFountain",
		Vector3.new(2.4, 2.6, 2.4),
		CFrame.new(origin + Vector3.new(0, 1.7, 0)),
		palette.Structure,
		Enum.Material.Marble,
		Enum.PartType.Cylinder
	)
	makePart(
		model,
		"PlazaFeature",
		Vector3.new(1, 0.4, 1),
		CFrame.new(origin + Vector3.new(0, 3.2, 0)),
		palette.Accent,
		Enum.Material.Neon,
		Enum.PartType.Ball
	)
end

local function buildPromenade(model, origin, palette)
	makePart(
		model,
		"PromenadeWalk",
		Vector3.new(5, 0.35, 15),
		CFrame.new(origin + Vector3.new(0, 0.175, 0)),
		palette.Structure,
		Enum.Material.Marble
	)
	for _, zOffset in ipairs({ -5, 5 }) do
		makePart(
			model,
			"PromenadeLamp",
			Vector3.new(0.45, 5.2, 0.45),
			CFrame.new(origin + Vector3.new(6, 2.6, zOffset)),
			palette.Accent,
			Enum.Material.Metal
		)
		makePart(
			model,
			"PromenadeLight",
			Vector3.new(1.4, 0.5, 1.4),
			CFrame.new(origin + Vector3.new(6, 5.45, zOffset)),
			palette.Accent,
			Enum.Material.Neon
		)
		makePart(
			model,
			"PromenadeTree",
			Vector3.new(2.6, 2.6, 2.6),
			CFrame.new(origin + Vector3.new(-6, 1.3, zOffset)),
			palette.Ground,
			Enum.Material.Grass,
			Enum.PartType.Ball
		)
	end
end

function CreationBuilder.Update(world, creations)
	if typeof(world) ~= "Instance" or type(creations) ~= "table" then
		return false, "Mundo ou lista de criações inválida"
	end
	local workPoints = world:FindFirstChild("WorkPoints")
	local finishPoint = workPoints and workPoints:FindFirstChild("WorldCreatorFinish")
	if not finishPoint or not finishPoint:IsA("BasePart") then
		return false, "Ponto da Galeria WorldCreatorFinish não está disponível"
	end

	local count = math.min(#creations, DISPLAY_LIMIT)
	local fingerprintParts = {}
	for index = 1, count do
		local creation = creations[index]
		if type(creation) == "table" then
			table.insert(
				fingerprintParts,
				string.format("%s:%s:%s", tostring(creation.Id), tostring(creation.Theme), tostring(creation.Layout))
			)
		end
	end
	local fingerprint = table.concat(fingerprintParts, "|")

	local existing = world:FindFirstChild(EXHIBIT_NAME)
	if existing then
		if not existing:IsA("Folder") or existing:GetAttribute("GeneratedBy") ~= "CreationBuilder" then
			return false, "O nome ApprovedCreationExhibits já pertence a um objeto do projeto"
		end
		if existing:GetAttribute("Fingerprint") == fingerprint then
			return true
		end
		existing:Destroy()
	end

	local gallery = Instance.new("Folder")
	gallery.Name = EXHIBIT_NAME
	gallery:SetAttribute("GeneratedBy", "CreationBuilder")
	gallery:SetAttribute("Fingerprint", fingerprint)

	local groundY = finishPoint.Position.Y - 2

	for index = 1, count do
		local creation = creations[index]
		local palette = type(creation) == "table" and themes[creation.Theme]
		if palette and (creation.Layout == "Pavilhão" or creation.Layout == "Praça" or creation.Layout == "Passeio") then
			local positionOffset = PLOT_POSITIONS[index]
			local position = Vector3.new(
				finishPoint.Position.X + positionOffset.X,
				groundY,
				finishPoint.Position.Z + positionOffset.Y
			)
			local plot = Instance.new("Model")
			plot.Name = string.format("ApprovedCreation_%d", index)
			plot:SetAttribute("SubmissionId", creation.Id)
			plot:SetAttribute("CreatorUserId", creation.CreatorUserId)
			plot.Parent = gallery

			local origin = Vector3.new(position.X, groundY + PLOT_SIZE.Y, position.Z)
			makePart(
				plot,
				"DisplayPlot",
				PLOT_SIZE,
				CFrame.new(position.X, groundY + PLOT_SIZE.Y / 2, position.Z),
				palette.Ground,
				palette.Material
			)

			if creation.Layout == "Pavilhão" then
				buildPavilion(plot, origin, palette)
			elseif creation.Layout == "Praça" then
				buildPlaza(plot, origin, palette)
			else
				buildPromenade(plot, origin, palette)
			end
			makeSign(
				plot,
				string.format("%s • %s", creation.Theme, creation.Layout),
				origin + Vector3.new(0, 2.2, -8.7),
				palette.Accent
			)
		end
	end

	gallery.Parent = world
	return true
end

return CreationBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">CreationService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("HSC")
local Config = require(Shared:WaitForChild("Config"))
local Logger = require(Shared:WaitForChild("Logger"))
local AdminService = require(script.Parent.AdminService)
local RateLimitService = require(script.Parent.RateLimitService)
local CreationBuilder = require(script.Parent.CreationBuilder)

local CreationService = {}

local settings = Config.CreationModeration
local dataStore
local initialized = false
local worldRoot
local QUEUE_KEY = "Submissions"

local themes = {
	["tema de jardim"] = "Jardim",
	["tema costeiro"] = "Costeiro",
	["tema urbano"] = "Urbano",
}

local layouts = {
	["layout de pavilhão"] = "Pavilhão",
	["layout de praça"] = "Praça",
	["layout de passeio"] = "Passeio",
}

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function retry(operation)
	local lastError
	for attempt = 1, Config.DataStore.MaxRetries do
		local ok, result = pcall(operation)
		if ok then
			return true, result
		end
		lastError = result
		Logger.Warn("Creation", string.format("Tentativa %d/%d falhou: %s", attempt, Config.DataStore.MaxRetries, tostring(result)))
		if attempt < Config.DataStore.MaxRetries then
			task.wait(attempt * 2)
		end
	end
	return false, lastError
end

local function normalizeQueue(value)
	if value == nil then
		return {}
	end
	if type(value) ~= "table" then
		return nil, "A fila salva de criações tem formato inválido"
	end
	local queue = {}
	for _, entry in ipairs(value) do
		if
			type(entry) == "table"
			and type(entry.Id) == "string"
			and #entry.Id <= 64
			and isFiniteNumber(entry.CreatorUserId)
			and entry.CreatorUserId > 0
			and entry.CreatorUserId % 1 == 0
			and type(entry.Theme) == "string"
			and themes[entry.Theme]
			and type(entry.Layout) == "string"
			and layouts[entry.Layout]
			and (entry.Status == "Pending" or entry.Status == "Approved" or entry.Status == "Rejected")
			and isFiniteNumber(entry.SubmittedAt)
			and entry.SubmittedAt >= 0
			and entry.SubmittedAt <= 253_402_300_799
		then
			table.insert(queue, {
				Id = entry.Id,
				CreatorUserId = math.floor(entry.CreatorUserId),
				CreatorName = type(entry.CreatorName) == "string" and string.sub(entry.CreatorName, 1, 20) or "Jogador",
				Theme = entry.Theme,
				Layout = entry.Layout,
				Status = entry.Status,
				SubmittedAt = math.floor(entry.SubmittedAt),
				ReviewedAt = isFiniteNumber(entry.ReviewedAt)
						and entry.ReviewedAt >= 0
						and entry.ReviewedAt <= 253_402_300_799
					and math.floor(entry.ReviewedAt)
					or nil,
				ReviewerUserId = isFiniteNumber(entry.ReviewerUserId)
						and entry.ReviewerUserId > 0
						and entry.ReviewerUserId % 1 == 0
					and math.floor(entry.ReviewerUserId)
					or nil,
				ReviewId = type(entry.ReviewId) == "string" and string.sub(entry.ReviewId, 1, 64) or nil,
			})
		end
	end
	return queue
end

local function findById(queue, id)
	for _, entry in ipairs(queue) do
		if entry.Id == id then
			return entry
		end
	end
	return nil
end

local function readQueue()
	if not dataStore then
		return nil, "O armazenamento da fila de criações está indisponível"
	end
	local success, result = retry(function()
		return dataStore:GetAsync(QUEUE_KEY)
	end)
	if not success then
		return nil, "Não foi possível consultar a fila de criações: " .. tostring(result)
	end
	return normalizeQueue(result)
end

local function copyPublicEntry(entry)
	return {
		Id = entry.Id,
		CreatorUserId = entry.CreatorUserId,
		CreatorName = entry.CreatorName,
		Theme = themes[entry.Theme],
		Layout = layouts[entry.Layout],
		SubmittedAt = entry.SubmittedAt,
	}
end

local function ensureReviewer(player)
	if not RateLimitService.Allow(player, "creations.review.query", Config.RateLimits.CreationQueryCooldown) then
		return false, "Aguarde antes de atualizar a fila de revisão"
	end
	local isAdmin, reason = AdminService.GetStatus(player)
	if not isAdmin then
		return false, reason or "Acesso restrito ao criador e administradores"
	end
	return true
end

function CreationService.Init()
	worldRoot = workspace:FindFirstChild(Config.Map.WorldName)
	if initialized then
		return dataStore ~= nil
	end
	initialized = true
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(settings.DataStoreName)
	end)
	if not ok then
		Logger.Error("Creation", "Não foi possível abrir o armazenamento de criações: " .. tostring(result))
		return false
	end
	dataStore = result
	task.spawn(function()
		local approved, err = readQueue()
		if not approved then
			Logger.Warn("Creation", "Não foi possível carregar criações aprovadas para a Galeria: " .. tostring(err))
			return
		end
		local publicCreations = {}
		for _, entry in ipairs(approved) do
			if entry.Status == "Approved" then
				table.insert(publicCreations, copyPublicEntry(entry))
			end
		end
		table.sort(publicCreations, function(left, right)
			return left.SubmittedAt > right.SubmittedAt
		end)
		while #publicCreations > settings.MaxPublicCreations do
			table.remove(publicCreations)
		end
		local updated, updateError = CreationBuilder.Update(worldRoot, publicCreations)
		if not updated then
			Logger.Warn("Creation", "Não foi possível construir a Galeria de criações: " .. tostring(updateError))
		end
	end)
	return true
end

function CreationService.SubmitWorldConcept(player, submissionId, theme, layout)
	if not dataStore then
		return false, "A fila persistente de criações está indisponível"
	end
	if
		typeof(player) ~= "Instance"
		or not player:IsA("Player")
		or player.Parent ~= Players
		or type(submissionId) ~= "string"
		or #submissionId > 64
		or not submissionId:match("^[%w%-]+$")
		or not themes[theme]
		or not layouts[layout]
	then
		return false, "Proposta de cenário inválida"
	end
	if not RateLimitService.Allow(player, "creations.submit", Config.RateLimits.CreationSubmitCooldown) then
		return false, "Aguarde antes de reenviar a proposta para revisão"
	end

	local success, result = retry(function()
		return dataStore:UpdateAsync(QUEUE_KEY, function(current)
			local queue, queueError = normalizeQueue(current)
			if not queue then
				error(queueError)
			end
			local existing = findById(queue, submissionId)
			if existing then
				return queue
			end
			for _, entry in ipairs(queue) do
				if entry.CreatorUserId == player.UserId and entry.Status == "Pending" then
					return queue
				end
			end

			if #queue >= settings.MaxStoredSubmissions then
				local removableIndex
				for index, entry in ipairs(queue) do
					if entry.Status ~= "Pending" then
						removableIndex = index
						break
					end
				end
				if not removableIndex then
					return queue
				end
				table.remove(queue, removableIndex)
			end

			table.insert(queue, {
				Id = submissionId,
				CreatorUserId = player.UserId,
				CreatorName = player.Name,
				Theme = theme,
				Layout = layout,
				Status = "Pending",
				SubmittedAt = os.time(),
			})
			return queue
		end)
	end)
	if not success then
		return false, "Não foi possível salvar a proposta: " .. tostring(result)
	end

	local queue, queueError = normalizeQueue(result)
	if not queue then
		return false, queueError
	end
	local entry = findById(queue, submissionId)
	if entry and entry.CreatorUserId == player.UserId and entry.Status == "Pending" then
		return true, "Proposta enviada para revisão"
	end
	for _, candidate in ipairs(queue) do
		if candidate.CreatorUserId == player.UserId and candidate.Status == "Pending" then
			return false, "Você já tem uma proposta aguardando revisão"
		end
	end
	return false, "A fila está cheia; tente novamente mais tarde"
end

function CreationService.GetApproved(player)
	if not RateLimitService.Allow(player, "creations.gallery.query", Config.RateLimits.CreationQueryCooldown) then
		return nil, "Aguarde antes de atualizar a Galeria"
	end
	local queue, err = readQueue()
	if not queue then
		return nil, err
	end
	local approved = {}
	for _, entry in ipairs(queue) do
		if entry.Status == "Approved" then
			table.insert(approved, copyPublicEntry(entry))
		end
	end
	table.sort(approved, function(left, right)
		return left.SubmittedAt > right.SubmittedAt
	end)
	while #approved > settings.MaxPublicCreations do
		table.remove(approved)
	end
	local updated, updateError = CreationBuilder.Update(worldRoot, approved)
	if not updated then
		Logger.Warn("Creation", "Não foi possível atualizar as maquetes da Galeria: " .. tostring(updateError))
		return nil, "Não foi possível atualizar a Galeria: " .. tostring(updateError)
	end
	return approved
end

function CreationService.GetPending(player)
	local authorized, authError = ensureReviewer(player)
	if not authorized then
		return nil, authError
	end
	local queue, err = readQueue()
	if not queue then
		return nil, err
	end
	local pending = {}
	for _, entry in ipairs(queue) do
		if entry.Status == "Pending" then
			table.insert(pending, copyPublicEntry(entry))
		end
	end
	table.sort(pending, function(left, right)
		return left.SubmittedAt < right.SubmittedAt
	end)
	return pending
end

function CreationService.Review(player, submissionId, decision)
	if not RateLimitService.Allow(player, "creations.review.action", Config.RateLimits.CreationReviewCooldown) then
		return false, "Aguarde antes de revisar outra proposta"
	end
	local isAdmin, authError = AdminService.GetStatus(player)
	if not isAdmin then
		return false, authError or "Acesso restrito ao criador e administradores"
	end
	if
		type(submissionId) ~= "string"
		or #submissionId > 64
		or not submissionId:match("^[%w%-]+$")
		or (decision ~= "Approve" and decision ~= "Reject")
	then
		return false, "Ação de revisão inválida"
	end
	if not dataStore then
		return false, "A fila persistente de criações está indisponível"
	end

	local targetStatus = decision == "Approve" and "Approved" or "Rejected"
	local reviewId = HttpService:GenerateGUID(false)
	local success, result = retry(function()
		return dataStore:UpdateAsync(QUEUE_KEY, function(current)
			local queue, queueError = normalizeQueue(current)
			if not queue then
				error(queueError)
			end
			local entry = findById(queue, submissionId)
			if entry and entry.Status == "Pending" then
				entry.Status = targetStatus
				entry.ReviewedAt = os.time()
				entry.ReviewerUserId = player.UserId
				entry.ReviewId = reviewId
			end
			return queue
		end)
	end)
	if not success then
		Logger.Error("Creation", "Falha na revisão da proposta " .. submissionId .. ": " .. tostring(result))
		return false, "Não foi possível registrar a decisão: " .. tostring(result)
	end
	local queue, queueError = normalizeQueue(result)
	if not queue then
		return false, queueError
	end
	local entry = findById(queue, submissionId)
	if not entry or entry.ReviewId ~= reviewId or entry.Status ~= targetStatus then
		return false, "Proposta não encontrada ou já revisada"
	end

	Logger.Info(
		"Creation",
		string.format(
			"REVIEW | submission=%s | creatorUserId=%d | reviewerUserId=%d | decision=%s",
			submissionId,
			entry.CreatorUserId,
			player.UserId,
			targetStatus
		)
	)
	if targetStatus == "Approved" then
		local approved = {}
		for _, candidate in ipairs(queue) do
			if candidate.Status == "Approved" then
				table.insert(approved, copyPublicEntry(candidate))
			end
		end
		table.sort(approved, function(left, right)
			return left.SubmittedAt > right.SubmittedAt
		end)
		while #approved > settings.MaxPublicCreations do
			table.remove(approved)
		end
		local updated, updateError = CreationBuilder.Update(worldRoot, approved)
		if not updated then
			Logger.Warn("Creation", "Aprovação registrada, mas a Galeria não foi atualizada: " .. tostring(updateError))
			return true, "Aprovação registrada; a Galeria será atualizada quando estiver disponível"
		end
	end
	return true, targetStatus == "Approved" and "Proposta aprovada e publicada na Galeria" or "Proposta recusada"
end

return CreationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DailyRewardService</string>
            <string name="Source"><![CDATA[local EconomyService = require(script.Parent.EconomyService)

local DailyRewardService = {}

local BASE_REWARD = 100
local STREAK_INCREMENT = 25
local MAX_REWARD = 300
local MAX_STREAK = 3650

local function getUtcDay()
	return math.floor(os.time() / 86400)
end

local function getReward(streak)
	return math.min(BASE_REWARD + math.max(streak - 1, 0) * STREAK_INCREMENT, MAX_REWARD)
end

function DailyRewardService.GetStatus(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	local today = getUtcDay()
	local streak = profile.dailyRewardStreak or 0
	local alreadyClaimed = (profile.dailyRewardDay or 0) >= today
	local projectedStreak = if alreadyClaimed
		then streak
		elseif (profile.dailyRewardDay or 0) == today - 1 then math.min(streak + 1, MAX_STREAK)
		else 1
	local secondsUntilReset = (today + 1) * 86400 - os.time()

	return {
		ClaimedToday = alreadyClaimed,
		CurrentStreak = streak,
		NextStreak = projectedStreak,
		Reward = alreadyClaimed and 0 or getReward(projectedStreak),
		SecondsUntilReset = secondsUntilReset,
	}
end

function DailyRewardService.Claim(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return false, "Perfil do jogador ainda não foi carregado"
	end

	local today = getUtcDay()
	if (profile.dailyRewardDay or 0) >= today then
		return false, "Você já resgatou sua recompensa diária. Volte após a virada UTC."
	end

	local previousDay = profile.dailyRewardDay or 0
	local streak = previousDay == today - 1 and math.min((profile.dailyRewardStreak or 0) + 1, MAX_STREAK) or 1
	local reward = getReward(streak)
	local granted, reason = EconomyService.AddCredits(player, reward, {
		Type = "DailyReward",
	})
	if not granted then
		return false, reason
	end

	profile.dailyRewardDay = today
	profile.dailyRewardStreak = streak
	return true,
		{
			Reward = reward,
			Streak = streak,
			Message = string.format(
				"Recompensa diária resgatada: +%d Society Credits • sequência de %d dias.",
				reward,
				streak
			),
		}
end

return DailyRewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("HSC")
local Config = require(Shared:WaitForChild("Config"))
local Logger = require(Shared:WaitForChild("Logger"))

local DataService = {}

local dataStore
local initialized = false
local sessionPrefix = game.JobId ~= "" and game.JobId or HttpService:GenerateGUID(false)

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function retry(operation)
	local lastError
	for attempt = 1, Config.DataStore.MaxRetries do
		local ok, result = pcall(operation)
		if ok then
			return true, result
		end
		lastError = result
		Logger.Warn(
			"Data",
			string.format("Tentativa %d/%d falhou: %s", attempt, Config.DataStore.MaxRetries, tostring(result))
		)
		if attempt < Config.DataStore.MaxRetries then
			task.wait(attempt * 2)
		end
	end
	return false, lastError
end

local function acquireProfileData(player, sessionId)
	local key = "Player_" .. player.UserId
	local deadline = os.clock() + Config.DataStore.SessionLockWait
	local invalidStoredData = false
	local lockedUntil

	while os.clock() < deadline do
		if not player.Parent then
			return nil, "Jogador saiu antes de carregar os dados", true
		end

		invalidStoredData = false
		lockedUntil = nil
		local success, result = retry(function()
			return dataStore:UpdateAsync(key, function(stored)
				invalidStoredData = false
				lockedUntil = nil
				if stored ~= nil and type(stored) ~= "table" then
					invalidStoredData = true
					return nil
				end

				stored = type(stored) == "table" and stored or {}
				local lock = stored.__SessionLock
				if
					type(lock) == "table"
					and lock.SessionId ~= sessionId
					and isFiniteNumber(lock.ExpiresAt)
					and lock.ExpiresAt > os.time()
				then
					lockedUntil = lock.ExpiresAt
					return nil
				end

				stored.__SessionLock = {
					SessionId = sessionId,
					ExpiresAt = os.time() + Config.DataStore.SessionLockTtl,
				}
				return stored
			end)
		end)

		if not success then
			return nil, tostring(result), false
		end
		if invalidStoredData then
			return nil, "Os dados salvos do jogador não têm o formato esperado", true
		end
		if
			type(result) == "table"
			and type(result.__SessionLock) == "table"
			and result.__SessionLock.SessionId == sessionId
		then
			return result
		end

		local waitTime = lockedUntil and math.clamp(math.min(5, lockedUntil - os.time()), 1, 5) or 5
		task.wait(waitTime)
	end

	return nil, "Os dados deste jogador continuam abertos em outro servidor", true
end

function DataService.Init()
	if initialized then
		return dataStore ~= nil
	end
	initialized = true

	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStore.Name)
	end)
	if not ok then
		Logger.Warn("Data", "Não foi possível obter o DataStore: " .. tostring(result))
		return false
	end

	dataStore = result
	return true
end

function DataService.IsAvailable()
	return dataStore ~= nil
end

function DataService.LoadProfile(player)
	if not player or not player:IsA("Player") then
		return nil, "Jogador inválido", true
	end
	if not dataStore then
		return nil, "DataStore indisponível", false
	end

	local sessionId = sessionPrefix .. ":" .. HttpService:GenerateGUID(false)
	local data, loadError, lockConflict = acquireProfileData(player, sessionId)
	return data, loadError, lockConflict, sessionId
end

function DataService.SaveProfile(userId, sessionId, payload)
	if typeof(userId) ~= "number" or userId <= 0 or typeof(sessionId) ~= "string" or typeof(payload) ~= "table" then
		return false, "Dados de salvamento inválidos", false
	end
	if not dataStore then
		return false, "DataStore indisponível", false
	end

	local storedPayload = table.clone(payload)
	storedPayload.__SessionLock = {
		SessionId = sessionId,
		ExpiresAt = os.time() + Config.DataStore.SessionLockTtl,
	}

	local success, result = retry(function()
		return dataStore:UpdateAsync("Player_" .. userId, function(stored)
			local lock = type(stored) == "table" and stored.__SessionLock
			if type(lock) ~= "table" or lock.SessionId ~= sessionId then
				return nil
			end
			return storedPayload
		end)
	end)
	if not success then
		return false, tostring(result), false
	end
	if
		type(result) ~= "table"
		or type(result.__SessionLock) ~= "table"
		or result.__SessionLock.SessionId ~= sessionId
	then
		return false, "A sessão dos dados foi perdida", true
	end

	return true
end

function DataService.ApplyDeveloperProductReceipt(userId, sessionId, purchaseId, productId, credits, playerName, payload)
	if
		typeof(userId) ~= "number"
		or userId <= 0
		or type(sessionId) ~= "string"
		or type(purchaseId) ~= "string"
		or purchaseId == ""
		or #purchaseId > 100
		or type(productId) ~= "string"
		or #productId > 40
		or not isFiniteNumber(credits)
		or credits <= 0
		or credits % 1 ~= 0
		or credits > Config.Economy.MaxCurrency
		or type(playerName) ~= "string"
		or type(payload) ~= "table"
		or not isFiniteNumber(payload.coins)
		or payload.coins < 0
		or payload.coins % 1 ~= 0
		or payload.coins > Config.Economy.MaxCurrency
		or not isFiniteNumber(payload.TotalEarned)
		or payload.TotalEarned < 0
		or payload.TotalEarned % 1 ~= 0
		or type(payload.transactions) ~= "table"
	then
		return false, "Dados de recibo inválidos"
	end
	if not dataStore then
		return false, "DataStore indisponível"
	end

	local lostSession = false
	local balanceLimitReached = false
	local alreadyProcessed = false
	local invalidData = false
	local receiptAppliedByCall = false
	local success, result = retry(function()
		return dataStore:UpdateAsync("Player_" .. userId, function(stored)
			lostSession = false
			balanceLimitReached = false
			alreadyProcessed = false
			invalidData = false
			if type(stored) ~= "table" then
				invalidData = true
				return nil
			end

			local lock = stored.__SessionLock
			if type(lock) ~= "table" or lock.SessionId ~= sessionId then
				lostSession = true
				return nil
			end

			local processedReceipts = type(stored.processedDeveloperReceipts) == "table"
				and stored.processedDeveloperReceipts
				or {}
			if processedReceipts[purchaseId] == true then
				alreadyProcessed = not receiptAppliedByCall
				return stored
			end

			if payload.coins > Config.Economy.MaxCurrency - credits then
				balanceLimitReached = true
				return nil
			end

			local updated = table.clone(stored)
			updated.coins = payload.coins + credits
			updated.TotalEarned = math.min(Config.Economy.MaxCurrency, payload.TotalEarned + credits)

			local transactions = table.clone(payload.transactions)
			table.insert(transactions, {
				Type = "DeveloperProductPurchase",
				Amount = credits,
				Time = os.time(),
				UserId = userId,
				PlayerName = playerName,
				Result = "Success",
				ProductId = productId,
				ReceiptId = purchaseId,
			})
			while #transactions > Config.Economy.MaxTransactions do
				table.remove(transactions, 1)
			end
			updated.transactions = transactions

			local receiptMap = table.clone(processedReceipts)
			if type(payload.processedDeveloperReceipts) == "table" then
				for storedPurchaseId, wasProcessed in pairs(payload.processedDeveloperReceipts) do
					if wasProcessed == true then
						receiptMap[storedPurchaseId] = true
					end
				end
			end
			receiptMap[purchaseId] = true
			updated.processedDeveloperReceipts = receiptMap
			updated.__SessionLock = {
				SessionId = sessionId,
				ExpiresAt = os.time() + Config.DataStore.SessionLockTtl,
			}
			receiptAppliedByCall = true
			return updated
		end)
	end)

	if not success then
		return false, tostring(result)
	end
	if invalidData then
		return false, "Os dados salvos do jogador não têm o formato esperado"
	end
	if balanceLimitReached then
		return false, "O saldo está no limite; use créditos antes de resgatar esta compra"
	end
	if lostSession then
		return false, "A sessão dos dados foi perdida"
	end
	if
		type(result) ~= "table"
		or type(result.__SessionLock) ~= "table"
		or result.__SessionLock.SessionId ~= sessionId
		or type(result.processedDeveloperReceipts) ~= "table"
		or result.processedDeveloperReceipts[purchaseId] ~= true
	then
		return false, "Não foi possível confirmar o recibo no perfil"
	end

	return true, result, alreadyProcessed
end

function DataService.ReleaseProfileLock(userId, sessionId)
	if not dataStore then
		return false, "DataStore indisponível"
	end

	local success, result = retry(function()
		return dataStore:UpdateAsync("Player_" .. userId, function(stored)
			local lock = type(stored) == "table" and stored.__SessionLock
			if type(lock) ~= "table" or lock.SessionId ~= sessionId then
				return nil
			end

			stored.__SessionLock = nil
			return stored
		end)
	end)
	if not success then
		return false, tostring(result)
	end
	if type(result) ~= "table" or result.__SessionLock ~= nil then
		return false, "A sessão não é mais proprietária do bloqueio dos dados"
	end

	return true
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">DayNightService</string>
            <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")

local DayNightService = {}

local CYCLE_DURATION = 24 * 60
local START_HOUR = 8
local UPDATE_INTERVAL = 5

local keyframes = {
	{
		Hour = 0,
		Brightness = 1.15,
		Exposure = -0.2,
		Ambient = Color3.fromRGB(57, 65, 91),
		OutdoorAmbient = Color3.fromRGB(42, 51, 79),
		AtmosphereColor = Color3.fromRGB(92, 111, 153),
		AtmosphereDecay = Color3.fromRGB(35, 44, 71),
		Density = 0.32,
		Haze = 1.4,
		Tint = Color3.fromRGB(188, 199, 255),
		Saturation = -0.12,
	},
	{
		Hour = 5,
		Brightness = 1.3,
		Exposure = -0.1,
		Ambient = Color3.fromRGB(117, 101, 111),
		OutdoorAmbient = Color3.fromRGB(108, 91, 101),
		AtmosphereColor = Color3.fromRGB(255, 184, 145),
		AtmosphereDecay = Color3.fromRGB(156, 110, 119),
		Density = 0.28,
		Haze = 1.8,
		Tint = Color3.fromRGB(255, 231, 211),
		Saturation = 0.02,
	},
	{
		Hour = 7,
		Brightness = 2,
		Exposure = 0,
		Ambient = Color3.fromRGB(146, 147, 155),
		OutdoorAmbient = Color3.fromRGB(131, 143, 157),
		AtmosphereColor = Color3.fromRGB(201, 218, 255),
		AtmosphereDecay = Color3.fromRGB(126, 128, 145),
		Density = 0.24,
		Haze = 1.2,
		Tint = Color3.fromRGB(255, 246, 232),
		Saturation = 0.04,
	},
	{
		Hour = 12,
		Brightness = 2.4,
		Exposure = 0.05,
		Ambient = Color3.fromRGB(151, 155, 164),
		OutdoorAmbient = Color3.fromRGB(143, 153, 165),
		AtmosphereColor = Color3.fromRGB(199, 222, 255),
		AtmosphereDecay = Color3.fromRGB(114, 125, 145),
		Density = 0.2,
		Haze = 0.7,
		Tint = Color3.fromRGB(255, 255, 255),
		Saturation = 0.06,
	},
	{
		Hour = 17,
		Brightness = 2,
		Exposure = -0.02,
		Ambient = Color3.fromRGB(157, 139, 130),
		OutdoorAmbient = Color3.fromRGB(154, 127, 112),
		AtmosphereColor = Color3.fromRGB(255, 197, 149),
		AtmosphereDecay = Color3.fromRGB(159, 119, 106),
		Density = 0.25,
		Haze = 1.6,
		Tint = Color3.fromRGB(255, 229, 205),
		Saturation = 0.08,
	},
	{
		Hour = 19,
		Brightness = 1.1,
		Exposure = -0.18,
		Ambient = Color3.fromRGB(88, 83, 112),
		OutdoorAmbient = Color3.fromRGB(72, 70, 105),
		AtmosphereColor = Color3.fromRGB(135, 117, 171),
		AtmosphereDecay = Color3.fromRGB(59, 57, 93),
		Density = 0.3,
		Haze = 1.8,
		Tint = Color3.fromRGB(216, 205, 255),
		Saturation = -0.02,
	},
	{
		Hour = 21,
		Brightness = 0.8,
		Exposure = -0.25,
		Ambient = Color3.fromRGB(57, 65, 91),
		OutdoorAmbient = Color3.fromRGB(42, 51, 79),
		AtmosphereColor = Color3.fromRGB(92, 111, 153),
		AtmosphereDecay = Color3.fromRGB(35, 44, 71),
		Density = 0.32,
		Haze = 1.4,
		Tint = Color3.fromRGB(188, 199, 255),
		Saturation = -0.12,
	},
	{
		Hour = 24,
		Brightness = 1.15,
		Exposure = -0.2,
		Ambient = Color3.fromRGB(57, 65, 91),
		OutdoorAmbient = Color3.fromRGB(42, 51, 79),
		AtmosphereColor = Color3.fromRGB(92, 111, 153),
		AtmosphereDecay = Color3.fromRGB(35, 44, 71),
		Density = 0.32,
		Haze = 1.4,
		Tint = Color3.fromRGB(188, 199, 255),
		Saturation = -0.12,
	},
}

local initialized = false
local atmosphere
local colorCorrection

local function getOrCreateEffect(className, name)
	local effect = Lighting:FindFirstChild(name)
	if effect then
		if not effect:IsA(className) then
			error(string.format("Lighting.%s precisa ser %s", name, className))
		end
		return effect
	end

	effect = Instance.new(className)
	effect.Name = name
	effect.Parent = Lighting
	return effect
end

local function getPhase(hour)
	if hour >= 6 and hour < 12 then
		return "Manhã"
	elseif hour >= 12 and hour < 18 then
		return "Tarde"
	elseif hour >= 18 and hour < 21 then
		return "Entardecer"
	end

	return "Noite"
end

local function getLightingPreset(hour)
	for index = 1, #keyframes - 1 do
		local current = keyframes[index]
		local nextFrame = keyframes[index + 1]
		if hour >= current.Hour and hour < nextFrame.Hour then
			local alpha = (hour - current.Hour) / (nextFrame.Hour - current.Hour)
			return current, nextFrame, alpha
		end
	end

	return keyframes[1], keyframes[2], 0
end

local function interpolate(current, nextFrame, alpha)
	Lighting.Brightness = current.Brightness + (nextFrame.Brightness - current.Brightness) * alpha
	Lighting.ExposureCompensation = current.Exposure + (nextFrame.Exposure - current.Exposure) * alpha
	Lighting.Ambient = current.Ambient:Lerp(nextFrame.Ambient, alpha)
	Lighting.OutdoorAmbient = current.OutdoorAmbient:Lerp(nextFrame.OutdoorAmbient, alpha)
	atmosphere.Color = current.AtmosphereColor:Lerp(nextFrame.AtmosphereColor, alpha)
	atmosphere.Decay = current.AtmosphereDecay:Lerp(nextFrame.AtmosphereDecay, alpha)
	atmosphere.Density = current.Density + (nextFrame.Density - current.Density) * alpha
	atmosphere.Haze = current.Haze + (nextFrame.Haze - current.Haze) * alpha
	colorCorrection.TintColor = current.Tint:Lerp(nextFrame.Tint, alpha)
	colorCorrection.Saturation = current.Saturation + (nextFrame.Saturation - current.Saturation) * alpha
end

function DayNightService.Init()
	if initialized then
		return
	end
	initialized = true

	atmosphere = getOrCreateEffect("Atmosphere", "HSC_DayNightAtmosphere")
	atmosphere.Glare = 0.15
	colorCorrection = getOrCreateEffect("ColorCorrectionEffect", "HSC_DayNightColor")
	colorCorrection.Contrast = 0.04

	local startedAt = os.clock()
	task.spawn(function()
		local lastPhase
		while true do
			local elapsed = os.clock() - startedAt
			local hour = (START_HOUR + (elapsed / CYCLE_DURATION) * 24) % 24
			local current, nextFrame, alpha = getLightingPreset(hour)

			Lighting.ClockTime = hour
			interpolate(current, nextFrame, alpha)

			local phase = getPhase(hour)
			if phase ~= lastPhase then
				lastPhase = phase
				Lighting:SetAttribute("HSC_TimePhase", phase)
			end

			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return DayNightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("HSC")
local Config = require(Shared:WaitForChild("Config"))
local Logger = require(Shared:WaitForChild("Logger"))
local DataService = require(script.Parent.DataService)

local EconomyService = {}

local MAX_CURRENCY = Config.Economy.MaxCurrency
local MAX_TRANSACTIONS = Config.Economy.MaxTransactions
local AUTOSAVE_INTERVAL = Config.DataStore.AutosaveInterval

local currencyChanged
local profiles = {}
local loadingProfiles = {}
local savingProfiles = {}
local transactionLocks = {}
local closingProfiles = {}
local finalizingProfiles = {}
local initialized = false

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function sanitizeCurrency(value)
	if not isFiniteNumber(value) then
		return 0
	end

	return math.clamp(math.floor(value), 0, MAX_CURRENCY)
end

local function sanitizeProfessionCompletions(value)
	local result = {}
	if type(value) ~= "table" then
		return result
	end

	local count = 0
	for professionId, completions in pairs(value) do
		if
			count >= 20
			or type(professionId) ~= "string"
			or #professionId > 40
			or not professionId:match("^[%w_]+$")
		then
			continue
		end

		result[professionId] = sanitizeCurrency(completions)
		count += 1
	end

	return result
end

local function makeDefaultProfile(data, isTemporary)
	data = type(data) == "table" and data or {}

	local hasLegacyBalance = data.coins ~= nil or data.Credits ~= nil
	local bonusClaimed = data.FirstJoinBonusClaimed == true or (data.FirstJoinBonusClaimed == nil and hasLegacyBalance)

	return {
		coins = sanitizeCurrency(data.coins or data.Credits or 0),
		FirstJoinBonusClaimed = bonusClaimed,
		TotalEarned = sanitizeCurrency(data.TotalEarned or 0),
		TotalSpent = sanitizeCurrency(data.TotalSpent or 0),
		LastLogin = isFiniteNumber(data.LastLogin) and data.LastLogin or os.time(),
		inventory = type(data.inventory) == "table" and data.inventory or {},
		transactions = type(data.transactions) == "table" and data.transactions or {},
		achievements = type(data.achievements) == "table" and data.achievements or {},
		completedJobs = sanitizeCurrency(data.completedJobs or 0),
		professionCompletions = sanitizeProfessionCompletions(data.professionCompletions),
		eventPoints = sanitizeCurrency(data.eventPoints or 0),
		eventClaims = type(data.eventClaims) == "table" and data.eventClaims or {},
		dailyRewardDay = sanitizeCurrency(data.dailyRewardDay or 0),
		dailyRewardStreak = math.min(sanitizeCurrency(data.dailyRewardStreak or 0), 3650),
		properties = type(data.properties) == "table" and data.properties or {},
		vehicles = type(data.vehicles) == "table" and data.vehicles or {},
		equippedItems = type(data.equippedItems) == "table" and data.equippedItems or {},
		processedDeveloperReceipts = type(data.processedDeveloperReceipts) == "table"
			and data.processedDeveloperReceipts
			or {},
		Temporary = isTemporary == true,
	}
end

local function logTransaction(player, transaction)
	local reference = transaction.ItemId
		or transaction.PropertyId
		or transaction.VehicleId
		or transaction.JobId
		or "none"
	local peer = transaction.PeerUserId and (" | peerUserId=" .. tostring(transaction.PeerUserId)) or ""
	Logger.Info(
		"Economy",
		string.format(
			"TRANSACTION | userId=%d | player=%s | type=%s | amount=%d | result=%s | reference=%s%s",
			player.UserId,
			player.Name,
			transaction.Type,
			transaction.Amount,
			transaction.Result,
			reference,
			peer
		)
	)
end

local function makeTransaction(player, transaction)
	local normalized = {
		Type = transaction.Type,
		Amount = math.floor(transaction.Amount),
		Time = math.floor(transaction.Time or os.time()),
		UserId = player.UserId,
		PlayerName = player.Name,
		Result = "Success",
	}
	for _, field in ipairs({ "ItemId", "PropertyId", "VehicleId", "JobId", "ProductId" }) do
		if type(transaction[field]) == "string" then
			normalized[field] = transaction[field]
		end
	end
	if type(transaction.PeerUserId) == "number" and transaction.PeerUserId % 1 == 0 then
		normalized.PeerUserId = transaction.PeerUserId
	end
	return normalized
end

local function recordTransaction(player, profile, transaction)
	local entry = makeTransaction(player, transaction)
	table.insert(profile.transactions, entry)

	while #profile.transactions > MAX_TRANSACTIONS do
		table.remove(profile.transactions, 1)
	end
	logTransaction(player, entry)
end

local function updateLeaderstat(player, profile)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local credits = leaderstats:FindFirstChild("Society Credits")
	if not credits then
		credits = Instance.new("IntValue")
		credits.Name = "Society Credits"
		credits.Parent = leaderstats
	end

	credits.Value = profile.coins
	profile.Stats = credits
end

local function notifyClient(player, profile)
	if currencyChanged and currencyChanged.Parent then
		currencyChanged:FireClient(player, profile.coins)
	end
end

local function cloneTable(value)
	if type(value) ~= "table" then
		return value
	end

	local copy = {}
	for key, item in pairs(value) do
		copy[key] = cloneTable(item)
	end
	return copy
end

local function makeProfilePayload(profile)
	return {
		coins = profile.coins,
		FirstJoinBonusClaimed = profile.FirstJoinBonusClaimed,
		TotalEarned = profile.TotalEarned,
		TotalSpent = profile.TotalSpent,
		LastLogin = profile.LastLogin,
		inventory = cloneTable(profile.inventory),
		transactions = cloneTable(profile.transactions),
		achievements = cloneTable(profile.achievements),
		completedJobs = profile.completedJobs,
		professionCompletions = cloneTable(profile.professionCompletions),
		eventPoints = profile.eventPoints,
		eventClaims = cloneTable(profile.eventClaims),
		dailyRewardDay = profile.dailyRewardDay,
		dailyRewardStreak = profile.dailyRewardStreak,
		properties = cloneTable(profile.properties),
		vehicles = cloneTable(profile.vehicles),
		equippedItems = cloneTable(profile.equippedItems),
		processedDeveloperReceipts = cloneTable(profile.processedDeveloperReceipts),
	}
end

function EconomyService.Init(currencyRemote)
	currencyChanged = currencyRemote

	if initialized then
		return
	end
	initialized = true
	DataService.Init()

	Players.PlayerRemoving:Connect(function(player)
		EconomyService.FinalizePlayer(player)
	end)

	game:BindToClose(function()
		local pending = 0

		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				EconomyService.FinalizePlayer(player)
				pending -= 1
			end)
		end

		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in pairs(profiles) do
				task.spawn(EconomyService.SavePlayerData, player)
			end
		end
	end)
end

function EconomyService.LoadPlayer(player)
	if not player or not player:IsA("Player") then
		return nil, "Jogador inválido"
	end

	while loadingProfiles[player] do
		task.wait()
	end

	if profiles[player] then
		return profiles[player]
	end

	loadingProfiles[player] = true
	local function finish(profile, err)
		loadingProfiles[player] = nil
		return profile, err
	end

	local data
	local loadError
	local lockConflict
	local sessionId

	data, loadError, lockConflict, sessionId = DataService.LoadProfile(player)

	local temporary = false
	if loadError then
		if not RunService:IsStudio() or lockConflict then
			return finish(nil, tostring(loadError))
		end

		temporary = true
		Logger.Warn(
			"Economy",
			"Usando perfil temporário no Studio. Este perfil não será salvo: " .. tostring(loadError)
		)
		data = nil
	end

	if not player.Parent then
		if not temporary and sessionId then
			local released, releaseError = DataService.ReleaseProfileLock(player.UserId, sessionId)
			if not released then
				Logger.Warn(
					"Economy",
					string.format("Não foi possível liberar os dados de %s: %s", player.Name, tostring(releaseError))
				)
			end
		end
		return finish(nil, "Jogador saiu antes de concluir o carregamento")
	end

	local profile = makeDefaultProfile(data, temporary)
	profile.SessionLocked = not temporary
	profile.SessionId = sessionId
	profile.LastLogin = os.time()
	profile.Loaded = true
	profiles[player] = profile

	updateLeaderstat(player, profile)
	notifyClient(player, profile)

	return finish(profile)
end

function EconomyService.SavePlayerData(player, isFinalSave)
	while savingProfiles[player] or transactionLocks[player] do
		task.wait(0.05)
	end
	if closingProfiles[player] and not isFinalSave then
		return false, "Perfil sendo finalizado"
	end

	local profile = profiles[player]
	if not profile or not profile.Loaded then
		return false, "Perfil não carregado"
	end

	if profile.Temporary then
		return true
	end

	if not DataService.IsAvailable() then
		return false, "DataStore indisponível"
	end
	if profile.LockLost then
		return false, "A sessão dos dados foi perdida"
	end

	savingProfiles[player] = true
	profile.LastLogin = os.time()

	local payload = makeProfilePayload(profile)
	local success, result, lockLost = DataService.SaveProfile(player.UserId, profile.SessionId, payload)
	savingProfiles[player] = nil

	if not success then
		local err = tostring(result)
		Logger.Warn("Economy", "Falha ao salvar " .. player.Name .. ": " .. err)
		if lockLost then
			profile.LockLost = true
			if player.Parent then
				player:Kick("A sessão dos seus dados foi interrompida. Entre novamente para proteger seu progresso.")
			end
		end
		return false, err
	end

	return true
end

function EconomyService.FinalizePlayer(player)
	if finalizingProfiles[player] then
		while finalizingProfiles[player] do
			task.wait(0.05)
		end
		return
	end

	finalizingProfiles[player] = true
	closingProfiles[player] = true
	while savingProfiles[player] do
		task.wait(0.05)
	end

	local profile = profiles[player]
	if profile and profile.Loaded then
		local saved, saveError = EconomyService.SavePlayerData(player, true)
		if saved and profile.SessionLocked then
			local released, releaseError = DataService.ReleaseProfileLock(player.UserId, profile.SessionId)
			if not released then
				Logger.Warn(
					"Economy",
					string.format("Não foi possível liberar os dados de %s: %s", player.Name, tostring(releaseError))
				)
			end
		elseif not saved then
			Logger.Warn(
				"Economy",
				string.format("Dados de %s podem não ter sido salvos ao sair: %s", player.Name, tostring(saveError))
			)
		end
	end

	profiles[player] = nil
	closingProfiles[player] = nil
	finalizingProfiles[player] = nil
end

function EconomyService.GetProfile(player)
	local profile = profiles[player]
	if not profile or not profile.Loaded or profile.LockLost then
		return nil
	end

	return profile
end

function EconomyService.GetCoins(player)
	local profile = EconomyService.GetProfile(player)
	return profile and profile.coins or nil
end

function EconomyService.GetRecentTransactions(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	local transactions = {}
	local firstIndex = math.max(1, #profile.transactions - 19)
	for index = #profile.transactions, firstIndex, -1 do
		local transaction = profile.transactions[index]
		if
			type(transaction) == "table"
			and type(transaction.Type) == "string"
			and isFiniteNumber(transaction.Amount)
			and transaction.Amount >= 0
			and transaction.Amount <= MAX_CURRENCY
			and isFiniteNumber(transaction.Time)
			and transaction.Time >= 0
			and transaction.Time <= 253_402_300_799
		then
			table.insert(transactions, {
				Type = transaction.Type,
				Amount = math.floor(transaction.Amount),
				Time = math.floor(transaction.Time),
				UserId = isFiniteNumber(transaction.UserId) and math.floor(transaction.UserId) or player.UserId,
				PlayerName = type(transaction.PlayerName) == "string" and transaction.PlayerName or player.Name,
				Result = type(transaction.Result) == "string" and transaction.Result or "Success",
				ItemId = type(transaction.ItemId) == "string" and transaction.ItemId or nil,
				PropertyId = type(transaction.PropertyId) == "string" and transaction.PropertyId or nil,
				VehicleId = type(transaction.VehicleId) == "string" and transaction.VehicleId or nil,
				JobId = type(transaction.JobId) == "string" and transaction.JobId or nil,
				ProductId = type(transaction.ProductId) == "string" and transaction.ProductId or nil,
				PeerUserId = isFiniteNumber(transaction.PeerUserId) and math.floor(transaction.PeerUserId) or nil,
			})
		end
	end

	return transactions
end

function EconomyService.CanAfford(player, amount)
	if not isFiniteNumber(amount) or amount <= 0 or amount % 1 ~= 0 then
		return false
	end

	local profile = EconomyService.GetProfile(player)
	return profile ~= nil and profile.coins >= amount
end

function EconomyService.AddCoins(player, amount, transactionMetadata)
	if not isFiniteNumber(amount) or amount <= 0 or amount % 1 ~= 0 or amount > MAX_CURRENCY then
		return false, "Quantidade inválida"
	end
	if transactionLocks[player] then
		return false, "Outra transação está em andamento"
	end
	transactionLocks[player] = true

	local profile = EconomyService.GetProfile(player)
	if not profile then
		transactionLocks[player] = nil
		return false, "Perfil do jogador ainda não foi carregado"
	end

	if profile.coins > MAX_CURRENCY - amount then
		transactionLocks[player] = nil
		return false, "Limite máximo de créditos atingido"
	end

	profile.coins += amount
	profile.TotalEarned = sanitizeCurrency(profile.TotalEarned + amount)
	local transaction = {
		Type = "Earn",
		Amount = amount,
		Time = os.time(),
	}
	if type(transactionMetadata) == "table" then
		if type(transactionMetadata.Type) == "string" then
			transaction.Type = transactionMetadata.Type
		end
		if type(transactionMetadata.ItemId) == "string" then
			transaction.ItemId = transactionMetadata.ItemId
		end
		if type(transactionMetadata.PropertyId) == "string" then
			transaction.PropertyId = transactionMetadata.PropertyId
		end
		if type(transactionMetadata.VehicleId) == "string" then
			transaction.VehicleId = transactionMetadata.VehicleId
		end
		if type(transactionMetadata.JobId) == "string" then
			transaction.JobId = transactionMetadata.JobId
		end
		if type(transactionMetadata.PeerUserId) == "number" then
			transaction.PeerUserId = transactionMetadata.PeerUserId
		end
	end
	recordTransaction(player, profile, transaction)

	updateLeaderstat(player, profile)
	notifyClient(player, profile)
	transactionLocks[player] = nil
	return true
end

function EconomyService.SpendCoins(player, amount, transactionMetadata)
	if not isFiniteNumber(amount) or amount <= 0 or amount % 1 ~= 0 then
		return false, "Quantidade inválida"
	end
	if transactionLocks[player] then
		return false, "Outra transação está em andamento"
	end
	transactionLocks[player] = true

	local profile = EconomyService.GetProfile(player)
	if not profile then
		transactionLocks[player] = nil
		return false, "Perfil do jogador ainda não foi carregado"
	end

	if profile.coins < amount then
		transactionLocks[player] = nil
		return false, "Créditos insuficientes"
	end

	profile.coins -= amount
	profile.TotalSpent = sanitizeCurrency(profile.TotalSpent + amount)
	local transaction = {
		Type = "Spend",
		Amount = amount,
		Time = os.time(),
	}
	if type(transactionMetadata) == "table" then
		for _, field in ipairs({ "Type", "ItemId", "PropertyId", "VehicleId", "JobId" }) do
			if type(transactionMetadata[field]) == "string" then
				transaction[field] = transactionMetadata[field]
			end
		end
		if type(transactionMetadata.PeerUserId) == "number" then
			transaction.PeerUserId = transactionMetadata.PeerUserId
		end
	end
	recordTransaction(player, profile, transaction)

	updateLeaderstat(player, profile)
	notifyClient(player, profile)
	transactionLocks[player] = nil
	return true
end

function EconomyService.AddCredits(player, amount, transactionMetadata)
	return EconomyService.AddCoins(player, amount, transactionMetadata)
end

function EconomyService.SpendCredits(player, amount, transactionMetadata)
	return EconomyService.SpendCoins(player, amount, transactionMetadata)
end

local function transferCredits(fromPlayer, toPlayer, amount, fee, metadata)
	if
		typeof(fromPlayer) ~= "Instance"
		or not fromPlayer:IsA("Player")
		or typeof(toPlayer) ~= "Instance"
		or not toPlayer:IsA("Player")
		or fromPlayer == toPlayer
	then
		return false, "Jogadores inválidos para transferência"
	end
	if fromPlayer.Parent ~= Players or toPlayer.Parent ~= Players then
		return false, "Um dos jogadores saiu da sessão"
	end
	if
		not isFiniteNumber(amount)
		or amount < 0
		or amount % 1 ~= 0
		or amount > MAX_CURRENCY
	then
		return false, "Quantidade de créditos inválida"
	end
	if not isFiniteNumber(fee) or fee < 0 or fee % 1 ~= 0 or fee > amount then
		return false, "Comissão inválida"
	end

	local senderProfile = EconomyService.GetProfile(fromPlayer)
	local recipientProfile = EconomyService.GetProfile(toPlayer)
	if not senderProfile or not recipientProfile then
		return false, "Os dados de um dos jogadores ainda não foram carregados"
	end
	if closingProfiles[fromPlayer] or closingProfiles[toPlayer] or savingProfiles[fromPlayer] or savingProfiles[toPlayer] then
		return false, "Os dados de um dos jogadores estão sendo salvos"
	end
	if transactionLocks[fromPlayer] or transactionLocks[toPlayer] then
		return false, "Outra transação está em andamento"
	end
	if senderProfile.coins < amount then
		return false, "Créditos insuficientes"
	end
	local recipientAmount = amount - fee
	if recipientProfile.coins > MAX_CURRENCY - recipientAmount then
		return false, "O destinatário atingiu o limite máximo de créditos"
	end

	transactionLocks[fromPlayer] = true
	transactionLocks[toPlayer] = true

	senderProfile.coins -= amount
	senderProfile.TotalSpent = sanitizeCurrency(senderProfile.TotalSpent + amount)
	recipientProfile.coins += recipientAmount
	recipientProfile.TotalEarned = sanitizeCurrency(recipientProfile.TotalEarned + recipientAmount)
	recipientProfile.TotalSpent = sanitizeCurrency(recipientProfile.TotalSpent + fee)

	local timestamp = os.time()
	local itemId = type(metadata) == "table" and type(metadata.ItemId) == "string" and metadata.ItemId or nil
	local senderType = type(metadata) == "table" and metadata.SenderType or "PlayerTransferSent"
	local recipientType = type(metadata) == "table" and metadata.RecipientType or "PlayerTransferReceived"
	if type(senderType) ~= "string" then
		senderType = "PlayerTransferSent"
	end
	if type(recipientType) ~= "string" then
		recipientType = "PlayerTransferReceived"
	end
	recordTransaction(fromPlayer, senderProfile, {
		Type = senderType,
		Amount = amount,
		Time = timestamp,
		PeerUserId = toPlayer.UserId,
		ItemId = itemId,
	})
	recordTransaction(toPlayer, recipientProfile, {
		Type = recipientType,
		Amount = recipientAmount,
		Time = timestamp,
		PeerUserId = fromPlayer.UserId,
		ItemId = itemId,
	})
	if fee > 0 then
		local feeType = type(metadata) == "table" and metadata.FeeType or "TransferFeePaid"
		if type(feeType) ~= "string" then
			feeType = "TransferFeePaid"
		end
		recordTransaction(toPlayer, recipientProfile, {
			Type = feeType,
			Amount = fee,
			Time = timestamp,
			ItemId = itemId,
		})
	end

	updateLeaderstat(fromPlayer, senderProfile)
	updateLeaderstat(toPlayer, recipientProfile)
	transactionLocks[fromPlayer] = nil
	transactionLocks[toPlayer] = nil
	notifyClient(fromPlayer, senderProfile)
	notifyClient(toPlayer, recipientProfile)
	return true
end

function EconomyService.TransferCredits(fromPlayer, toPlayer, amount, metadata)
	return transferCredits(fromPlayer, toPlayer, amount, 0, metadata)
end

function EconomyService.TransferCreditsWithFee(fromPlayer, toPlayer, amount, fee, metadata)
	return transferCredits(fromPlayer, toPlayer, amount, fee, metadata)
end

function EconomyService.GrantDeveloperProduct(player, purchaseId, productId, credits)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players then
		return false, "Jogador indisponível"
	end
	if
		type(purchaseId) ~= "string"
		or purchaseId == ""
		or #purchaseId > 100
		or type(productId) ~= "string"
		or #productId > 40
		or not isFiniteNumber(credits)
		or credits <= 0
		or credits % 1 ~= 0
		or credits > MAX_CURRENCY
	then
		return false, "Produto ou recibo inválido"
	end

	local profile = EconomyService.GetProfile(player)
	if not profile then
		return false, "Perfil do jogador ainda não foi carregado"
	end
	if profile.Temporary or not profile.SessionLocked or not DataService.IsAvailable() then
		return false, "Perfil persistente indisponível para confirmar a compra"
	end
	if profile.processedDeveloperReceipts[purchaseId] == true then
		return true, true
	end
	if closingProfiles[player] or savingProfiles[player] or transactionLocks[player] then
		return false, "O perfil está ocupado; a compra será processada novamente"
	end

	transactionLocks[player] = true
	local success, result, alreadyProcessed =
		DataService.ApplyDeveloperProductReceipt(
			player.UserId,
			profile.SessionId,
			purchaseId,
			productId,
			credits,
			player.Name,
			makeProfilePayload(profile)
		)
	if not success then
		transactionLocks[player] = nil
		if result == "A sessão dos dados foi perdida" then
			profile.LockLost = true
			if player.Parent then
				player:Kick("A sessão dos seus dados foi interrompida. Entre novamente para proteger seu progresso.")
			end
		end
		return false, result
	end

	if alreadyProcessed then
		profile.processedDeveloperReceipts[purchaseId] = true
		transactionLocks[player] = nil
		return true, true
	end

	profile.coins = sanitizeCurrency(result.coins)
	profile.TotalEarned = sanitizeCurrency(result.TotalEarned)
	profile.transactions = type(result.transactions) == "table" and cloneTable(result.transactions) or {}
	profile.processedDeveloperReceipts = type(result.processedDeveloperReceipts) == "table"
		and cloneTable(result.processedDeveloperReceipts)
		or {}
	updateLeaderstat(player, profile)
	notifyClient(player, profile)
	transactionLocks[player] = nil

	if not alreadyProcessed then
		Logger.Info(
			"Economy",
			string.format(
				"DEVELOPER_PRODUCT | userId=%d | productId=%s | credits=%d | receipt=%s",
				player.UserId,
				productId,
				credits,
				purchaseId
			)
		)
	end
	return true, alreadyProcessed == true
end

function EconomyService.RecordTransaction(player, transaction)
	local profile = EconomyService.GetProfile(player)
	if
		not profile
		or type(transaction) ~= "table"
		or type(transaction.Type) ~= "string"
		or not isFiniteNumber(transaction.Amount)
		or transaction.Amount < 0
		or transaction.Amount > MAX_CURRENCY
		or transaction.Amount % 1 ~= 0
		or not isFiniteNumber(transaction.Time)
		or transaction.Time < 0
		or transaction.Time > 253_402_300_799
	then
		return false
	end
	if transactionLocks[player] then
		return false
	end
	transactionLocks[player] = true

	recordTransaction(player, profile, transaction)
	transactionLocks[player] = nil
	return true
end

function EconomyService.ClaimFirstJoinBonus(player)
	local profile = EconomyService.GetProfile(player)
	if not profile or profile.FirstJoinBonusClaimed then
		return false
	end

	profile.FirstJoinBonusClaimed = true
	return true
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("Config"))

local EconomyService = require(script.Parent.EconomyService)
local AchievementService = require(script.Parent.AchievementService)
local RateLimitService = require(script.Parent.RateLimitService)

local EventService = {}

local ATTENDANCE_DURATION = 60
local MAX_MOVEMENT_SPEED = 60
local MOVEMENT_TOLERANCE = 8
local EVENT_RADIUS = 24
local EVENT_POINTS_PER_ATTENDANCE = 10
local SAMPLE_INTERVAL = 1

local events = {
	{
		Id = "club_festival",
		Name = "Noite no Grand Society Club",
		Description = "Encontre outros jogadores na praça do clube.",
		Location = "Grand Society Club",
		PointName = "club_festival",
		StartHour = 18,
		EndHour = 21,
	},
	{
		Id = "garden_photo_walk",
		Name = "Passeio fotográfico no Garden Park",
		Description = "Explore o jardim e participe do passeio fotográfico.",
		Location = "Garden Park",
		PointName = "garden_photo_walk",
		StartHour = 8,
		EndHour = 11,
	},
	{
		Id = "fashion_show",
		Name = "Desfile da Fashion Avenue",
		Description = "Participe do encontro de moda na Fashion Avenue.",
		Location = "Fashion Avenue",
		PointName = "fashion_show",
		StartHour = 12,
		EndHour = 15,
	},
	{
		Id = "marina_exhibition",
		Name = "Encontro na Royal Marina",
		Description = "Visite o ponto de encontro da marina.",
		Location = "Royal Marina",
		PointName = "marina_exhibition",
		StartHour = 10,
		EndHour = 13,
	},
}

local eventsById = {}
for _, event in ipairs(events) do
	eventsById[event.Id] = event
end

local activeAttendance = {}
local resultRemote
local inviteReceivedRemote
local inviteResultRemote
local pendingInvites = {}

local function getEventPoint(event)
	local world = workspace:FindFirstChild("HighSocietyWorld")
	local points = world and world:FindFirstChild("EventPoints")
	local point = points and points:FindFirstChild(event.PointName)
	if point and point:IsA("BasePart") then
		return point
	end
	return nil
end

local function getLivingCharacter(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character, root
end

local function isEventOpen(event)
	local hour = Lighting.ClockTime
	return hour >= event.StartHour and hour < event.EndHour
end

local function isNearEvent(player, event)
	local point = getEventPoint(event)
	local _, root = getLivingCharacter(player)
	local prompt = point and point:FindFirstChild("EventPrompt")
	if not point or not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled or not root then
		return false
	end

	return (root.Position - point.Position).Magnitude <= prompt.MaxActivationDistance + 3
end

local function sendResult(player, success, message, eventId, pointsEarned)
	if resultRemote and resultRemote.Parent and player and player.Parent == Players then
		resultRemote:FireClient(player, {
			Success = success,
			Message = message,
			EventId = eventId,
			PointsEarned = pointsEarned or 0,
		})
	end
end

function EventService.Init(remote, eventInviteReceived, eventInviteResult)
	resultRemote = remote
	inviteReceivedRemote = eventInviteReceived
	inviteResultRemote = eventInviteResult
end

function EventService.GetEvents(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	local current = activeAttendance[player.UserId]
	local result = {}
	local today = math.floor(os.time() / 86400)
	local worldHour = Lighting.ClockTime

	for _, event in ipairs(events) do
		local claimDay = profile.eventClaims and profile.eventClaims[event.Id]
		local active = current and current.EventId == event.Id
		local participants = 0
		for _, attendance in pairs(activeAttendance) do
			if attendance.EventId == event.Id then
				participants += 1
			end
		end
		local open = isEventOpen(event)
		local opensInHours = (event.StartHour - worldHour) % 24
		table.insert(result, {
			Id = event.Id,
			Name = event.Name,
			Description = event.Description,
			Location = event.Location,
			Schedule = string.format("%02d:00-%02d:00 no relógio do jogo", event.StartHour, event.EndHour),
			Open = open,
			OpensInHours = open and 0 or math.floor(opensInHours),
			Participants = participants,
			PointsReward = EVENT_POINTS_PER_ATTENDANCE,
			AttendanceSeconds = ATTENDANCE_DURATION,
			Active = active == true,
			Invalid = active and current.Invalid or false,
			Progress = active and math.clamp(current.AttendedSeconds / ATTENDANCE_DURATION, 0, 1) or 0,
			ClaimedToday = type(claimDay) == "number" and claimDay == today,
		})
	end

	return {
		Events = result,
		EventPoints = profile.eventPoints or 0,
	}
end

function EventService.IsEventOpen(eventId)
	local event = typeof(eventId) == "string" and eventsById[eventId] or nil
	return event ~= nil and isEventOpen(event)
end

function EventService.IsAtEvent(player, eventId)
	local event = typeof(eventId) == "string" and eventsById[eventId] or nil
	return event ~= nil and isEventOpen(event) and isNearEvent(player, event)
end

function EventService.HandleRequest(player, action, eventId)
	if typeof(action) ~= "string" or typeof(eventId) ~= "string" then
		return false, "Solicitação de evento inválida"
	end

	if not RateLimitService.Allow(player, "event.action", Config.RateLimits.RequestCooldown) then
		return false, "Aguarde antes de fazer outra solicitação"
	end
	local now = os.clock()

	if not EconomyService.GetProfile(player) then
		return false, "Perfil do jogador ainda não foi carregado"
	end

	local event = eventsById[eventId]
	if not event then
		return false, "Evento não encontrado"
	end

	if action == "Leave" then
		local active = activeAttendance[player.UserId]
		if not active or active.EventId ~= event.Id then
			return false, "Você não está participando deste evento"
		end
		activeAttendance[player.UserId] = nil
		return true, "Você saiu do evento"
	end

	if action ~= "Join" then
		return false, "Ação de evento inválida"
	end
	if not isEventOpen(event) then
		return false,
			string.format(
				"Este evento acontece das %02d:00 às %02d:00 no relógio do jogo",
				event.StartHour,
				event.EndHour
			)
	end

	if activeAttendance[player.UserId] then
		return false, "Saia do evento atual antes de participar de outro"
	end
	if not isNearEvent(player, event) then
		return false, "Aproxime-se do ponto do evento para participar"
	end

	local profile = EconomyService.GetProfile(player)
	local today = math.floor(os.time() / 86400)
	if profile.eventClaims and profile.eventClaims[event.Id] == today then
		return false, "Você já recebeu os pontos deste evento hoje"
	end

	local character, root = getLivingCharacter(player)
	if not character or not root then
		return false, "Personagem não encontrado"
	end

	activeAttendance[player.UserId] = {
		EventId = event.Id,
		StartedAt = now,
		LastSampleAt = now,
		LastPosition = root.Position,
		Character = character,
		AttendedSeconds = 0,
		Invalid = false,
	}
	return true, string.format("Participação iniciada. Permaneça no local por %d segundos.", ATTENDANCE_DURATION)
end

function EventService.InvitePlayer(sender, eventId, guestUserId)
	if typeof(eventId) ~= "string" or typeof(guestUserId) ~= "number" or guestUserId <= 0 or guestUserId % 1 ~= 0 then
		return false, "Convite de evento inválido"
	end
	if guestUserId == sender.UserId then
		return false, "Você não pode convidar a si mesmo"
	end

	if not RateLimitService.Allow(sender, "event.invite.internal-send", Config.RateLimits.EventInviteCooldown) then
		return false, "Aguarde antes de enviar outro convite de evento"
	end
	local now = os.clock()

	local event = eventsById[eventId]
	if not event then
		return false, "Evento não encontrado"
	end
	if not EconomyService.GetProfile(sender) then
		return false, "Perfil do jogador ainda não foi carregado"
	end

	local guest = Players:GetPlayerByUserId(guestUserId)
	if not guest or guest.Parent ~= Players then
		return false, "Este jogador não está mais nesta sessão"
	end
	if pendingInvites[guest.UserId] then
		return false, "Este jogador já tem um convite de evento pendente"
	end
	if not inviteReceivedRemote or not inviteReceivedRemote.Parent then
		return false, "Sistema de convites de evento indisponível"
	end

	local invite = {
		SenderUserId = sender.UserId,
		EventId = event.Id,
		ExpiresAt = now + 60,
	}
	pendingInvites[guest.UserId] = invite
	task.delay(60, function()
		if pendingInvites[guest.UserId] ~= invite then
			return
		end
		pendingInvites[guest.UserId] = nil
		if inviteResultRemote and inviteResultRemote.Parent then
			if guest.Parent == Players then
				inviteResultRemote:FireClient(guest, {
					Success = false,
					Message = "O convite para o evento expirou.",
				})
			end
			local currentSender = Players:GetPlayerByUserId(invite.SenderUserId)
			if currentSender then
				inviteResultRemote:FireClient(currentSender, {
					Success = false,
					Message = "O convite para " .. event.Name .. " expirou.",
				})
			end
		end
	end)

	inviteReceivedRemote:FireClient(guest, {
		SenderName = sender.DisplayName,
		EventId = event.Id,
		EventName = event.Name,
		Location = event.Location,
		ExpiresIn = 60,
	})
	return true, "Convite para " .. event.Name .. " enviado. Expira em 60 segundos."
end

function EventService.RespondToInvite(guest, response)
	if typeof(response) ~= "string" or (response ~= "Accept" and response ~= "Decline") then
		return false, "Resposta ao convite de evento inválida"
	end

	if
		not RateLimitService.Allow(
			guest,
			"event.invite.internal-respond",
			Config.RateLimits.EventInviteResponseCooldown
		)
	then
		return false, "Aguarde antes de responder a outro convite"
	end
	local now = os.clock()

	local invite = pendingInvites[guest.UserId]
	if not invite then
		return false, "Este convite de evento não existe mais"
	end
	pendingInvites[guest.UserId] = nil

	if now > invite.ExpiresAt then
		return false, "O convite de evento expirou"
	end

	local sender = Players:GetPlayerByUserId(invite.SenderUserId)
	local event = eventsById[invite.EventId]
	if not event or not sender then
		return false, "Quem enviou o convite não está mais nesta sessão"
	end

	if response == "Decline" then
		if inviteResultRemote and inviteResultRemote.Parent then
			inviteResultRemote:FireClient(sender, {
				Success = true,
				Message = guest.DisplayName .. " recusou o convite para " .. event.Name .. ".",
				EventId = event.Id,
			})
		end
		return true, "Convite para " .. event.Name .. " recusado."
	end

	if inviteResultRemote and inviteResultRemote.Parent then
		inviteResultRemote:FireClient(sender, {
			Success = true,
			Message = guest.DisplayName .. " aceitou o convite para " .. event.Name .. ".",
			EventId = event.Id,
		})
	end
	return true,
		{
			Message = "Convite aceito. O marcador de " .. event.Name .. " foi ativado.",
			EventId = event.Id,
			Accepted = true,
		}
end

local function updateAttendance(userId, attendance, now)
	local player = Players:GetPlayerByUserId(userId)
	local event = eventsById[attendance.EventId]
	local point = event and getEventPoint(event)
	local character, root
	if player then
		character, root = getLivingCharacter(player)
	end
	if not player or not event or not point or character ~= attendance.Character or not root then
		attendance.Invalid = true
		return
	end
	if not isEventOpen(event) then
		attendance.Invalid = true
	end

	local elapsed = math.max(now - attendance.LastSampleAt, 0)
	local moved = (root.Position - attendance.LastPosition).Magnitude
	if moved > MAX_MOVEMENT_SPEED * elapsed + MOVEMENT_TOLERANCE then
		attendance.Invalid = true
	end
	if (root.Position - point.Position).Magnitude > EVENT_RADIUS then
		attendance.Invalid = true
	end

	if not attendance.Invalid then
		attendance.AttendedSeconds += elapsed
	end
	attendance.LastPosition = root.Position
	attendance.LastSampleAt = now

	if attendance.Invalid then
		activeAttendance[userId] = nil
		sendResult(
			player,
			false,
			"Participação interrompida. Volte ao ponto do evento para tentar novamente.",
			event.Id
		)
		return
	end

	if attendance.AttendedSeconds < ATTENDANCE_DURATION then
		return
	end

	local profile = EconomyService.GetProfile(player)
	if not profile then
		activeAttendance[userId] = nil
		sendResult(player, false, "Perfil indisponível; os pontos não foram registrados.", event.Id)
		return
	end

	local today = math.floor(os.time() / 86400)
	profile.eventClaims = profile.eventClaims or {}
	if profile.eventClaims[event.Id] ~= today then
		profile.eventClaims[event.Id] = today
		profile.eventPoints = math.min((profile.eventPoints or 0) + EVENT_POINTS_PER_ATTENDANCE, 2_000_000_000)
		AchievementService.RecordEventAttendance(player)
		sendResult(
			player,
			true,
			string.format("Evento concluído: +%d pontos de evento.", EVENT_POINTS_PER_ATTENDANCE),
			event.Id,
			EVENT_POINTS_PER_ATTENDANCE
		)
	else
		sendResult(player, true, "Você concluiu este evento; os pontos diários já foram recebidos.", event.Id)
	end
	activeAttendance[userId] = nil
end

task.spawn(function()
	while true do
		task.wait(SAMPLE_INTERVAL)
		local now = os.clock()
		for userId, attendance in pairs(activeAttendance) do
			updateAttendance(userId, attendance, now)
		end
	end
end)

function EventService.CleanupPlayer(player)
	activeAttendance[player.UserId] = nil

	local ownInvite = pendingInvites[player.UserId]
	if ownInvite then
		pendingInvites[player.UserId] = nil
		local sender = Players:GetPlayerByUserId(ownInvite.SenderUserId)
		if sender and inviteResultRemote and inviteResultRemote.Parent then
			inviteResultRemote:FireClient(sender, {
				Success = false,
				Message = player.DisplayName .. " saiu antes de responder ao convite.",
			})
		end
	end
	for guestUserId, invite in pairs(pendingInvites) do
		if invite.SenderUserId == player.UserId then
			pendingInvites[guestUserId] = nil
			local guest = Players:GetPlayerByUserId(guestUserId)
			if guest and inviteResultRemote and inviteResultRemote.Parent then
				inviteResultRemote:FireClient(guest, {
					Success = false,
					Message = "O convite foi cancelado porque quem enviou saiu da sessão.",
				})
			end
		end
	end
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">FashionContestService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local EventService = require(script.Parent.EventService)

local FashionContestService = {}

local EVENT_ID = "fashion_show"
local currentDay
local entries = {}
local votesByUserId = {}

local function ensureCurrentDay()
	local day = math.floor(os.time() / 86400)
	if day ~= currentDay then
		currentDay = day
		entries = {}
		votesByUserId = {}
	end
end

local function getVoteCounts()
	local counts = {}
	for _, entry in pairs(entries) do
		counts[entry.UserId] = 0
	end
	for _, targetUserId in pairs(votesByUserId) do
		if counts[targetUserId] ~= nil then
			counts[targetUserId] += 1
		end
	end
	return counts
end

function FashionContestService.GetStatus(player)
	ensureCurrentDay()
	if not player or player.Parent ~= Players then
		return nil, "Jogador inválido"
	end

	local isOpen = EventService.IsEventOpen(EVENT_ID)
	local atEvent = EventService.IsAtEvent(player, EVENT_ID)
	local counts = getVoteCounts()
	local contestants = {}
	local highestVotes = 0
	for _, entry in pairs(entries) do
		local votes = counts[entry.UserId] or 0
		highestVotes = math.max(highestVotes, votes)
		local contestantPlayer = Players:GetPlayerByUserId(entry.UserId)
		table.insert(contestants, {
			UserId = entry.UserId,
			DisplayName = entry.DisplayName,
			Username = entry.Username,
			Votes = votes,
			AtEvent = isOpen and contestantPlayer ~= nil and EventService.IsAtEvent(contestantPlayer, EVENT_ID),
		})
	end
	table.sort(contestants, function(left, right)
		if left.Votes == right.Votes then
			local leftName = string.lower(left.DisplayName)
			local rightName = string.lower(right.DisplayName)
			if leftName == rightName then
				return left.UserId < right.UserId
			end
			return leftName < rightName
		end
		return left.Votes > right.Votes
	end)

	local winners = {}
	if not isOpen and highestVotes > 0 then
		for _, contestant in ipairs(contestants) do
			if contestant.Votes == highestVotes then
				table.insert(winners, contestant.UserId)
			else
				break
			end
		end
	end

	return {
		EventOpen = isOpen,
		AtEvent = atEvent,
		HasSubmitted = entries[player.UserId] ~= nil,
		VotedFor = votesByUserId[player.UserId],
		Contestants = contestants,
		WinnerUserIds = winners,
	}
end

function FashionContestService.Submit(player)
	ensureCurrentDay()
	if not player or player.Parent ~= Players then
		return false, "Jogador inválido"
	end
	if not EventService.IsEventOpen(EVENT_ID) then
		return false, "O desfile não está aberto agora"
	end
	if not EventService.IsAtEvent(player, EVENT_ID) then
		return false, "Aproxime-se do ponto do desfile na Fashion Avenue para se inscrever"
	end
	if entries[player.UserId] then
		return false, "Você já está inscrito no desfile de hoje"
	end

	entries[player.UserId] = {
		UserId = player.UserId,
		DisplayName = player.DisplayName,
		Username = player.Name,
	}
	return true, "Inscrição confirmada para o desfile de hoje"
end

function FashionContestService.Vote(player, targetUserId)
	ensureCurrentDay()
	if not player or player.Parent ~= Players then
		return false, "Jogador inválido"
	end
	if typeof(targetUserId) ~= "number" or targetUserId <= 0 or targetUserId % 1 ~= 0 then
		return false, "Participante inválido"
	end
	if not EventService.IsEventOpen(EVENT_ID) or not EventService.IsAtEvent(player, EVENT_ID) then
		return false, "Aproxime-se do ponto do desfile na Fashion Avenue para votar"
	end
	if votesByUserId[player.UserId] then
		return false, "Você já votou neste desfile"
	end
	if targetUserId == player.UserId then
		return false, "Você não pode votar em si mesmo"
	end
	if not entries[targetUserId] then
		return false, "Esse jogador não está inscrito no desfile"
	end
	local targetPlayer = Players:GetPlayerByUserId(targetUserId)
	if not targetPlayer or not EventService.IsAtEvent(targetPlayer, EVENT_ID) then
		return false, "O participante precisa estar no ponto do desfile para receber votos"
	end

	votesByUserId[player.UserId] = targetUserId
	return true, "Voto registrado"
end

return FashionContestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("HSC")
local Config = require(Shared:WaitForChild("Config"))
local Logger = require(Shared:WaitForChild("Logger"))
local EconomyService = require(script.Parent.EconomyService)

local MonetizationService = {}

local settings = Config.Monetization
local productsById = {}
local duplicateProductIds = {}
local warnedUnknownProducts = {}
local resultRemote
local initialized = false

local function isConfiguredId(value)
	return type(value) == "number" and value % 1 == 0 and value > 0
end

local function setVipStatus(player, ownsPass, verified)
	if player.Parent ~= Players then
		return
	end
	player:SetAttribute("SocietyVIP", ownsPass == true)
	player:SetAttribute("SocietyVIPVerified", verified == true)
end

local function refreshVipStatus(player)
	local gamePassId = settings.VIPGamePassId
	if not isConfiguredId(gamePassId) then
		setVipStatus(player, false, true)
		return
	end

	for attempt = 1, Config.DataStore.MaxRetries do
		if player.Parent ~= Players then
			return
		end
		local success, ownsPass = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, gamePassId)
		if success and type(ownsPass) == "boolean" then
			setVipStatus(player, ownsPass, true)
			return
		end
		if attempt < Config.DataStore.MaxRetries then
			task.wait(attempt)
		else
			setVipStatus(player, false, false)
			Logger.Warn("Monetization", string.format("Falha ao verificar o Game Pass VIP de %s: %s", player.Name, tostring(ownsPass)))
		end
	end
end

local function handleReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local product = productsById[receiptInfo.ProductId]
	if not product then
		if not warnedUnknownProducts[receiptInfo.ProductId] then
			warnedUnknownProducts[receiptInfo.ProductId] = true
			Logger.Error(
				"Monetization",
				string.format("Developer Product %s não está cadastrado em Config.Monetization", tostring(receiptInfo.ProductId))
			)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local granted, alreadyProcessedOrError =
		EconomyService.GrantDeveloperProduct(player, receiptInfo.PurchaseId, tostring(receiptInfo.ProductId), product.Credits)
	if not granted then
		Logger.Warn(
			"Monetization",
			string.format(
				"Recibo %s aguardando processamento para %s: %s",
				tostring(receiptInfo.PurchaseId),
				player.Name,
				tostring(alreadyProcessedOrError)
			)
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if resultRemote and resultRemote.Parent then
		resultRemote:FireClient(player, {
			Success = true,
			Message = alreadyProcessedOrError and "Compra confirmada; este recibo já havia sido processado."
				or string.format("%s adicionados ao seu saldo.", product.Name),
		})
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init(purchaseResultRemote)
	if initialized then
		return
	end
	initialized = true
	resultRemote = purchaseResultRemote

	for _, product in ipairs(settings.DeveloperProducts) do
		if type(product) == "table" and isConfiguredId(product.Id) then
			if productsById[product.Id] or duplicateProductIds[product.Id] then
				Logger.Error(
					"Monetization",
					"ID de Developer Product duplicado em Config.Monetization: " .. tostring(product.Id)
				)
				productsById[product.Id] = nil
				duplicateProductIds[product.Id] = true
			elseif
				type(product.Name) ~= "string"
				or type(product.Credits) ~= "number"
				or product.Credits % 1 ~= 0
				or product.Credits <= 0
				or product.Credits > Config.Economy.MaxCurrency
			then
				Logger.Error("Monetization", "Configuração inválida para Developer Product " .. tostring(product.Id))
			else
				productsById[product.Id] = product
			end
		end
	end

	MarketplaceService.ProcessReceipt = handleReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if gamePassId == settings.VIPGamePassId and wasPurchased then
			setVipStatus(player, true, true)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.spawn(refreshVipStatus, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(refreshVipStatus, player)
	end
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">PlayerMarketService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("HSC")
local Config = require(Shared:WaitForChild("Config"))
local catalog = require(Shared:WaitForChild("FashionCatalog"))
local EconomyService = require(script.Parent.EconomyService)
local RateLimitService = require(script.Parent.RateLimitService)
local ShopService = require(script.Parent.ShopService)

local PlayerMarketService = {}

local marketConfig = Config.Market
local catalogById = {}
local listings = {}
local nextListingId = 0

for _, item in ipairs(catalog) do
	catalogById[item.Id] = item
end

local function removeListing(listingId)
	listings[listingId] = nil
end

local function pruneExpiredListings()
	local now = os.time()
	for listingId, listing in pairs(listings) do
		if listing.ExpiresAt <= now then
			removeListing(listingId)
		end
	end
end

local function countListingsFor(userId)
	local count = 0
	for _, listing in pairs(listings) do
		if listing.SellerUserId == userId then
			count += 1
		end
	end
	return count
end

local function getLivingRoot(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return root
end

local function arePlayersClose(firstPlayer, secondPlayer)
	if firstPlayer.Parent ~= Players or secondPlayer.Parent ~= Players then
		return false
	end
	local firstRoot = getLivingRoot(firstPlayer)
	local secondRoot = getLivingRoot(secondPlayer)
	return firstRoot ~= nil
		and secondRoot ~= nil
		and (firstRoot.Position - secondRoot.Position).Magnitude <= marketConfig.TransferDistance
end

local function findListing(listingId)
	if type(listingId) ~= "number" or listingId % 1 ~= 0 or listingId < 1 then
		return nil
	end
	return listings[listingId]
end

local function validateActionCooldown(player)
	return RateLimitService.Allow(
		player,
		"market.action",
		Config.RateLimits.MarketActionCooldown
	)
end

function PlayerMarketService.IsItemListed(player, itemId)
	pruneExpiredListings()
	for _, listing in pairs(listings) do
		if listing.SellerUserId == player.UserId and listing.ItemId == itemId then
			return true
		end
	end
	return false
end

function PlayerMarketService.GetMarketData(player)
	if not RateLimitService.Allow(player, "market.query", Config.RateLimits.MarketQueryCooldown) then
		return nil, "Aguarde antes de atualizar o mercado"
	end
	if not EconomyService.GetProfile(player) then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	pruneExpiredListings()
	local ownedItems, ownedError = ShopService.GetOwnedItems(player)
	if not ownedItems then
		return nil, ownedError
	end

	local items = {}
	for _, item in ipairs(ownedItems) do
		if catalogById[item.Id] then
			local isListed = PlayerMarketService.IsItemListed(player, item.Id)
			table.insert(items, {
				Id = item.Id,
				Name = item.Name,
				Category = item.Category,
				Equipped = item.Equipped,
				Sellable = item.CanEquip and not item.Equipped and not isListed,
				IsListed = isListed,
			})
		end
	end

	local publicListings = {}
	for _, listing in pairs(listings) do
		local seller = Players:GetPlayerByUserId(listing.SellerUserId)
		if seller then
			table.insert(publicListings, {
				Id = listing.Id,
				ItemId = listing.ItemId,
				ItemName = listing.ItemName,
				Category = listing.Category,
				Price = listing.Price,
				SellerUserId = listing.SellerUserId,
				SellerName = seller.DisplayName,
				ExpiresAt = listing.ExpiresAt,
			})
		end
	end
	table.sort(publicListings, function(left, right)
		return left.Id > right.Id
	end)

	return {
		Items = items,
		Listings = publicListings,
		MaxPrice = marketConfig.MaxListingPrice,
		MaxDonation = marketConfig.MaxDonation,
		CommissionPercent = marketConfig.SaleCommissionPercent,
		MaxListingsPerPlayer = marketConfig.MaxListingsPerPlayer,
		TransferDistance = marketConfig.TransferDistance,
	}
end

local function createListing(player, itemId, price)
	if type(itemId) ~= "string" or #itemId > 40 then
		return false, "Item inválido"
	end
	if
		type(price) ~= "number"
		or price ~= price
		or price == math.huge
		or price == -math.huge
		or price % 1 ~= 0
		or price < 0
		or price > marketConfig.MaxListingPrice
	then
		return false, "Preço inválido"
	end

	local item = catalogById[itemId]
	local profile = EconomyService.GetProfile(player)
	if not item or not profile then
		return false, "Item não encontrado ou perfil ainda não carregado"
	end
	if not profile.inventory[itemId] then
		return false, "Você não possui este item"
	end
	if profile.equippedItems and profile.equippedItems[itemId] then
		return false, "Desequipe o item antes de anunciá-lo"
	end
	if PlayerMarketService.IsItemListed(player, itemId) then
		return false, "Este item já está anunciado"
	end
	if countListingsFor(player.UserId) >= marketConfig.MaxListingsPerPlayer then
		return false, "Você atingiu o limite de anúncios ativos"
	end
	local listingCount = 0
	for _ in pairs(listings) do
		listingCount += 1
	end
	if listingCount >= marketConfig.MaxActiveListings then
		return false, "O mercado está cheio; tente novamente mais tarde"
	end

	nextListingId += 1
	local now = os.time()
	listings[nextListingId] = {
		Id = nextListingId,
		ItemId = itemId,
		ItemName = item.Name,
		Category = item.Category,
		Price = price,
		SellerUserId = player.UserId,
		CreatedAt = now,
		ExpiresAt = now + marketConfig.ListingDuration,
	}
	local commission = math.floor(price * marketConfig.SaleCommissionPercent / 100)
	return true, {
		Message = if price == 0
			then "Item anunciado como presente; presentes não têm comissão"
			else string.format(
				"Item anunciado. Em uma venda, você recebe %d créditos; comissão: %d",
				price - commission,
				commission
			),
	}
end

local function cancelListing(player, listingId)
	pruneExpiredListings()
	local listing = findListing(listingId)
	if not listing or listing.SellerUserId ~= player.UserId then
		return false, "Anúncio não encontrado ou não pertence a você"
	end
	removeListing(listing.Id)
	return true, {
		Message = "Anúncio cancelado",
	}
end

local function buyListing(player, listingId)
	pruneExpiredListings()
	local listing = findListing(listingId)
	if not listing then
		return false, "Este anúncio expirou ou não está mais disponível"
	end
	if listing.SellerUserId == player.UserId then
		return false, "Você não pode comprar seu próprio anúncio"
	end

	local seller = Players:GetPlayerByUserId(listing.SellerUserId)
	if not seller or not arePlayersClose(player, seller) then
		return false, "Aproxime-se do vendedor para concluir a troca"
	end

	local sellerProfile = EconomyService.GetProfile(seller)
	local buyerProfile = EconomyService.GetProfile(player)
	local item = catalogById[listing.ItemId]
	if not sellerProfile or not buyerProfile or not item then
		return false, "Os dados da troca não estão disponíveis"
	end
	if not sellerProfile.inventory[listing.ItemId] then
		removeListing(listing.Id)
		return false, "O vendedor não possui mais este item; anúncio removido"
	end
	if sellerProfile.equippedItems and sellerProfile.equippedItems[listing.ItemId] then
		return false, "O vendedor precisa desequipar este item antes da venda"
	end
	if buyerProfile.inventory[listing.ItemId] then
		return false, "Você já possui este item"
	end

	local isGift = listing.Price == 0
	local commission = isGift and 0 or math.floor(listing.Price * marketConfig.SaleCommissionPercent / 100)
	local transferred, transferError = EconomyService.TransferCreditsWithFee(player, seller, listing.Price, commission, {
		ItemId = listing.ItemId,
		SenderType = isGift and "PlayerGiftReceived" or "MarketPurchase",
		RecipientType = isGift and "PlayerGiftSent" or "MarketSaleReceived",
		FeeType = "MarketCommissionPaid",
	})
	if not transferred then
		return false, transferError
	end

	sellerProfile.inventory[listing.ItemId] = nil
	sellerProfile.equippedItems[listing.ItemId] = nil
	buyerProfile.inventory[listing.ItemId] = {
		Name = item.Name,
		Category = item.Category,
		BoughtAt = os.time(),
	}
	removeListing(listing.Id)

	return true, {
		Message = isGift and ("Presente recebido: " .. item.Name) or ("Compra concluída: " .. item.Name),
		RecipientUserId = seller.UserId,
		RecipientMessage = isGift and (player.DisplayName .. " recebeu seu presente") or (player.DisplayName .. " comprou " .. item.Name),
	}
end

local function donateCredits(player, targetUserId, amount)
	if
		type(targetUserId) ~= "number"
		or targetUserId % 1 ~= 0
		or targetUserId < 1
		or type(amount) ~= "number"
		or amount ~= amount
		or amount == math.huge
		or amount == -math.huge
		or amount % 1 ~= 0
		or amount < 1
		or amount > marketConfig.MaxDonation
	then
		return false, "Jogador ou quantidade de créditos inválidos"
	end

	local recipient = Players:GetPlayerByUserId(targetUserId)
	if not recipient or recipient == player then
		return false, "Escolha outro jogador que esteja nesta sessão"
	end
	if not arePlayersClose(player, recipient) then
		return false, "Aproxime-se do jogador para fazer a doação"
	end

	local transferred, transferError = EconomyService.TransferCredits(player, recipient, amount, {
		SenderType = "PlayerDonationSent",
		RecipientType = "PlayerDonationReceived",
	})
	if not transferred then
		return false, transferError
	end

	return true, {
		Message = string.format("Doação de %d Society Credits enviada para %s", amount, recipient.DisplayName),
		RecipientUserId = recipient.UserId,
		RecipientMessage = string.format("%s doou %d Society Credits para você", player.DisplayName, amount),
	}
end

function PlayerMarketService.HandleRequest(player, action, firstArgument, secondArgument)
	if not validateActionCooldown(player) then
		return false, "Aguarde antes de enviar outra ação ao mercado"
	end

	if action == "ListItem" then
		return createListing(player, firstArgument, secondArgument)
	elseif action == "CancelListing" then
		return cancelListing(player, firstArgument)
	elseif action == "BuyListing" then
		return buyListing(player, firstArgument)
	elseif action == "DonateCredits" then
		return donateCredits(player, firstArgument, secondArgument)
	end

	return false, "Ação de mercado inválida"
end

function PlayerMarketService.CleanupPlayer(player)
	for listingId, listing in pairs(listings) do
		if listing.SellerUserId == player.UserId then
			removeListing(listingId)
		end
	end
end

return PlayerMarketService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">PropertyService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EconomyService = require(script.Parent.EconomyService)
local AchievementService = require(script.Parent.AchievementService)
local catalog = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("PropertyCatalog"))

local PropertyService = {}
local returnPositions = {}
local privateInteriors = {}
local pendingInvites = {}
local privateInteriorFolder
local nextPrivateSlot = 0
local resultRemote
local inviteReceivedRemote
local inviteResultRemote
local applyInteriorStyle
local applyInteriorDecor
local initialized = false
local interiorStyles = {
	classic = {
		Name = "Clássico",
		Walls = Color3.fromRGB(232, 229, 218),
		Accent = Color3.fromRGB(218, 180, 91),
		Furniture = Color3.fromRGB(112, 82, 59),
		Light = Color3.fromRGB(255, 235, 190),
	},
	ocean = {
		Name = "Oceano",
		Walls = Color3.fromRGB(198, 219, 224),
		Accent = Color3.fromRGB(48, 113, 139),
		Furniture = Color3.fromRGB(83, 112, 120),
		Light = Color3.fromRGB(216, 241, 255),
	},
	garden = {
		Name = "Jardim",
		Walls = Color3.fromRGB(220, 229, 210),
		Accent = Color3.fromRGB(79, 119, 81),
		Furniture = Color3.fromRGB(126, 91, 62),
		Light = Color3.fromRGB(245, 246, 210),
	},
}

local interiorDecorCatalog = {
	{ Id = "botanical", Name = "Jardim interno", Description = "Vasos e folhagens ornamentais" },
	{ Id = "gallery", Name = "Galeria", Description = "Quadros decorativos e detalhes dourados" },
	{ Id = "lounge", Name = "Lounge", Description = "Tapete e luminárias de apoio" },
}

local decorById = {}
for _, decor in ipairs(interiorDecorCatalog) do
	decorById[decor.Id] = decor
end

local function findProperty(propertyId)
	for _, property in ipairs(catalog) do
		if property.Id == propertyId then
			return property
		end
	end

	return nil
end

local function getPropertyId(model)
	local propertyId = model:GetAttribute("PropertyId")
	if type(propertyId) == "string" then
		return propertyId
	end

	local idValue = model:FindFirstChild("PropertyId")
	if idValue and idValue:IsA("StringValue") then
		return idValue.Value
	end
	return nil
end

local function getPropertyModels()
	local models = {}
	local world = workspace:FindFirstChild("HighSocietyWorld")
	local generatedDistrict = world and world:FindFirstChild("MillionaireDistrict")
	local legacyFolder = workspace:FindFirstChild("Properties")
	local folders = {}
	if generatedDistrict then
		table.insert(folders, generatedDistrict)
	end
	if legacyFolder then
		table.insert(folders, legacyFolder)
	end

	for _, folder in ipairs(folders) do
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") then
				table.insert(models, model)
			end
		end
	end

	return models
end

local function getPurchasePoint(model)
	for _, name in ipairs({ "PropertyPurchasePoint", "Base", "SpawnPoint" }) do
		local point = model:FindFirstChild(name)
		if point and point:IsA("BasePart") then
			return point
		end
	end
	return nil
end

local function ensurePrivateInteriorFolder()
	if privateInteriorFolder and privateInteriorFolder.Parent then
		return privateInteriorFolder
	end

	local folder = workspace:FindFirstChild("HSCPrivateInteriors")
	if folder and not folder:IsA("Folder") then
		error("Workspace.HSCPrivateInteriors precisa ser uma Folder")
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "HSCPrivateInteriors"
		folder.Parent = workspace
	end

	privateInteriorFolder = folder
	return folder
end

local function destroyPrivateInterior(player)
	local record = privateInteriors[player.UserId]
	if record and record.Model and record.Model.Parent then
		record.Model:Destroy()
	end
	privateInteriors[player.UserId] = nil
end

local function countInteriorGuests(ownerUserId, propertyId)
	local count = 0
	for _, returnData in pairs(returnPositions) do
		if returnData.OwnerUserId == ownerUserId and returnData.PropertyId == propertyId then
			count += 1
		end
	end
	return count
end

local function returnInteriorGuests(owner, propertyId, reason)
	for userId, returnData in pairs(returnPositions) do
		if returnData.OwnerUserId == owner.UserId and returnData.PropertyId == propertyId then
			local guest = Players:GetPlayerByUserId(userId)
			local character = guest and guest.Character
			if character then
				character:PivotTo(returnData.CFrame)
			end
			returnPositions[userId] = nil
			if guest and inviteResultRemote and inviteResultRemote.Parent then
				inviteResultRemote:FireClient(guest, {
					Success = true,
					Message = reason or "A visita terminou e você voltou à cidade.",
				})
			end
		end
	end
end

local function cancelOwnerInvites(ownerUserId, reason)
	for guestUserId, invite in pairs(pendingInvites) do
		if invite.OwnerUserId == ownerUserId then
			pendingInvites[guestUserId] = nil
			local guest = Players:GetPlayerByUserId(guestUserId)
			if guest and inviteResultRemote and inviteResultRemote.Parent then
				inviteResultRemote:FireClient(guest, {
					Success = false,
					Message = reason,
				})
			end
		end
	end
end

local function isPlayerInsideInterior(player, returnData)
	if not returnData or returnData.OwnerUserId then
		return false
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local model = returnData.Model
	if not root or not humanoid or humanoid.Health <= 0 or not model or not model.Parent then
		return false
	end

	local floor = model:FindFirstChild("InteriorFloor")
	if floor and floor:IsA("BasePart") then
		local localPosition = floor.CFrame:PointToObjectSpace(root.Position)
		return math.abs(localPosition.X) <= floor.Size.X / 2
			and math.abs(localPosition.Z) <= floor.Size.Z / 2
			and localPosition.Y >= -2
			and localPosition.Y <= 18
	end

	local spawnPoint = model:FindFirstChild("SpawnPoint")
	return spawnPoint ~= nil and spawnPoint:IsA("BasePart") and (root.Position - spawnPoint.Position).Magnitude <= 20
end

local function connectPrivateExitPrompt(model, propertyId)
	local spawnPoint = model:FindFirstChild("SpawnPoint")
	if not spawnPoint or not spawnPoint:IsA("BasePart") then
		error(string.format("%s precisa conter um SpawnPoint físico", model:GetFullName()))
	end

	local prompt = spawnPoint:FindFirstChild("PropertyExitPrompt")
	if prompt and not prompt:IsA("ProximityPrompt") then
		error(string.format("%s.PropertyExitPrompt precisa ser ProximityPrompt", spawnPoint:GetFullName()))
	end
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "PropertyExitPrompt"
		prompt.Parent = spawnPoint
	end
	prompt.ActionText = "Sair"
	prompt.ObjectText = "Voltar para a cidade"
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false

	prompt.Triggered:Connect(function(player)
		local success, message = PropertyService.ReturnToCity(player, propertyId)
		if resultRemote and resultRemote.Parent then
			resultRemote:FireClient(player, {
				Success = success,
				PropertyId = propertyId,
				Message = message,
			})
		end
	end)
end

local function createPrivateInterior(player, propertyId, sourceModel)
	nextPrivateSlot += 1
	local model = sourceModel:Clone()
	model.Name = string.format("Interior_%d_%s", player.UserId, propertyId)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:SetAttribute("PrivateOwnerUserId", player.UserId)

	for _, descendant in ipairs(model:GetDescendants()) do
		if
			descendant:IsA("BaseScript")
			or descendant:IsA("ModuleScript")
			or descendant:IsA("RemoteEvent")
			or descendant:IsA("RemoteFunction")
			or descendant:IsA("BindableEvent")
			or descendant:IsA("BindableFunction")
			or descendant:IsA("ProximityPrompt")
			or descendant.Name == "PropertyPurchasePoint"
			or descendant.Name == "PropertyPurchasePrompt"
		then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end

	local sourcePivot = sourceModel:GetPivot()
	local privateHeight = 1000 + nextPrivateSlot * 40
	model:PivotTo(CFrame.new(0, privateHeight - sourcePivot.Position.Y, 0) * sourcePivot)
	model.Parent = ensurePrivateInteriorFolder()
	applyInteriorStyle(model, "classic")
	connectPrivateExitPrompt(model, propertyId)

	privateInteriors[player.UserId] = {
		Model = model,
		PropertyId = propertyId,
	}
	return model
end

local function makeDecorPart(parent, name, size, cframe, color, material, shape)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Shape = shape or Enum.PartType.Block
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = true
	part.Parent = parent
	return part
end

applyInteriorDecor = function(model, decorId)
	local decor = decorById[decorId]
	local floor = model:FindFirstChild("InteriorFloor")
	if not decor or not floor or not floor:IsA("BasePart") then
		return false
	end

	local existing = model:FindFirstChild("PlayerInteriorDecor")
	if existing then
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "PlayerInteriorDecor"
	folder.Parent = model

	local floorTop = floor.Size.Y / 2 + 0.08
	local halfWidth = floor.Size.X / 2
	local halfDepth = floor.Size.Z / 2
	local function at(x, y, z)
		return floor.CFrame * CFrame.new(x, floorTop + y, z)
	end

	if decorId == "botanical" then
		for _, x in ipairs({ -halfWidth + 3, halfWidth - 3 }) do
			local pot = makeDecorPart(
				folder,
				"Planter",
				Vector3.new(1.7, 1.4, 1.7),
				at(x, 0.7, 0),
				Color3.fromRGB(142, 100, 66),
				Enum.Material.Marble
			)
			makeDecorPart(
				folder,
				"Foliage",
				Vector3.new(2.2, 2.8, 2.2),
				at(x, 2.45, 0),
				Color3.fromRGB(68, 122, 76),
				Enum.Material.Grass,
				Enum.PartType.Ball
			)
			pot:SetAttribute("DecorItem", decorId)
		end
	elseif decorId == "gallery" then
		local backWall = model:FindFirstChild("BackWall")
		if not backWall or not backWall:IsA("BasePart") then
			folder:Destroy()
			return false
		end
		for _, x in ipairs({ -halfWidth * 0.45, 0, halfWidth * 0.45 }) do
			local frame = makeDecorPart(
				folder,
				"GalleryFrame",
				Vector3.new(4.5, 3.2, 0.22),
				backWall.CFrame * CFrame.new(x, 1.5, -backWall.Size.Z / 2 - 0.18),
				Color3.fromRGB(218, 180, 91),
				Enum.Material.Metal
			)
			makeDecorPart(
				folder,
				"Artwork",
				Vector3.new(3.9, 2.6, 0.08),
				frame.CFrame * CFrame.new(0, 0, -0.15),
				Color3.fromRGB(67, 103, 120),
				Enum.Material.SmoothPlastic
			)
		end
	elseif decorId == "lounge" then
		makeDecorPart(
			folder,
			"LoungeRug",
			Vector3.new(math.max(1, math.min(12, floor.Size.X - 8)), 0.12, math.max(1, math.min(8, floor.Size.Z - 8))),
			at(0, 0.06, 0),
			Color3.fromRGB(64, 75, 91),
			Enum.Material.Fabric
		)
		for _, x in ipairs({ -halfWidth + 3, halfWidth - 3 }) do
			local base = makeDecorPart(
				folder,
				"LampBase",
				Vector3.new(1.2, 0.3, 1.2),
				at(x, 0.15, -halfDepth + 4),
				Color3.fromRGB(218, 180, 91),
				Enum.Material.Metal,
				Enum.PartType.Cylinder
			)
			makeDecorPart(
				folder,
				"LampStem",
				Vector3.new(0.22, 3.4, 0.22),
				base.CFrame * CFrame.new(0, 1.8, 0),
				Color3.fromRGB(178, 181, 185),
				Enum.Material.Metal,
				Enum.PartType.Cylinder
			)
			local shade = makeDecorPart(
				folder,
				"LampShade",
				Vector3.new(1.4, 0.8, 1.4),
				base.CFrame * CFrame.new(0, 3.8, 0),
				Color3.fromRGB(255, 235, 190),
				Enum.Material.Neon,
				Enum.PartType.Ball
			)
			local light = Instance.new("PointLight")
			light.Name = "LoungeLight"
			light.Color = shade.Color
			light.Range = 12
			light.Brightness = 0.55
			light.Parent = shade
		end
	end

	folder:SetAttribute("DecorId", decorId)
	return true
end

local function getPrivateInterior(player, propertyId, sourceModel)
	local existing = privateInteriors[player.UserId]
	if existing and existing.Model and existing.Model.Parent and existing.PropertyId == propertyId then
		return existing.Model
	end

	destroyPrivateInterior(player)
	return createPrivateInterior(player, propertyId, sourceModel)
end

applyInteriorStyle = function(model, styleId)
	local style = interiorStyles[styleId]
	if not style then
		return false
	end

	local colorsByPart = {
		BackWall = style.Walls,
		FrontWall = style.Walls,
		SideWall = style.Walls,
		DoorLintel = style.Walls,
		Headboard = style.Accent,
		LoungeSofa = style.Accent,
		LuxuryBed = style.Furniture,
		LoungeTable = style.Furniture,
	}

	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local color = colorsByPart[descendant.Name]
			if color then
				descendant.Color = color
			elseif descendant.Name == "CeilingLight" then
				descendant.Color = style.Light
				local pointLight = descendant:FindFirstChild("InteriorLight")
				if pointLight and pointLight:IsA("PointLight") then
					pointLight.Color = style.Light
				end
			end
		end
	end

	return true
end

function PropertyService.GetCatalog()
	local result = {}
	for _, property in ipairs(catalog) do
		table.insert(result, {
			Id = property.Id,
			Name = property.Name,
			Type = property.Type,
			Price = property.Price,
			AccessLevel = property.AccessLevel,
		})
	end
	return result
end

function PropertyService.GetDecorCatalog()
	return interiorDecorCatalog
end

function PropertyService.GetOwnedProperties(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	profile.properties = profile.properties or {}
	for _, property in pairs(profile.properties) do
		if type(property) == "table" then
			if not interiorStyles[property.InteriorStyle] then
				property.InteriorStyle = "classic"
			end
			if not decorById[property.InteriorDecor] then
				property.InteriorDecor = "botanical"
			end
		end
	end
	return profile.properties
end

function PropertyService.SetInteriorStyle(player, propertyId, styleId)
	if typeof(propertyId) ~= "string" or typeof(styleId) ~= "string" then
		return false, "Solicitação de decoração inválida"
	end

	local style = interiorStyles[styleId]
	if not style then
		return false, "Estilo de interior não disponível"
	end

	local returnData = returnPositions[player.UserId]
	if not returnData or returnData.PropertyId ~= propertyId then
		return false, "Entre no seu imóvel antes de personalizá-lo"
	end
	if returnData.OwnerUserId then
		return false, "Somente o proprietário pode alterar a decoração"
	end

	local profile = EconomyService.GetProfile(player)
	local propertyData = profile and profile.properties and profile.properties[propertyId]
	if not propertyData then
		return false, "Você não possui este imóvel"
	end

	local model = returnData.Model
	local spawnPoint = model and model:FindFirstChild("SpawnPoint")
	if not model or not spawnPoint or not spawnPoint:IsA("BasePart") then
		return false, "Aproxime-se do interior do seu imóvel para decorar"
	end
	if not isPlayerInsideInterior(player, returnData) then
		return false, "Entre no interior do seu imóvel para decorar"
	end

	if not applyInteriorStyle(model, styleId) then
		return false, "Não foi possível aplicar este estilo"
	end

	propertyData.InteriorStyle = styleId
	return true,
		{
			PropertyId = propertyId,
			StyleId = styleId,
			StyleName = style.Name,
			Message = "Interior atualizado para o estilo " .. style.Name,
		}
end

function PropertyService.SetInteriorDecor(player, propertyId, decorId)
	if typeof(propertyId) ~= "string" or typeof(decorId) ~= "string" then
		return false, "Solicitação de decoração inválida"
	end
	local decor = decorById[decorId]
	if not decor then
		return false, "Este conjunto de decoração não está disponível"
	end

	local returnData = returnPositions[player.UserId]
	if not returnData or returnData.PropertyId ~= propertyId then
		return false, "Entre no seu imóvel antes de decorá-lo"
	end
	if returnData.OwnerUserId then
		return false, "Somente o proprietário pode alterar a decoração"
	end
	if not isPlayerInsideInterior(player, returnData) then
		return false, "Entre no interior do seu imóvel para decorá-lo"
	end

	local profile = EconomyService.GetProfile(player)
	local propertyData = profile and profile.properties and profile.properties[propertyId]
	if not propertyData then
		return false, "Você não possui este imóvel"
	end
	if not applyInteriorDecor(returnData.Model, decorId) then
		return false, "Não foi possível aplicar esta decoração"
	end

	propertyData.InteriorDecor = decorId
	return true,
		{
			PropertyId = propertyId,
			DecorId = decorId,
			DecorName = decor.Name,
			Message = "Decoração atualizada: " .. decor.Name .. ".",
		}
end

function PropertyService.HasAccess(player, propertyId)
	local profile = EconomyService.GetProfile(player)
	return profile ~= nil
		and type(propertyId) == "string"
		and type(profile.properties) == "table"
		and profile.properties[propertyId] ~= nil
end

function PropertyService.InviteGuest(owner, propertyId, guestUserId)
	if
		typeof(propertyId) ~= "string"
		or not findProperty(propertyId)
		or typeof(guestUserId) ~= "number"
		or guestUserId <= 0
		or guestUserId % 1 ~= 0
	then
		return false, "Convite inválido"
	end

	if guestUserId == owner.UserId then
		return false, "Você não pode convidar a si mesmo"
	end

	local ownerReturn = returnPositions[owner.UserId]
	local interior = privateInteriors[owner.UserId]
	if
		not ownerReturn
		or ownerReturn.OwnerUserId
		or ownerReturn.PropertyId ~= propertyId
		or not interior
		or not interior.Model
		or not interior.Model.Parent
	then
		return false, "Entre no seu imóvel antes de convidar alguém"
	end
	if not isPlayerInsideInterior(owner, ownerReturn) then
		return false, "Você precisa estar dentro do imóvel para convidar alguém"
	end
	if not PropertyService.HasAccess(owner, propertyId) then
		return false, "Você não possui este imóvel"
	end

	local guest = Players:GetPlayerByUserId(guestUserId)
	if not guest or guest.Parent ~= Players then
		return false, "Este jogador não está mais nesta sessão"
	end
	if returnPositions[guest.UserId] then
		return false, "Este jogador já está visitando um imóvel"
	end
	if countInteriorGuests(owner.UserId, propertyId) >= 4 then
		return false, "Este imóvel já atingiu o limite de quatro visitantes"
	end
	if pendingInvites[guest.UserId] then
		return false, "Este jogador já tem um convite de imóvel pendente"
	end
	if not inviteReceivedRemote or not inviteReceivedRemote.Parent then
		return false, "Sistema de convites indisponível"
	end

	local property = findProperty(propertyId)
	local invite = {
		OwnerUserId = owner.UserId,
		PropertyId = propertyId,
		ExpiresAt = os.clock() + 60,
	}
	pendingInvites[guest.UserId] = invite
	task.delay(60, function()
		if pendingInvites[guest.UserId] ~= invite then
			return
		end
		pendingInvites[guest.UserId] = nil
		if guest.Parent == Players and inviteResultRemote and inviteResultRemote.Parent then
			inviteResultRemote:FireClient(guest, {
				Success = false,
				Message = "O convite para visitar o imóvel expirou.",
			})
		end
	end)

	inviteReceivedRemote:FireClient(guest, {
		OwnerUserId = owner.UserId,
		OwnerName = owner.DisplayName,
		PropertyId = propertyId,
		PropertyName = property and property.Name or "Imóvel",
		ExpiresIn = 60,
	})
	return true, "Convite enviado. Ele expira em 60 segundos."
end

function PropertyService.RespondToInvite(guest, response)
	if typeof(response) ~= "string" or (response ~= "Accept" and response ~= "Decline") then
		return false, "Resposta ao convite inválida"
	end

	local invite = pendingInvites[guest.UserId]
	if not invite then
		return false, "Este convite não existe mais"
	end
	pendingInvites[guest.UserId] = nil

	if os.clock() > invite.ExpiresAt then
		return false, "O convite expirou"
	end
	if response == "Decline" then
		local owner = Players:GetPlayerByUserId(invite.OwnerUserId)
		if owner and inviteResultRemote and inviteResultRemote.Parent then
			inviteResultRemote:FireClient(owner, {
				Success = true,
				Message = guest.DisplayName .. " recusou o convite.",
			})
		end
		return true, "Convite recusado"
	end

	if returnPositions[guest.UserId] then
		return false, "Saia do imóvel atual antes de aceitar outro convite"
	end

	local owner = Players:GetPlayerByUserId(invite.OwnerUserId)
	local ownerReturn = owner and returnPositions[owner.UserId]
	local interior = owner and privateInteriors[owner.UserId]
	if
		not owner
		or not ownerReturn
		or ownerReturn.OwnerUserId
		or ownerReturn.PropertyId ~= invite.PropertyId
		or not interior
		or not interior.Model
		or not interior.Model.Parent
	then
		return false, "O proprietário não está mais no imóvel"
	end
	if not isPlayerInsideInterior(owner, ownerReturn) then
		return false, "O proprietário não está mais dentro do imóvel"
	end
	if not PropertyService.HasAccess(owner, invite.PropertyId) then
		return false, "O proprietário não possui mais este imóvel"
	end
	if countInteriorGuests(owner.UserId, invite.PropertyId) >= 4 then
		return false, "Este imóvel já atingiu o limite de quatro visitantes"
	end

	local character = guest.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local spawnPoint = interior.Model:FindFirstChild("SpawnPoint")
	if
		not character
		or not root
		or not humanoid
		or humanoid.Health <= 0
		or not spawnPoint
		or not spawnPoint:IsA("BasePart")
	then
		return false, "Seu personagem ou o ponto de entrada não está disponível"
	end

	local prompt = spawnPoint:FindFirstChild("PropertyExitPrompt")
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false, "A saída do imóvel não está disponível"
	end

	local guestOffset = CFrame.new((countInteriorGuests(owner.UserId, invite.PropertyId) + 1) * 3, 2, 0)
	returnPositions[guest.UserId] = {
		PropertyId = invite.PropertyId,
		CFrame = root.CFrame,
		ExitPoint = spawnPoint,
		Model = interior.Model,
		OwnerUserId = owner.UserId,
	}
	character:PivotTo(spawnPoint.CFrame * guestOffset)

	if inviteResultRemote and inviteResultRemote.Parent then
		inviteResultRemote:FireClient(owner, {
			Success = true,
			Message = guest.DisplayName .. " aceitou o convite.",
		})
	end
	return true, "Você entrou no imóvel. A visita termina quando o proprietário sair."
end

function PropertyService.IsNearPurchasePoint(player, propertyId)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return false
	end

	for _, model in ipairs(getPropertyModels()) do
		if getPropertyId(model) == propertyId then
			local point = getPurchasePoint(model)
			local prompt = point and point:FindFirstChild("PropertyPurchasePrompt")
			if
				point
				and prompt
				and prompt:IsA("ProximityPrompt")
				and prompt.Enabled
				and (root.Position - point.Position).Magnitude <= prompt.MaxActivationDistance + 3
			then
				return true
			end
		end
	end

	return false
end

function PropertyService.ReturnToCity(player, propertyId)
	local returnData = returnPositions[player.UserId]
	if not returnData or returnData.PropertyId ~= propertyId then
		return false, "Você não está dentro deste imóvel"
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return false, "Personagem não encontrado"
	end
	local exitPoint = returnData.ExitPoint
	if not exitPoint or not exitPoint.Parent then
		return false, "A saída deste imóvel não está disponível"
	end

	local prompt = exitPoint:FindFirstChild("PropertyExitPrompt")
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false, "A saída deste imóvel não está disponível"
	end
	if (root.Position - exitPoint.Position).Magnitude > prompt.MaxActivationDistance + 3 then
		return false, "Aproxime-se da saída deste imóvel"
	end

	if not returnData.OwnerUserId then
		cancelOwnerInvites(player.UserId, "O proprietário saiu do imóvel; o convite foi cancelado.")
		returnInteriorGuests(player, propertyId, "O proprietário encerrou a visita.")
	end
	character:PivotTo(returnData.CFrame)
	returnPositions[player.UserId] = nil
	if not returnData.OwnerUserId then
		destroyPrivateInterior(player)
	end
	return true, "Você voltou à cidade"
end

function PropertyService.Init(entryResultRemote, inviteReceived, inviteResult)
	if initialized then
		return
	end
	initialized = true
	resultRemote = entryResultRemote
	inviteReceivedRemote = inviteReceived
	inviteResultRemote = inviteResult
	ensurePrivateInteriorFolder()
	local function trackPlayer(player)
		player.CharacterAdded:Connect(function()
			local returnData = returnPositions[player.UserId]
			if returnData and not returnData.OwnerUserId then
				cancelOwnerInvites(player.UserId, "O proprietário saiu do imóvel; o convite foi cancelado.")
				returnInteriorGuests(player, returnData.PropertyId, "A visita foi encerrada.")
				destroyPrivateInterior(player)
			end
			returnPositions[player.UserId] = nil
		end)
	end

	Players.PlayerAdded:Connect(trackPlayer)
	Players.PlayerRemoving:Connect(function(player)
		returnInteriorGuests(
			player,
			(privateInteriors[player.UserId] or {}).PropertyId,
			"O proprietário saiu; a visita terminou."
		)
		cancelOwnerInvites(player.UserId, "O proprietário saiu; o convite foi cancelado.")
		pendingInvites[player.UserId] = nil
		returnPositions[player.UserId] = nil
		destroyPrivateInterior(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		trackPlayer(player)
	end

	for _, model in ipairs(getPropertyModels()) do
		local propertyId = getPropertyId(model)
		if type(propertyId) == "string" then
			local purchasePoint = getPurchasePoint(model)
			if purchasePoint then
				purchasePoint:SetAttribute("PropertyId", propertyId)
				local purchasePrompt = purchasePoint:FindFirstChild("PropertyPurchasePrompt")
				if not purchasePrompt then
					purchasePrompt = Instance.new("ProximityPrompt")
					purchasePrompt.Name = "PropertyPurchasePrompt"
					purchasePrompt.ActionText = "Consultar imóvel"
					purchasePrompt.MaxActivationDistance = 10
					purchasePrompt.HoldDuration = 0
					purchasePrompt.RequiresLineOfSight = false
					purchasePrompt.Parent = purchasePoint
				elseif not purchasePrompt:IsA("ProximityPrompt") then
					error(string.format("%s.PropertyPurchasePrompt precisa ser ProximityPrompt", model:GetFullName()))
				end

				local property = findProperty(propertyId)
				if property then
					purchasePrompt.ObjectText = property.Name
				end
			end

			local spawnPoint = model:FindFirstChild("SpawnPoint")
			if spawnPoint and spawnPoint:IsA("BasePart") then
				local prompt = spawnPoint:FindFirstChild("PropertyExitPrompt")
				if not prompt then
					prompt = Instance.new("ProximityPrompt")
					prompt.Name = "PropertyExitPrompt"
					prompt.ActionText = "Sair"
					prompt.ObjectText = "Voltar para a cidade"
					prompt.MaxActivationDistance = 10
					prompt.HoldDuration = 0
					prompt.RequiresLineOfSight = false
					prompt.Parent = spawnPoint
				elseif not prompt:IsA("ProximityPrompt") then
					error(string.format("%s.PropertyExitPrompt precisa ser ProximityPrompt", model:GetFullName()))
				end

				prompt.Triggered:Connect(function(player)
					local success, message = PropertyService.ReturnToCity(player, propertyId)
					resultRemote:FireClient(player, {
						Success = success,
						PropertyId = propertyId,
						Message = message,
					})
				end)
			end
		end
	end
end

function PropertyService.PurchaseProperty(player, propertyId)
	if typeof(propertyId) ~= "string" then
		return false, "Identificador de propriedade inválido"
	end

	local property = findProperty(propertyId)
	if not property then
		return false, "Propriedade não encontrada"
	end

	local profile = EconomyService.GetProfile(player)
	if not profile then
		return false, "Perfil do jogador ainda não foi carregado"
	end

	profile.properties = profile.properties or {}
	if profile.properties[property.Id] then
		return false, "Você já possui esta propriedade"
	end

	local paid, reason = EconomyService.SpendCredits(player, property.Price, {
		Type = "PropertyPurchase",
		PropertyId = property.Id,
	})
	if not paid then
		return false, reason
	end

	profile.properties[property.Id] = {
		Id = property.Id,
		Name = property.Name,
		Type = property.Type,
		Price = property.Price,
		BoughtAt = os.time(),
		AccessLevel = property.AccessLevel,
	}

	AchievementService.RecordMilestone(player, "PropertyPurchased")

	return true,
		{
			Id = property.Id,
			Name = property.Name,
			Type = property.Type,
			Price = property.Price,
			AccessLevel = property.AccessLevel,
		}
end

function PropertyService.TeleportToProperty(player, propertyId)
	if typeof(propertyId) ~= "string" then
		return false, "Identificador de propriedade inválido"
	end

	if not PropertyService.HasAccess(player, propertyId) then
		return false, "Você não possui esta propriedade"
	end
	if returnPositions[player.UserId] then
		return false, "Saia do imóvel atual antes de visitar outro"
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return false, "Personagem não encontrado"
	end

	local propertyModels = getPropertyModels()

	if #propertyModels == 0 then
		return false, "Nenhum imóvel foi encontrado no mapa"
	end

	for _, model in ipairs(propertyModels) do
		if getPropertyId(model) == propertyId then
			local profile = EconomyService.GetProfile(player)
			local propertyData = profile and profile.properties and profile.properties[propertyId]
			local privateModel = getPrivateInterior(player, propertyId, model)
			applyInteriorStyle(privateModel, propertyData and propertyData.InteriorStyle or "classic")
			applyInteriorDecor(privateModel, propertyData and propertyData.InteriorDecor or "botanical")
			local spawnPoint = privateModel:FindFirstChild("SpawnPoint")

			if not spawnPoint or not spawnPoint:IsA("BasePart") then
				destroyPrivateInterior(player)
				return false, "Ponto de entrada da propriedade não encontrado"
			end

			returnPositions[player.UserId] = {
				PropertyId = propertyId,
				CFrame = root.CFrame,
				ExitPoint = spawnPoint,
				Model = privateModel,
			}
			character:PivotTo(spawnPoint.CFrame * CFrame.new(0, 2, 0))
			return true, "Bem-vinda à sua propriedade"
		end
	end

	return false, "O imóvel existe, mas ainda não tem um ponto de entrada configurado"
end

function PropertyService.CleanupPlayer(player)
	returnPositions[player.UserId] = nil
end

return PropertyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">RateLimitService</string>
            <string name="Source"><![CDATA[local RateLimitService = {}

local requestsByUserId = {}

function RateLimitService.Allow(player, key, cooldown)
	if
		typeof(player) ~= "Instance"
		or not player:IsA("Player")
		or type(key) ~= "string"
		or key == ""
		or type(cooldown) ~= "number"
		or cooldown < 0
		or cooldown ~= cooldown
		or cooldown == math.huge
	then
		return false
	end

	local userId = player.UserId
	local now = os.clock()
	local userRequests = requestsByUserId[userId]
	if not userRequests then
		userRequests = {}
		requestsByUserId[userId] = userRequests
	end

	local previous = userRequests[key]
	if previous and now - previous < cooldown then
		return false
	end

	userRequests[key] = now
	return true
end

function RateLimitService.CleanupPlayer(player)
	if player and player:IsA("Player") then
		requestsByUserId[player.UserId] = nil
	end
end

return RateLimitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">RegionService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local RegionService = {}

local SCAN_INTERVAL = 0.5
local regions = {
	{
		Name = "Paradise Island & Royal Marina",
		MinX = 124,
		MaxX = 255,
		MinZ = 125,
		MaxZ = 250,
	},
	{
		Name = "Garden Park",
		MinX = -210,
		MaxX = -90,
		MinZ = 38,
		MaxZ = 130,
	},
	{
		Name = "Grand Society Club",
		MinX = -42,
		MaxX = 66,
		MinZ = 58,
		MaxZ = 140,
	},
	{
		Name = "Millionaire District",
		MinX = 40,
		MaxX = 240,
		MinZ = 20,
		MaxZ = 58,
	},
	{
		Name = "High Society Boulevard",
		MinX = -240,
		MaxX = 240,
		MinZ = -155,
		MaxZ = 65,
	},
}

local regionChanged
local currentRegions = {}
local initialized = false

local function findRegion(position)
	for _, region in ipairs(regions) do
		if
			position.X >= region.MinX
			and position.X <= region.MaxX
			and position.Z >= region.MinZ
			and position.Z <= region.MaxZ
		then
			return region.Name
		end
	end

	return nil
end

function RegionService.Init(remote)
	if initialized then
		return
	end
	initialized = true
	regionChanged = remote

	Players.PlayerRemoving:Connect(function(player)
		currentRegions[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(SCAN_INTERVAL)

			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local regionName
				if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
					regionName = findRegion(root.Position)
				end

				if currentRegions[player] ~= regionName then
					currentRegions[player] = regionName
					if regionChanged and regionChanged.Parent then
						regionChanged:FireClient(player, regionName)
					end
				end
			end
		end
	end)
end

return RegionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[local EconomyService = require(script.Parent.EconomyService)
local AchievementService = require(script.Parent.AchievementService)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local catalog = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("FashionCatalog"))

local ShopService = {}

local stores = {
	fashion_avenue = {
		Id = "fashion_avenue",
		Name = "Fashion Avenue",
		DistrictName = "HighSocietyBoulevard",
		ModelName = "FashionAvenueStore",
		PointName = "ShopPoint",
		PromptName = "ShopPrompt",
	},
}

local function findItem(itemId)
	for _, item in ipairs(catalog) do
		if item.Id == itemId then
			return item
		end
	end

	return nil
end

local function copyPublicItem(item)
	return {
		Id = item.Id,
		Name = item.Name,
		Category = item.Category,
		Price = item.Price,
		AssetType = item.AssetType,
		StoreId = item.StoreId,
	}
end

function ShopService.GetStoreDefinition(storeId)
	local store = stores[storeId]
	if not store then
		return nil
	end

	return {
		Id = store.Id,
		Name = store.Name,
		DistrictName = store.DistrictName,
		ModelName = store.ModelName,
		PointName = store.PointName,
		PromptName = store.PromptName,
	}
end

function ShopService.GetCatalog(storeId)
	if storeId ~= nil and (type(storeId) ~= "string" or not stores[storeId]) then
		return nil, "Loja não encontrada"
	end

	local items = {}
	for _, item in ipairs(catalog) do
		if storeId == nil or item.StoreId == storeId then
			table.insert(items, copyPublicItem(item))
		end
	end

	table.sort(items, function(left, right)
		if left.Category == right.Category then
			return left.Name < right.Name
		end
		return left.Category < right.Category
	end)
	return items
end

function ShopService.GetOwnedItems(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	local items = {}
	for itemId, ownedItem in pairs(profile.inventory or {}) do
		if type(itemId) == "string" then
			local item = findItem(itemId)
			local savedName = type(ownedItem) == "table" and ownedItem.Name
			local savedCategory = type(ownedItem) == "table" and ownedItem.Category
			table.insert(items, {
				Id = itemId,
				Name = item and item.Name or (type(savedName) == "string" and savedName) or itemId,
				Category = item and item.Category or (type(savedCategory) == "string" and savedCategory) or "Item",
				Equipped = profile.equippedItems and profile.equippedItems[itemId] == true or false,
				CanEquip = item ~= nil,
			})
		end
	end

	table.sort(items, function(left, right)
		return left.Name < right.Name
	end)

	return items
end

function ShopService.PurchaseItem(player, itemId, storeId)
	if typeof(itemId) ~= "string" then
		return false, "Identificador de item inválido"
	end
	if typeof(storeId) ~= "string" or not stores[storeId] then
		return false, "Loja não encontrada"
	end

	local item = findItem(itemId)
	if not item then
		return false, "Item não encontrado"
	end
	if item.StoreId ~= storeId then
		return false, "Este item não pertence a esta loja"
	end

	local profile = EconomyService.GetProfile(player)
	if not profile then
		return false, "Perfil do jogador ainda não foi carregado"
	end

	profile.inventory = profile.inventory or {}
	if profile.inventory[item.Id] then
		return false, "Você já possui este item"
	end

	local paid, reason = EconomyService.SpendCredits(player, item.Price, {
		Type = "Purchase",
		ItemId = item.Id,
	})
	if not paid then
		return false, reason
	end

	profile.inventory[item.Id] = {
		Name = item.Name,
		Category = item.Category,
		BoughtAt = os.time(),
	}

	if storeId == "fashion_avenue" then
		AchievementService.RecordMilestone(player, "FashionPurchased")
	end

	return true, copyPublicItem(item)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">VehicleBuilder</string>
            <string name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("HSC")
local Logger = require(Shared:WaitForChild("Logger"))
local vehicleCatalog = require(Shared:WaitForChild("VehicleCatalog"))

local VehicleBuilder = {}

local SHOWROOM_NAME = "VehicleShowroom"
local GENERATED_VEHICLE_ID = "society_sedan"

local function findVehicleDefinition(vehicleId)
	for _, definition in ipairs(vehicleCatalog) do
		if definition.Id == vehicleId then
			return definition
		end
	end
	return nil
end

local baseVehicleDefinition = findVehicleDefinition(GENERATED_VEHICLE_ID)
assert(baseVehicleDefinition, "VehicleCatalog precisa definir society_sedan")
local boatDefinition = findVehicleDefinition("society_speedboat")
local motorcycleDefinition = findVehicleDefinition("society_roadster_bike")
assert(boatDefinition and boatDefinition.IsBoat, "VehicleCatalog precisa definir a lancha")
assert(motorcycleDefinition and motorcycleDefinition.IsMotorcycle, "VehicleCatalog precisa definir a motocicleta")

local COLORS = {
	Body = baseVehicleDefinition.BodyColor,
	Trim = baseVehicleDefinition.TrimColor,
	Glass = Color3.fromRGB(93, 143, 162),
	Tire = Color3.fromRGB(28, 29, 32),
	Metal = Color3.fromRGB(178, 181, 185),
	Light = Color3.fromRGB(255, 239, 195),
	TailLight = Color3.fromRGB(190, 53, 55),
}

local function createPart(parent, name, size, cframe, color, material, shape, transparency)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Shape = shape or Enum.PartType.Block
	part.Transparency = transparency or 0
	part.Anchored = false
	part.CanCollide = true
	part.CanTouch = false
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function weldToChassis(chassis, part)
	local weld = Instance.new("WeldConstraint")
	weld.Name = "BodyWeld"
	weld.Part0 = chassis
	weld.Part1 = part
	weld.Parent = chassis
	part.Massless = true
end

local function createDecoration(model, chassis, name, size, offset, color, material, shape, transparency)
	local part =
		createPart(model, name, size, chassis.CFrame * CFrame.new(offset), color, material, shape, transparency)
	part.CanCollide = false
	weldToChassis(chassis, part)
	return part
end

local function createDriveWheel(model, chassis, side, front)
	local z = front and -5 or 5
	local x = side * 4.95
	local wheel = createPart(
		model,
		front and (side < 0 and "FrontLeftWheel" or "FrontRightWheel")
			or (side < 0 and "RearLeftWheel" or "RearRightWheel"),
		Vector3.new(1.25, 2.2, 2.2),
		chassis.CFrame * CFrame.new(x, -0.45, z),
		COLORS.Tire,
		Enum.Material.Rubber,
		Enum.PartType.Cylinder
	)
	wheel.CustomPhysicalProperties = PhysicalProperties.new(1.5, 1.1, 0.05, 1, 1)

	local rim = createPart(
		model,
		"WheelRim",
		Vector3.new(1.28, 1.15, 1.15),
		wheel.CFrame,
		COLORS.Metal,
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
	rim.CanCollide = false
	rim.Massless = true
	local rimWeld = Instance.new("WeldConstraint")
	rimWeld.Name = "RimWeld"
	rimWeld.Part0 = wheel
	rimWeld.Part1 = rim
	rimWeld.Parent = wheel

	local chassisAttachment = Instance.new("Attachment")
	chassisAttachment.Name = "WheelMount"
	chassisAttachment.Position = Vector3.new(x, -0.45, z)
	chassisAttachment.Parent = chassis

	local wheelAttachment = Instance.new("Attachment")
	wheelAttachment.Name = "WheelAxis"
	wheelAttachment.Parent = wheel

	local hinge = Instance.new("HingeConstraint")
	hinge.Name = "DriveMotor"
	hinge.Attachment0 = chassisAttachment
	hinge.Attachment1 = wheelAttachment
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.AngularVelocity = 0
	hinge.MotorMaxTorque = 12000
	hinge.MotorMaxAcceleration = 80
	hinge:SetAttribute("DriveSide", side)
	hinge.Parent = chassis

	return wheel
end

local function buildModel()
	local model = Instance.new("Model")
	model.Name = baseVehicleDefinition.ModelName

	local chassis =
		createPart(model, "Chassis", Vector3.new(8.5, 1.5, 15), CFrame.new(), COLORS.Body, Enum.Material.Metal)
	chassis.CustomPhysicalProperties = PhysicalProperties.new(2.5, 0.8, 0.05, 1, 1)
	chassis.RootPriority = 127
	model.PrimaryPart = chassis

	createDecoration(
		model,
		chassis,
		"LowerTrim",
		Vector3.new(8.8, 0.45, 14),
		Vector3.new(0, -0.85, 0),
		COLORS.Trim,
		Enum.Material.Metal
	)
	createDecoration(
		model,
		chassis,
		"Hood",
		Vector3.new(7.5, 0.7, 4.1),
		Vector3.new(0, 0.9, -5.15),
		COLORS.Body,
		Enum.Material.Metal
	)
	createDecoration(
		model,
		chassis,
		"RearDeck",
		Vector3.new(7.5, 0.7, 2.7),
		Vector3.new(0, 0.9, 5.3),
		COLORS.Body,
		Enum.Material.Metal
	)
	createDecoration(
		model,
		chassis,
		"Windshield",
		Vector3.new(6.25, 1.55, 0.22),
		Vector3.new(0, 2.0, -3.2),
		COLORS.Glass,
		Enum.Material.Glass,
		nil,
		0.2
	)
	createDecoration(
		model,
		chassis,
		"RearWindow",
		Vector3.new(6.1, 1.35, 0.22),
		Vector3.new(0, 2.0, 4.1),
		COLORS.Glass,
		Enum.Material.Glass,
		nil,
		0.2
	)

	for _, side in ipairs({ -1, 1 }) do
		createDecoration(
			model,
			chassis,
			"SideWindow",
			Vector3.new(0.2, 1.3, 5.2),
			Vector3.new(side * 3.35, 2.0, 0.45),
			COLORS.Glass,
			Enum.Material.Glass,
			nil,
			0.25
		)
		createDecoration(
			model,
			chassis,
			"DoorTrim",
			Vector3.new(0.22, 0.25, 5.8),
			Vector3.new(side * 4.3, 0.2, 0.3),
			COLORS.Trim,
			Enum.Material.Metal
		)
		createDriveWheel(model, chassis, side, true)
		createDriveWheel(model, chassis, side, false)
	end

	for _, side in ipairs({ -1, 1 }) do
		createDecoration(
			model,
			chassis,
			"Headlight",
			Vector3.new(1.8, 0.3, 0.18),
			Vector3.new(side * 2.6, 0.1, -7.58),
			COLORS.Light,
			Enum.Material.Neon
		)
		createDecoration(
			model,
			chassis,
			"TailLight",
			Vector3.new(1.8, 0.4, 0.18),
			Vector3.new(side * 2.6, 0.1, 7.58),
			COLORS.TailLight,
			Enum.Material.Neon
		)
	end

	createDecoration(
		model,
		chassis,
		"FrontGrille",
		Vector3.new(2.8, 0.65, 0.2),
		Vector3.new(0, -0.05, -7.62),
		COLORS.Metal,
		Enum.Material.Metal
	)

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.8, 2)
	seat.CFrame = chassis.CFrame * CFrame.new(0, 2.3, 1.1)
	seat.Color = COLORS.Trim
	seat.Material = Enum.Material.SmoothPlastic
	seat.Anchored = false
	seat.CanCollide = false
	seat.CanTouch = true
	seat.Massless = true
	seat.Parent = model
	weldToChassis(chassis, seat)

	return model
end

local function buildSpeedboat(vehicleFolder)
	local modelName = boatDefinition.ModelName
	local existing = vehicleFolder:FindFirstChild(modelName)
	if existing then
		if not existing:IsA("Model") then
			error(string.format("ServerStorage.VehicleModels.%s precisa ser um Model", modelName))
		end
		return existing
	end

	local model = Instance.new("Model")
	model.Name = modelName
	model:SetAttribute("VehicleType", "Boat")

	local hull =
		createPart(model, "Hull", Vector3.new(10, 2, 22), CFrame.new(), Color3.fromRGB(35, 44, 58), Enum.Material.Metal)
	hull.CustomPhysicalProperties = PhysicalProperties.new(1.2, 0.25, 0.1, 1, 1)
	hull.RootPriority = 127
	model.PrimaryPart = hull

	local function addBoatPart(name, size, offset, color, material, shape)
		local part = createPart(model, name, size, hull.CFrame * CFrame.new(offset), color, material, shape)
		part.CanCollide = false
		weldToChassis(hull, part)
		return part
	end

	addBoatPart(
		"Bow",
		Vector3.new(9.8, 1.8, 5),
		Vector3.new(0, 0.1, -8.5),
		Color3.fromRGB(35, 44, 58),
		Enum.Material.Metal,
		Enum.PartType.Wedge
	)
	addBoatPart(
		"Deck",
		Vector3.new(8.5, 0.3, 14),
		Vector3.new(0, 1.15, 2.5),
		Color3.fromRGB(218, 180, 91),
		Enum.Material.WoodPlanks
	)
	for _, side in ipairs({ -1, 1 }) do
		addBoatPart(
			"Rail",
			Vector3.new(0.35, 1.3, 16),
			Vector3.new(side * 4.7, 1.3, 1),
			Color3.fromRGB(224, 222, 209),
			Enum.Material.Metal
		)
		addBoatPart(
			"SeatBench",
			Vector3.new(7, 0.7, 1.3),
			Vector3.new(0, 1.7, 2.5),
			Color3.fromRGB(83, 112, 120),
			Enum.Material.Fabric
		)
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2.2, 0.8, 2)
	seat.CFrame = hull.CFrame * CFrame.new(0, 2.1, 5)
	seat.Color = Color3.fromRGB(83, 112, 120)
	seat.Material = Enum.Material.Fabric
	seat.Anchored = false
	seat.CanCollide = false
	seat.CanTouch = true
	seat.Massless = true
	seat.Parent = model
	weldToChassis(hull, seat)

	local attachment = Instance.new("Attachment")
	attachment.Name = "BoatForceAttachment"
	attachment.Parent = hull

	local propulsion = Instance.new("VectorForce")
	propulsion.Name = "PropulsionForce"
	propulsion.Attachment0 = attachment
	propulsion.RelativeTo = Enum.ActuatorRelativeTo.World
	propulsion.ApplyAtCenterOfMass = true
	propulsion.Parent = hull

	local buoyancy = Instance.new("VectorForce")
	buoyancy.Name = "BuoyancyForce"
	buoyancy.Attachment0 = attachment
	buoyancy.RelativeTo = Enum.ActuatorRelativeTo.World
	buoyancy.ApplyAtCenterOfMass = true
	buoyancy.Parent = hull

	local steering = Instance.new("Torque")
	steering.Name = "SteeringTorque"
	steering.Attachment0 = attachment
	steering.RelativeTo = Enum.ActuatorRelativeTo.World
	steering.Parent = hull

	model.Parent = vehicleFolder
	return model
end

local function buildMotorcycle(vehicleFolder)
	local modelName = motorcycleDefinition.ModelName
	local existing = vehicleFolder:FindFirstChild(modelName)
	if existing then
		if not existing:IsA("Model") then
			error(string.format("ServerStorage.VehicleModels.%s precisa ser um Model", modelName))
		end
		return existing
	end

	local model = Instance.new("Model")
	model.Name = modelName
	model:SetAttribute("VehicleType", "Motorcycle")

	local frame = createPart(
		model,
		"Frame",
		Vector3.new(2.4, 1, 6.5),
		CFrame.new(),
		Color3.fromRGB(35, 44, 58),
		Enum.Material.Metal
	)
	frame.CustomPhysicalProperties = PhysicalProperties.new(2.2, 0.7, 0.05, 1, 1)
	frame.RootPriority = 127
	model.PrimaryPart = frame

	local function addPart(name, size, offset, color, material, shape)
		local part = createPart(model, name, size, frame.CFrame * CFrame.new(offset), color, material, shape)
		part.CanCollide = false
		weldToChassis(frame, part)
		return part
	end

	addPart(
		"FuelTank",
		Vector3.new(2.2, 1.5, 2.8),
		Vector3.new(0, 1.1, -0.5),
		Color3.fromRGB(90, 43, 48),
		Enum.Material.Metal
	)
	addPart(
		"FrontFairing",
		Vector3.new(2.4, 2.4, 0.9),
		Vector3.new(0, 1.2, -2.35),
		Color3.fromRGB(90, 43, 48),
		Enum.Material.SmoothPlastic
	)
	addPart(
		"Handlebar",
		Vector3.new(4.2, 0.25, 0.3),
		Vector3.new(0, 2.25, -2.1),
		Color3.fromRGB(178, 181, 185),
		Enum.Material.Metal
	)
	addPart(
		"BikeSeat",
		Vector3.new(2, 0.55, 2.8),
		Vector3.new(0, 1.65, 1.45),
		Color3.fromRGB(35, 35, 38),
		Enum.Material.Fabric
	)
	addPart(
		"Headlight",
		Vector3.new(1.1, 1.1, 0.45),
		Vector3.new(0, 0.9, -2.9),
		COLORS.Light,
		Enum.Material.Neon,
		Enum.PartType.Ball
	)

	for _, z in ipairs({ -3.2, 3.2 }) do
		local front = z < 0
		local wheel = createPart(
			model,
			front and "FrontWheel" or "RearWheel",
			Vector3.new(1.1, 2.3, 2.3),
			frame.CFrame * CFrame.new(0, -0.65, z),
			COLORS.Tire,
			Enum.Material.Rubber,
			Enum.PartType.Cylinder
		)
		wheel.CustomPhysicalProperties = PhysicalProperties.new(1.4, 1, 0.04, 1, 1)

		local mount = Instance.new("Attachment")
		mount.Name = "WheelMount"
		mount.Position = Vector3.new(0, -0.65, z)
		mount.Parent = frame

		local axis = Instance.new("Attachment")
		axis.Name = "WheelAxis"
		axis.Parent = wheel

		local hinge = Instance.new("HingeConstraint")
		hinge.Name = "DriveMotor"
		hinge.Attachment0 = mount
		hinge.Attachment1 = axis
		hinge.ActuatorType = Enum.ActuatorType.Motor
		hinge.AngularVelocity = 0
		hinge.MotorMaxTorque = 8500
		hinge.MotorMaxAcceleration = 65
		hinge:SetAttribute("DrivenWheel", not front)
		hinge.Parent = frame
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(1.8, 0.65, 1.8)
	seat.CFrame = frame.CFrame * CFrame.new(0, 2.15, 0.9)
	seat.Color = Color3.fromRGB(35, 35, 38)
	seat.Material = Enum.Material.Fabric
	seat.Anchored = false
	seat.CanCollide = false
	seat.CanTouch = true
	seat.Massless = true
	seat.Parent = model
	weldToChassis(frame, seat)

	local attachment = Instance.new("Attachment")
	attachment.Name = "MotorcycleForceAttachment"
	attachment.Parent = frame

	local steering = Instance.new("Torque")
	steering.Name = "SteeringTorque"
	steering.Attachment0 = attachment
	steering.RelativeTo = Enum.ActuatorRelativeTo.World
	steering.Parent = frame

	model.Parent = vehicleFolder
	return model
end

local function buildShowroom(template)
	local world = workspace:FindFirstChild("HighSocietyWorld")
	local boulevard = world and world:FindFirstChild("HighSocietyBoulevard")
	local gallery = boulevard and boulevard:FindFirstChild("AutomotiveGallery")
	local foundation = gallery and gallery:FindFirstChild("Foundation")
	if not gallery or not foundation or not foundation:IsA("BasePart") then
		Logger.Warn("VehicleBuilder", "Automotive Gallery sem Foundation; veículos de exposição não foram criados.")
		return
	end

	local showroom = gallery:FindFirstChild(SHOWROOM_NAME)
	if not showroom then
		showroom = Instance.new("Folder")
		showroom.Name = SHOWROOM_NAME
		showroom.Parent = gallery
	elseif not showroom:IsA("Folder") then
		error(
			"Workspace.HighSocietyWorld.HighSocietyBoulevard.AutomotiveGallery.VehicleShowroom precisa ser uma Folder"
		)
	end

	local displayVehicles = {}
	for _, definition in ipairs(vehicleCatalog) do
		if not definition.IsBoat and not definition.IsMotorcycle then
			table.insert(displayVehicles, definition)
		end
	end

	for index, definition in ipairs(displayVehicles) do
		local displayName = definition.ModelName .. "Display"
		local existing = showroom:FindFirstChild(displayName)
		if existing then
			if not existing:IsA("Model") then
				error(string.format("%s precisa ser um Model", existing:GetFullName()))
			end
			continue
		end

		local display = template:Clone()
		display.Name = displayName
		display:SetAttribute("DisplayOnly", true)
		display:SetAttribute("DisplayName", definition.Name)
		display:ScaleTo(definition.DisplayScale or 1)

		for _, descendant in ipairs(display:GetDescendants()) do
			if descendant:IsA("BasePart") then
				if descendant.Name == "Chassis" or descendant.Name == "Hood" or descendant.Name == "RearDeck" then
					descendant.Color = definition.DisplayBodyColor or definition.BodyColor
				elseif descendant.Name == "LowerTrim" then
					descendant.Color = definition.TrimColor
				elseif descendant.Name == "DriverSeat" and descendant:IsA("VehicleSeat") then
					descendant.Disabled = true
				end
				descendant.Anchored = true
			end
		end

		local slot = index - (#displayVehicles + 1) / 2
		local position = foundation.Position
			+ Vector3.new(
				slot * 18,
				foundation.Size.Y / 2 + 1.55 * definition.DisplayScale + 0.1,
				-foundation.Size.Z / 2 - 11
			)
		display:PivotTo(CFrame.new(position))
		display.Parent = showroom
	end
end

local function buildMarinaShowroom(template)
	local world = workspace:FindFirstChild("HighSocietyWorld")
	local marina = world and world:FindFirstChild("ParadiseIslandAndRoyalMarina")
	local water = marina and marina:FindFirstChild("MarinaWater")
	if not marina or not water or not water:IsA("BasePart") then
		Logger.Warn("VehicleBuilder", "Royal Marina sem MarinaWater; lancha de exposição não foi criada.")
		return
	end

	local showroom = marina:FindFirstChild("BoatShowroom")
	if not showroom then
		showroom = Instance.new("Folder")
		showroom.Name = "BoatShowroom"
		showroom.Parent = marina
	elseif not showroom:IsA("Folder") then
		error("Workspace.HighSocietyWorld.ParadiseIslandAndRoyalMarina.BoatShowroom precisa ser uma Folder")
	end
	local displayName = boatDefinition.ModelName .. "Display"
	if showroom:FindFirstChild(displayName) then
		return
	end

	local display = template:Clone()
	display.Name = displayName
	display:SetAttribute("DisplayOnly", true)
	display:SetAttribute("DisplayName", boatDefinition.Name)
	for _, descendant in ipairs(display:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			if descendant:IsA("VehicleSeat") then
				descendant.Disabled = true
			end
		elseif descendant:IsA("VectorForce") or descendant:IsA("Torque") then
			descendant:Destroy()
		end
	end
	display:PivotTo(CFrame.new(222, water.Position.Y + 1.1, water.Position.Z))
	display.Parent = showroom
end

local function buildMotorcycleShowroom(template)
	local world = workspace:FindFirstChild("HighSocietyWorld")
	local boulevard = world and world:FindFirstChild("HighSocietyBoulevard")
	local gallery = boulevard and boulevard:FindFirstChild("AutomotiveGallery")
	local foundation = gallery and gallery:FindFirstChild("Foundation")
	if not gallery or not foundation or not foundation:IsA("BasePart") then
		Logger.Warn("VehicleBuilder", "Automotive Gallery sem Foundation; moto de exposição não foi criada.")
		return
	end

	local showroom = gallery:FindFirstChild(SHOWROOM_NAME)
	if not showroom or not showroom:IsA("Folder") then
		return
	end
	local displayName = motorcycleDefinition.ModelName .. "Display"
	if showroom:FindFirstChild(displayName) then
		return
	end

	local display = template:Clone()
	display.Name = displayName
	display:SetAttribute("DisplayOnly", true)
	display:SetAttribute("DisplayName", motorcycleDefinition.Name)
	for _, descendant in ipairs(display:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			if descendant:IsA("VehicleSeat") then
				descendant.Disabled = true
			end
		elseif descendant:IsA("Torque") then
			descendant:Destroy()
		end
	end
	display:PivotTo(
		CFrame.new(
			foundation.Position.X + 38,
			foundation.Position.Y + foundation.Size.Y / 2 + 2.2,
			foundation.Position.Z - foundation.Size.Z / 2 - 11
		)
	)
	display.Parent = showroom
end

local function buildPlayableVariants(vehicleFolder, template)
	for _, definition in ipairs(vehicleCatalog) do
		if definition.Id == GENERATED_VEHICLE_ID or definition.IsBoat or definition.IsMotorcycle then
			continue
		end

		local existing = vehicleFolder:FindFirstChild(definition.ModelName)
		if existing then
			if not existing:IsA("Model") then
				error(string.format("ServerStorage.VehicleModels.%s precisa ser um Model", definition.ModelName))
			end
			continue
		end

		local variant = template:Clone()
		variant.Name = definition.ModelName
		variant:ScaleTo(definition.PlayableScale or 1)
		variant:SetAttribute("VehicleType", definition.ModelName)

		for _, descendant in ipairs(variant:GetDescendants()) do
			if not descendant:IsA("BasePart") then
				continue
			end

			if descendant.Name == "Chassis" or descendant.Name == "Hood" or descendant.Name == "RearDeck" then
				descendant.Color = definition.BodyColor
			elseif descendant.Name == "LowerTrim" or descendant.Name == "DoorTrim" then
				descendant.Color = definition.TrimColor
			end
		end

		variant.Parent = vehicleFolder
	end
end

function VehicleBuilder.Init()
	local vehicleFolder = ServerStorage:FindFirstChild("VehicleModels")
	if not vehicleFolder then
		vehicleFolder = Instance.new("Folder")
		vehicleFolder.Name = "VehicleModels"
		vehicleFolder.Parent = ServerStorage
	elseif not vehicleFolder:IsA("Folder") then
		error("ServerStorage.VehicleModels precisa ser uma Folder")
	end

	local generatedName = baseVehicleDefinition.ModelName
	local existing = vehicleFolder:FindFirstChild(generatedName)
	if existing then
		if not existing:IsA("Model") then
			error(string.format("ServerStorage.VehicleModels.%s precisa ser um Model", generatedName))
		end
		buildPlayableVariants(vehicleFolder, existing)
		local speedboat = buildSpeedboat(vehicleFolder)
		local motorcycle = buildMotorcycle(vehicleFolder)
		buildShowroom(existing)
		buildMotorcycleShowroom(motorcycle)
		buildMarinaShowroom(speedboat)
		return existing
	end

	local model = buildModel()
	model.Parent = vehicleFolder
	buildPlayableVariants(vehicleFolder, model)
	local speedboat = buildSpeedboat(vehicleFolder)
	local motorcycle = buildMotorcycle(vehicleFolder)
	buildShowroom(model)
	buildMotorcycleShowroom(motorcycle)
	buildMarinaShowroom(speedboat)
	Logger.Info("VehicleBuilder", "Modelos de veículos preparados")
	return model
end

return VehicleBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[local EconomyService = require(script.Parent.EconomyService)
local AchievementService = require(script.Parent.AchievementService)

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("HSC")
local Config = require(Shared:WaitForChild("Config"))
local catalog = require(Shared:WaitForChild("VehicleCatalog"))

local VehicleService = {}

local paintCatalog = {
	{ Id = "midnight", Name = "Azul meia-noite", Color = Color3.fromRGB(35, 44, 58) },
	{ Id = "pearl", Name = "Pérola", Color = Color3.fromRGB(226, 224, 214) },
	{ Id = "ruby", Name = "Rubi", Color = Color3.fromRGB(111, 40, 48) },
	{ Id = "emerald", Name = "Esmeralda", Color = Color3.fromRGB(42, 94, 70) },
	{ Id = "silver", Name = "Prata", Color = Color3.fromRGB(142, 151, 160) },
	{ Id = "sapphire", Name = "Safira", Color = Color3.fromRGB(44, 86, 145) },
}

local paintById = {}
for _, paint in ipairs(paintCatalog) do
	paintById[paint.Id] = paint
end

local activeVehicles = {}
local lastControlAt = {}
local CONTROL_TIMEOUT = 0.6
local TEST_DRIVE_DURATION = Config.Vehicles.TestDriveDuration
local marinaWater
local testDriveResultRemote

local function isFiniteNumber(value)
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function findVehicle(vehicleId)
	for _, vehicle in ipairs(catalog) do
		if vehicle.Id == vehicleId then
			return vehicle
		end

		function VehicleService.Init(testDriveRemote)
			testDriveResultRemote = testDriveRemote
		end
	end

	return nil
end

local function applyVehiclePaint(vehicle, paintId)
	local paint = paintById[paintId] or paintById.midnight
	for _, descendant in ipairs(vehicle:GetDescendants()) do
		if
			descendant:IsA("BasePart")
			and (
				descendant.Name == "Chassis"
				or descendant.Name == "Hood"
				or descendant.Name == "RearDeck"
				or descendant.Name == "Hull"
				or descendant.Name == "Bow"
				or descendant.Name == "Frame"
				or descendant.Name == "FuelTank"
			)
		then
			descendant.Color = paint.Color
		end
	end
end

local function setBoatControls(vehicle, throttle, steer)
	local root = vehicle.PrimaryPart
	local propulsion = root and root:FindFirstChild("PropulsionForce")
	local steering = root and root:FindFirstChild("SteeringTorque")
	if
		not root
		or not propulsion
		or not propulsion:IsA("VectorForce")
		or not steering
		or not steering:IsA("Torque")
	then
		return
	end

	local mass = root.AssemblyMass
	propulsion.Force = root.CFrame.LookVector * throttle * mass * 34
	steering.Torque = Vector3.new(0, -steer * mass * 8, 0)
end

local function maintainBoatBuoyancy(vehicle)
	local root = vehicle.PrimaryPart
	local buoyancy = root and root:FindFirstChild("BuoyancyForce")
	if not root or not buoyancy or not buoyancy:IsA("VectorForce") then
		return
	end

	if not marinaWater or not marinaWater.Parent then
		local world = workspace:FindFirstChild("HighSocietyWorld")
		marinaWater = world and world:FindFirstChild("MarinaWater", true)
	end
	if not marinaWater or not marinaWater:IsA("BasePart") then
		buoyancy.Force = Vector3.zero
		return
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { vehicle }
	rayParams.IgnoreWater = false
	local origin = root.Position + Vector3.new(0, 4, 0)
	local waterHit = workspace:Raycast(origin, Vector3.new(0, -14, 0), rayParams)

	if not waterHit or waterHit.Instance ~= marinaWater then
		buoyancy.Force = Vector3.zero
		return
	end

	local waterSurfaceY = marinaWater.Position.Y + marinaWater.Size.Y / 2
	local heightError = math.clamp(waterSurfaceY + 0.9 - root.Position.Y, -12, 4)
	local verticalSpeed = math.clamp(root.AssemblyLinearVelocity.Y, -30, 30)
	local mass = root.AssemblyMass
	local force =
		math.clamp(mass * (workspace.Gravity + heightError * 12 - verticalSpeed * 4), 0, mass * workspace.Gravity * 2)
	buoyancy.Force = Vector3.new(0, force, 0)
end

local function setWheelSpeeds(vehicle, throttle, steer)
	local vehicleData = findVehicle(vehicle:GetAttribute("VehicleId"))
	local maxWheelSpeed = vehicleData and vehicleData.MaxWheelSpeed or 32
	for _, descendant in ipairs(vehicle:GetDescendants()) do
		if descendant:IsA("HingeConstraint") and descendant.ActuatorType == Enum.ActuatorType.Motor then
			local side = descendant:GetAttribute("DriveSide")
			if side ~= -1 and side ~= 1 then
				side = 0
			end

			descendant.AngularVelocity = throttle * maxWheelSpeed * (1 - side * steer * 0.45)
		end
	end
end

local function setMotorcycleControls(vehicle, throttle, steer)
	local vehicleData = findVehicle(vehicle:GetAttribute("VehicleId"))
	local maxWheelSpeed = vehicleData and vehicleData.MaxWheelSpeed or 36
	local root = vehicle.PrimaryPart
	local steering = root and root:FindFirstChild("SteeringTorque")
	for _, descendant in ipairs(vehicle:GetDescendants()) do
		if descendant:IsA("HingeConstraint") and descendant.ActuatorType == Enum.ActuatorType.Motor then
			local isDriven = descendant:GetAttribute("DrivenWheel") == true
			descendant.AngularVelocity = isDriven and throttle * maxWheelSpeed or 0
		end
	end
	if steering and steering:IsA("Torque") then
		local mass = root.AssemblyMass
		local uprightTorque = root.CFrame.UpVector:Cross(Vector3.yAxis) * mass * 12
		local angularVelocity = root.AssemblyAngularVelocity
		local dampingTorque = Vector3.new(angularVelocity.X, 0, angularVelocity.Z) * mass * 3
		steering.Torque = uprightTorque - dampingTorque + Vector3.new(0, -steer * mass * 5, 0)
	end
end

local function hasClearSpawnSpace(player, vehicle, spawnPoint)
	local character = player.Character
	local spawnOffset = vehicle.IsBoat and CFrame.new(0, 3, 0) or CFrame.new(0, 3, -8)
	local spawnCFrame = spawnPoint.CFrame * spawnOffset
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = { spawnPoint }
	if character then
		table.insert(overlapParams.FilterDescendantsInstances, character)
	end
	overlapParams.MaxParts = 1
	overlapParams.RespectCanCollide = true

	local boxSize = vehicle.IsBoat and Vector3.new(15, 7, 28) or Vector3.new(13, 5, 17)
	local overlappingParts = workspace:GetPartBoundsInBox(spawnCFrame, boxSize, overlapParams)
	return #overlappingParts == 0
end

function VehicleService.GetCatalog()
	local result = {}
	for _, vehicle in ipairs(catalog) do
		table.insert(result, {
			Id = vehicle.Id,
			Name = vehicle.Name,
			Category = vehicle.Category,
			Price = vehicle.Price,
			Performance = vehicle.Performance,
			IsBoat = vehicle.IsBoat == true,
			IsMotorcycle = vehicle.IsMotorcycle == true,
		})
	end
	return result
end

function VehicleService.GetPaintCatalog()
	return paintCatalog
end

function VehicleService.GetOwnedVehicles(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	profile.vehicles = profile.vehicles or {}
	for _, vehicle in ipairs(catalog) do
		local ownedData = profile.vehicles[vehicle.Id]
		if ownedData then
			if type(ownedData) ~= "table" then
				ownedData = {
					Id = vehicle.Id,
					Name = vehicle.Name,
					Category = vehicle.Category,
				}
				profile.vehicles[vehicle.Id] = ownedData
			end
			if not paintById[ownedData.PaintId] then
				ownedData.PaintId = "midnight"
			end
		end
	end
	return profile.vehicles
end

function VehicleService.SetVehiclePaint(player, vehicleId, paintId)
	if typeof(vehicleId) ~= "string" or typeof(paintId) ~= "string" then
		return false, "Solicitação de pintura inválida"
	end

	local vehicle = findVehicle(vehicleId)
	local paint = paintById[paintId]
	if not vehicle or not paint then
		return false, "Veículo ou cor indisponível"
	end
	if vehicle.IsBoat then
		return false, "A pintura personalizada está disponível para os carros; a lancha já tem acabamento próprio"
	end

	local ownedVehicles, ownedError = VehicleService.GetOwnedVehicles(player)
	if not ownedVehicles then
		return false, ownedError
	end
	local ownedData = ownedVehicles[vehicle.Id]
	if not ownedData then
		return false, "Você não possui este veículo"
	end

	local activeVehicle = activeVehicles[player.UserId]
	if activeVehicle and activeVehicle.Parent then
		return false, "Guarde seu veículo antes de personalizá-lo"
	end

	ownedData.PaintId = paint.Id
	return true,
		{
			VehicleId = vehicle.Id,
			PaintId = paint.Id,
			PaintName = paint.Name,
			Message = vehicle.Name .. " personalizado na cor " .. paint.Name .. ".",
		}
end

function VehicleService.GetActiveVehicleId(player)
	local vehicle = activeVehicles[player.UserId]
	if not vehicle or not vehicle.Parent or vehicle:GetAttribute("OwnerUserId") ~= player.UserId then
		activeVehicles[player.UserId] = nil
		return nil
	end

	return vehicle:GetAttribute("VehicleId")
end

function VehicleService.GetActiveVehicleStatus(player)
	local vehicleId = VehicleService.GetActiveVehicleId(player)
	if not vehicleId then
		return nil
	end

	local vehicle = activeVehicles[player.UserId]
	return {
		Id = vehicleId,
		IsTestDrive = vehicle:GetAttribute("IsTestDrive") == true,
	}
end

function VehicleService.IsPlayerDrivingOwnedVehicle(player)
	local vehicle = activeVehicles[player.UserId]
	if not vehicle or not vehicle.Parent or vehicle:GetAttribute("OwnerUserId") ~= player.UserId then
		return false
	end

	local seat = vehicle:FindFirstChild("DriverSeat")
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local vehicleData = findVehicle(vehicle:GetAttribute("VehicleId"))
	return vehicleData ~= nil
		and not vehicleData.IsBoat
		and not vehicleData.IsMotorcycle
		and vehicle:GetAttribute("IsTestDrive") ~= true
		and seat ~= nil
		and seat:IsA("VehicleSeat")
		and humanoid ~= nil
		and seat.Occupant == humanoid
end

function VehicleService.IsBoat(vehicleId)
	local vehicle = typeof(vehicleId) == "string" and findVehicle(vehicleId)
	return vehicle ~= nil and vehicle.IsBoat == true
end

function VehicleService.IsActiveBoat(player)
	local vehicle = activeVehicles[player.UserId]
	if not vehicle or not vehicle.Parent or vehicle:GetAttribute("OwnerUserId") ~= player.UserId then
		return false
	end
	return VehicleService.IsBoat(vehicle:GetAttribute("VehicleId"))
end

function VehicleService.PurchaseVehicle(player, vehicleId)
	if typeof(vehicleId) ~= "string" then
		return false, "Identificador de veículo inválido"
	end

	local vehicle = findVehicle(vehicleId)
	if not vehicle then
		return false, "Veículo não encontrado"
	end

	local profile = EconomyService.GetProfile(player)
	if not profile then
		return false, "Perfil do jogador ainda não foi carregado"
	end
	local activeVehicle = activeVehicles[player.UserId]
	if activeVehicle and activeVehicle.Parent and activeVehicle:GetAttribute("IsTestDrive") then
		return false, "Encerre seu test drive antes de comprar um veículo"
	end

	profile.vehicles = profile.vehicles or {}
	if profile.vehicles[vehicle.Id] then
		return false, "Você já possui este veículo"
	end

	local paid, reason = EconomyService.SpendCredits(player, vehicle.Price, {
		Type = "VehiclePurchase",
		VehicleId = vehicle.Id,
	})
	if not paid then
		return false, reason
	end

	profile.vehicles[vehicle.Id] = {
		Id = vehicle.Id,
		Name = vehicle.Name,
		Category = vehicle.Category,
		PurchasedAt = os.time(),
	}

	AchievementService.RecordMilestone(player, "VehiclePurchased")

	return true, {
		Id = vehicle.Id,
		Name = vehicle.Name,
		Category = vehicle.Category,
		Price = vehicle.Price,
	}
end

function VehicleService.SpawnVehicle(player, vehicleId, spawnPoint, isTestDrive)
	if typeof(vehicleId) ~= "string" then
		return false, "Identificador de veículo inválido"
	end

	local vehicle = findVehicle(vehicleId)
	if not vehicle then
		return false, "Veículo não encontrado"
	end

	local ownedVehicles
	if isTestDrive then
		if activeVehicles[player.UserId] and activeVehicles[player.UserId].Parent then
			return false, "Guarde seu veículo atual antes de iniciar um test drive"
		end
	else
		local ownedError
		ownedVehicles, ownedError = VehicleService.GetOwnedVehicles(player)
		if not ownedVehicles then
			return false, ownedError
		end
		if not ownedVehicles[vehicle.Id] then
			return false, "Você não possui este veículo"
		end
	end

	if not spawnPoint or not spawnPoint:IsA("BasePart") then
		return false, "Ponto de spawn do veículo não encontrado"
	end
	local existing = activeVehicles[player.UserId]
	if existing and existing.Parent then
		return false, "Você já tem um veículo retirado"
	end
	activeVehicles[player.UserId] = nil
	if not hasClearSpawnSpace(player, vehicle, spawnPoint) then
		return false, "O ponto de saída está bloqueado. Libere o espaço e tente novamente"
	end

	local modelsFolder = ServerStorage:FindFirstChild("VehicleModels")
	local template = modelsFolder and modelsFolder:FindFirstChild(vehicle.ModelName)
	if not template or not template:IsA("Model") then
		return false, string.format("Modelo %s não encontrado em ServerStorage.VehicleModels", vehicle.ModelName)
	end

	local hasPart = false
	for _, descendant in ipairs(template:GetDescendants()) do
		if descendant:IsA("BasePart") then
			hasPart = true
			break
		end
	end
	if not hasPart then
		return false, "O modelo do veículo não contém peças físicas"
	end

	local clone = template:Clone()
	clone:SetAttribute("OwnerUserId", player.UserId)
	clone:SetAttribute("VehicleId", vehicle.Id)
	clone:SetAttribute("IsTestDrive", isTestDrive == true)
	if ownedVehicles then
		applyVehiclePaint(clone, ownedVehicles[vehicle.Id].PaintId)
	end
	clone:PivotTo(spawnPoint.CFrame * (vehicle.IsBoat and CFrame.new(0, 3, 0) or CFrame.new(0, 3, -8)))
	clone.Parent = workspace

	local assemblyRoot = clone.PrimaryPart
	if not assemblyRoot then
		clone:Destroy()
		return false, "O modelo do veículo precisa definir uma PrimaryPart"
	end
	assemblyRoot:SetNetworkOwner(nil)

	activeVehicles[player.UserId] = clone
	if vehicle.IsBoat then
		maintainBoatBuoyancy(clone)
	end
	local testDriveExpiresAt = isTestDrive and (os.clock() + TEST_DRIVE_DURATION) or nil
	local seat = clone:FindFirstChild("DriverSeat")
	if seat and seat:IsA("VehicleSeat") then
		seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			if not seat.Occupant then
				if vehicle.IsBoat then
					setBoatControls(clone, 0, 0)
				elseif vehicle.IsMotorcycle then
					setMotorcycleControls(clone, 0, 0)
				else
					setWheelSpeeds(clone, 0, 0)
				end
				lastControlAt[player.UserId] = nil
			end
		end)
	end
	lastControlAt[player.UserId] = nil

	task.spawn(function()
		while clone.Parent and activeVehicles[player.UserId] == clone do
			task.wait(0.25)
			if isTestDrive and os.clock() >= testDriveExpiresAt then
				clone:Destroy()
				if testDriveResultRemote and testDriveResultRemote.Parent and player.Parent == Players then
					testDriveResultRemote:FireClient(player, {
						Success = true,
						Ended = true,
						Message = "Seu test drive terminou. O veículo foi recolhido.",
					})
				end
				break
			end
			if vehicle.IsBoat then
				maintainBoatBuoyancy(clone)
			end
			local lastUpdate = lastControlAt[player.UserId]
			if lastUpdate and os.clock() - lastUpdate > CONTROL_TIMEOUT then
				if vehicle.IsBoat then
					setBoatControls(clone, 0, 0)
				elseif vehicle.IsMotorcycle then
					setMotorcycleControls(clone, 0, 0)
				else
					setWheelSpeeds(clone, 0, 0)
				end
				lastControlAt[player.UserId] = nil
			end
		end

		if activeVehicles[player.UserId] == clone then
			activeVehicles[player.UserId] = nil
		end
		lastControlAt[player.UserId] = nil
	end)

	return true, clone
end

function VehicleService.StartTestDrive(player, vehicleId, spawnPoint)
	local vehicle = typeof(vehicleId) == "string" and findVehicle(vehicleId)
	if not vehicle then
		return false, "Veículo não encontrado"
	end

	local success, result = VehicleService.SpawnVehicle(player, vehicle.Id, spawnPoint, true)
	if not success then
		return false, result
	end

	return true, {
		Id = vehicle.Id,
		Name = vehicle.Name,
		Duration = TEST_DRIVE_DURATION,
	}
end

function VehicleService.SetDriverControls(player, throttle, steer)
	if not isFiniteNumber(throttle) or not isFiniteNumber(steer) then
		return false, "Comandos do veículo inválidos"
	end

	local vehicle = activeVehicles[player.UserId]
	if not vehicle or not vehicle.Parent or vehicle:GetAttribute("OwnerUserId") ~= player.UserId then
		return false, "Nenhum veículo ativo para este jogador"
	end

	local seat = vehicle:FindFirstChild("DriverSeat")
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not seat or not seat:IsA("VehicleSeat") or not humanoid or seat.Occupant ~= humanoid then
		return false, "O jogador não está no banco do motorista"
	end

	throttle = math.clamp(throttle, -1, 1)
	steer = math.clamp(steer, -1, 1)

	lastControlAt[player.UserId] = os.clock()
	local vehicleData = findVehicle(vehicle:GetAttribute("VehicleId"))
	if vehicleData and vehicleData.IsBoat then
		setBoatControls(vehicle, throttle, steer)
	elseif vehicleData and vehicleData.IsMotorcycle then
		setMotorcycleControls(vehicle, throttle, steer)
	else
		setWheelSpeeds(vehicle, throttle, steer)
	end

	return true
end

function VehicleService.DespawnVehicle(player)
	local vehicle = activeVehicles[player.UserId]
	if not vehicle or not vehicle.Parent then
		activeVehicles[player.UserId] = nil
		lastControlAt[player.UserId] = nil
		return false, "Você não tem um veículo retirado"
	end

	vehicle:Destroy()
	activeVehicles[player.UserId] = nil
	lastControlAt[player.UserId] = nil
	return true, "Veículo guardado na garagem"
end

return VehicleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WorkService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("Config"))
local EconomyService = require(script.Parent.EconomyService)
local AchievementService = require(script.Parent.AchievementService)
local VehicleService = require(script.Parent.VehicleService)
local RateLimitService = require(script.Parent.RateLimitService)
local CreationService = require(script.Parent.CreationService)

local WorkService = {}

local WORK_COOLDOWN = 8
local WORK_CANCEL_COOLDOWN = 4
local MAX_MOVEMENT_SPEED = 60
local MOVEMENT_TOLERANCE = 8
local MINIMUM_ROUTE_FRACTION = 0.65
local MOVEMENT_SAMPLE_INTERVAL = 0.5
local jobs = {
	{
		Id = "city_guide",
		Name = "Guia turístico",
		Description = "Faça um percurso turístico entre o boulevard e a ilha.",
		Route = "Boulevard → Paradise Island",
		Reward = 75,
		MinimumDuration = 25,
		StartPoint = "TourGuideStart",
		FinishPoint = "TourGuideFinish",
	},
	{
		Id = "chauffeur",
		Name = "Motorista particular",
		Description = "Complete um trajeto entre o hotel e a galeria automotiva.",
		Route = "Luxury Hotel → Automotive Gallery",
		Reward = 90,
		MinimumDuration = 20,
		RequiresVehicle = true,
		StartPoint = "ChauffeurStart",
		FinishPoint = "ChauffeurFinish",
	},
	{
		Id = "photographer",
		Name = "Fotógrafo virtual",
		Description = "Faça um percurso pelos jardins até o clube.",
		Route = "Garden Park → Grand Society Club",
		Reward = 60,
		MinimumDuration = 15,
		StartPoint = "PhotographerStart",
		FinishPoint = "PhotographerFinish",
	},
	{
		Id = "dj",
		Name = "DJ",
		Description = "Prepare a apresentação na marina e leve a energia até o clube.",
		Route = "Royal Marina → Grand Society Club",
		Reward = 100,
		MinimumDuration = 25,
		StartPoint = "DJStart",
		FinishPoint = "DJFinish",
	},
	{
		Id = "event_animator",
		Name = "Animador de eventos",
		Description = "Conduza uma atividade segura entre o parque e a avenida da moda.",
		Route = "Garden Park → Fashion Avenue",
		Reward = 85,
		MinimumDuration = 30,
		StartPoint = "EventAnimatorStart",
		FinishPoint = "EventAnimatorFinish",
	},
	{
		Id = "entrepreneur",
		Name = "Empresário virtual",
		Description = "Leve uma proposta comercial da galeria ao Luxury Hotel.",
		Route = "High Society Gallery → Luxury Hotel",
		Reward = 95,
		MinimumDuration = 35,
		StartPoint = "EntrepreneurStart",
		FinishPoint = "EntrepreneurFinish",
	},
	{
		Id = "fashion_designer",
		Name = "Designer de moda",
		Description = "Apresente sua coleção da Fashion Avenue na Automotive Gallery.",
		Route = "Fashion Avenue → Automotive Gallery",
		Reward = 80,
		MinimumDuration = 25,
		StartPoint = "FashionDesignerStart",
		FinishPoint = "FashionDesignerFinish",
	},
	{
		Id = "event_organizer",
		Name = "Organizador de eventos",
		Description = "Prepare o evento no clube e entregue o material na Fashion Avenue.",
		Route = "Grand Society Club → Fashion Avenue",
		Reward = 90,
		MinimumDuration = 30,
		StartPoint = "EventOrganizerStart",
		FinishPoint = "EventOrganizerFinish",
	},
	{
		Id = "establishment_owner",
		Name = "Proprietário de estabelecimento",
		Description = "Planeje a operação do hotel e audite o atendimento do clube.",
		Route = "Luxury Hotel → Grand Society Club",
		Reward = 95,
		MinimumDuration = 30,
		StartPoint = "EstablishmentOwnerStart",
		FinishPoint = "EstablishmentOwnerFinish",
		Activities = {
			{
				Label = "Definir a prioridade operacional",
				Choices = {
					{
						Point = "EstablishmentOwnerOperationsService",
						Name = "Priorizar atendimento",
						Outcome = "atendimento premium",
					},
					{
						Point = "EstablishmentOwnerOperationsEvents",
						Name = "Priorizar eventos",
						Outcome = "agenda de eventos",
					},
				},
			},
			{
				Label = "Avaliar o padrão de atendimento",
				Choices = {
					{
						Point = "EstablishmentOwnerAuditApprove",
						Name = "Aprovar padrão",
						Outcome = "padrão aprovado",
					},
					{
						Point = "EstablishmentOwnerAuditTraining",
						Name = "Recomendar treinamento",
						Outcome = "treinamento recomendado",
					},
				},
			},
		},
	},
	{
		Id = "world_creator",
		Name = "Criador de mundos",
		Description = "Crie um conceito de cenário e apresente a maquete na galeria.",
		Route = "Garden Park → High Society Gallery",
		Reward = 100,
		MinimumDuration = 35,
		StartPoint = "WorldCreatorStart",
		FinishPoint = "WorldCreatorFinish",
		Activities = {
			{
				Label = "Escolher o tema do cenário",
				Choices = {
					{ Point = "WorldCreatorThemeGarden", Name = "Tema de jardim", Outcome = "tema de jardim" },
					{ Point = "WorldCreatorThemeCoastal", Name = "Tema costeiro", Outcome = "tema costeiro" },
					{ Point = "WorldCreatorThemeUrban", Name = "Tema urbano", Outcome = "tema urbano" },
				},
			},
			{
				Label = "Montar a composição da maquete",
				Choices = {
					{
						Point = "WorldCreatorLayoutPavilion",
						Name = "Composição com pavilhão",
						Outcome = "layout de pavilhão",
					},
					{
						Point = "WorldCreatorLayoutPlaza",
						Name = "Composição com praça",
						Outcome = "layout de praça",
					},
					{
						Point = "WorldCreatorLayoutPromenade",
						Name = "Composição com passeio",
						Outcome = "layout de passeio",
					},
				},
			},
		},
	},
}

local jobsById = {}
for _, job in ipairs(jobs) do
	jobsById[job.Id] = job
end

local activeJobs = {}
local cooldownUntil = {}
local djBoothAccessUntil = {}

local function findWorkPoint(pointName)
	local folder = workspace:FindFirstChild("HighSocietyWorld")
	local workPoints = folder and folder:FindFirstChild("WorkPoints")
	local point = workPoints and workPoints:FindFirstChild(pointName)

	if point and point:IsA("BasePart") then
		return point
	end

	return nil
end

local function getPlayerRoot(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end

	return root
end

local function isNearPoint(player, pointName)
	local point = findWorkPoint(pointName)
	local root = getPlayerRoot(player)
	local prompt = point and point:FindFirstChild("WorkPrompt")

	if not point or not point:IsA("BasePart") or not prompt or not prompt:IsA("ProximityPrompt") or not root then
		return false
	end

	return (root.Position - point.Position).Magnitude <= prompt.MaxActivationDistance + 3
end

local function sampleMovement(player, active, now)
	if not player or player.Character ~= active.Character then
		active.MovementInvalid = true
		return
	end

	local root = getPlayerRoot(player)
	if not root then
		active.MovementInvalid = true
		return
	end

	local elapsed = math.max(now - active.LastSampleAt, 0)
	local moved = (root.Position - active.LastPosition).Magnitude
	if moved > MAX_MOVEMENT_SPEED * elapsed + MOVEMENT_TOLERANCE then
		active.MovementInvalid = true
	else
		active.TravelledDistance += moved
		if active.RequiresVehicle and VehicleService.IsPlayerDrivingOwnedVehicle(player) then
			active.DrivenDistance += moved
		end
	end

	active.LastPosition = root.Position
	active.LastSampleAt = now
end

local progressionRanks = {
	{ Completions = 0, Name = "Aprendiz" },
	{ Completions = 3, Name = "Profissional" },
	{ Completions = 10, Name = "Especialista" },
	{ Completions = 25, Name = "Elite" },
	{ Completions = 50, Name = "Lenda" },
}

local function getProfessionRank(completions)
	local rankIndex = 1
	for index, rank in ipairs(progressionRanks) do
		if completions >= rank.Completions then
			rankIndex = index
		else
			break
		end
	end

	return progressionRanks[rankIndex], progressionRanks[rankIndex + 1], rankIndex
end

function WorkService.GetJobs(player)
	local profile = EconomyService.GetProfile(player)
	if not profile then
		return nil, "Perfil do jogador ainda não foi carregado"
	end

	profile.professionCompletions = profile.professionCompletions or {}
	local result = {}

	for _, job in ipairs(jobs) do
		local completions = profile.professionCompletions[job.Id] or 0
		local rank, nextRank, rankIndex = getProfessionRank(completions)
		local activities = {}
		for _, activity in ipairs(job.Activities or {}) do
			table.insert(activities, activity.Label)
		end

		table.insert(result, {
			Id = job.Id,
			Name = job.Name,
			Description = job.Description,
			Route = job.Route,
			Reward = job.Reward,
			EffectiveReward = math.floor(job.Reward * (1 + (rankIndex - 1) * 0.05)),
			MinimumDuration = job.MinimumDuration,
			RequiresVehicle = job.RequiresVehicle == true,
			Activities = activities,
			Completions = completions,
			Rank = rank.Name,
			NextRankAt = nextRank and nextRank.Completions or nil,
		})
	end

	return result
end

function WorkService.GetActiveJob(player)
	local active = activeJobs[player.UserId]
	if not active then
		return nil
	end

	local job = jobsById[active.JobId]
	if not job then
		activeJobs[player.UserId] = nil
		return nil
	end

	local elapsed = os.clock() - active.StartedAt
	local activities = job.Activities or {}
	local activityIndex = active.ActivityIndex or 1
	local objective = activities[activityIndex]
	local objectiveChoices = {}
	for _, choice in ipairs(objective and objective.Choices or {}) do
		table.insert(objectiveChoices, choice.Name)
	end
	return {
		JobId = job.Id,
		JobName = job.Name,
		FinishPoint = job.FinishPoint,
		ObjectivePoint = objective and objective.Choices[1].Point or nil,
		ObjectiveLabel = objective and objective.Label or nil,
		ObjectiveChoices = objectiveChoices,
		ActivityIndex = activityIndex,
		ActivityCount = #activities,
		ActivityComplete = objective == nil,
		Elapsed = math.floor(elapsed),
		SecondsRemaining = math.max(0, math.ceil(job.MinimumDuration - elapsed)),
		MovementInvalid = active.MovementInvalid == true,
		TravelProgress = active.RequiredDistance > 0
				and math.clamp(active.TravelledDistance / active.RequiredDistance, 0, 1)
			or 0,
		VehicleProgress = active.RequiresVehicle
				and active.RequiredDistance > 0
				and math.clamp(active.DrivenDistance / active.RequiredDistance, 0, 1)
			or nil,
	}
end

function WorkService.CanOperateDJBooth(player)
	if not player then
		return false
	end
	local job = jobsById.dj
	if not job then
		return false
	end
	local nearFinish = isNearPoint(player, job.FinishPoint)
	if not nearFinish then
		return false
	end

	local active = activeJobs[player.UserId]
	if active then
		if active.JobId ~= job.Id or active.MovementInvalid or player.Character ~= active.Character then
			return false
		end
		if os.clock() - active.StartedAt < job.MinimumDuration then
			return false
		end
		return active.TravelledDistance >= active.RequiredDistance
	end
	return os.clock() < (djBoothAccessUntil[player.UserId] or 0)
end

function WorkService.HandleRequest(player, action, jobId, pointName)
	if typeof(action) ~= "string" or typeof(jobId) ~= "string" then
		return false, "Solicitação de trabalho inválida"
	end

	if not RateLimitService.Allow(player, "work.request", Config.RateLimits.WorkRequestCooldown) then
		return false, "Aguarde antes de fazer outra solicitação"
	end
	local now = os.clock()

	if not EconomyService.GetProfile(player) then
		return false, "Perfil do jogador ainda não foi carregado"
	end

	local job = jobsById[jobId]
	if not job then
		return false, "Profissão não encontrada"
	end

	if action == "Start" then
		if activeJobs[player.UserId] then
			return false, "Conclua ou abandone seu trabalho atual primeiro"
		end
		if now < (cooldownUntil[player.UserId] or 0) then
			return false, "Aguarde antes de iniciar outro trabalho"
		end
		if not isNearPoint(player, job.StartPoint) then
			return false, "Aproxime-se do ponto de início desta profissão"
		end
		if job.RequiresVehicle and not VehicleService.IsPlayerDrivingOwnedVehicle(player) then
			return false, "Retire um veículo seu e sente-se ao volante para iniciar esta rota"
		end

		local startPoint = findWorkPoint(job.StartPoint)
		local finishPoint = findWorkPoint(job.FinishPoint)
		local root = getPlayerRoot(player)
		if not startPoint or not finishPoint or not root then
			return false, "Os pontos desta rota não estão disponíveis"
		end

		local requiredDistance = (finishPoint.Position - startPoint.Position).Magnitude * MINIMUM_ROUTE_FRACTION
		activeJobs[player.UserId] = {
			JobId = job.Id,
			CreationSubmissionId = job.Id == "world_creator" and HttpService:GenerateGUID(false) or nil,
			StartedAt = now,
			LastPosition = root.Position,
			LastSampleAt = now,
			Character = player.Character,
			TravelledDistance = 0,
			DrivenDistance = 0,
			RequiredDistance = requiredDistance,
			RequiresVehicle = job.RequiresVehicle == true,
			MovementInvalid = false,
		}

		return true,
			{
				Message = "Trabalho iniciado. Siga até o ponto de entrega.",
				ActiveJob = WorkService.GetActiveJob(player),
			}
	end

	if action == "Cancel" then
		local active = activeJobs[player.UserId]
		if not active or active.JobId ~= job.Id then
			return false, "Você não está realizando este trabalho"
		end

		activeJobs[player.UserId] = nil
		cooldownUntil[player.UserId] = now + WORK_CANCEL_COOLDOWN
		return true, {
			Message = "Trabalho abandonado. Nenhuma recompensa foi concedida.",
		}
	end

	if action == "Interact" then
		if typeof(pointName) ~= "string" then
			return false, "Ponto de atividade inválido"
		end
		local active = activeJobs[player.UserId]
		if not active or active.JobId ~= job.Id then
			return false, "Você não está realizando este trabalho"
		end
		sampleMovement(player, active, now)
		if active.MovementInvalid then
			return false, "O percurso foi interrompido. Abandone e comece novamente"
		end

		local activity = (job.Activities or {})[active.ActivityIndex or 1]
		if not activity then
			return false, "Todas as atividades desta profissão já foram concluídas"
		end
		local selectedChoice
		for _, choice in ipairs(activity.Choices) do
			if choice.Point == pointName then
				selectedChoice = choice
				break
			end
		end
		if not selectedChoice then
			return false, "Escolha uma opção da etapa atual indicada pelo marcador"
		end
		if not isNearPoint(player, selectedChoice.Point) then
			return false, "Aproxime-se do ponto da atividade atual"
		end

		active.ActivityChoices = active.ActivityChoices or {}
		active.ActivityChoices[active.ActivityIndex or 1] = selectedChoice.Outcome
		active.ActivityIndex = (active.ActivityIndex or 1) + 1
		local nextActivity = (job.Activities or {})[active.ActivityIndex]
		return true, {
			Message = nextActivity
					and ("Escolha registrada: " .. selectedChoice.Name .. ". Próxima: " .. nextActivity.Label)
				or "Atividades concluídas. Siga até o destino para finalizar.",
			ActiveJob = WorkService.GetActiveJob(player),
		}
	end

	if action == "Complete" then
		local active = activeJobs[player.UserId]
		if not active or active.JobId ~= job.Id then
			return false, "Você não está realizando este trabalho"
		end
		sampleMovement(player, active, now)
		if active.MovementInvalid then
			return false, "O percurso foi interrompido. Abandone e comece novamente"
		end

		if now - active.StartedAt < job.MinimumDuration then
			return false, "Conclua o trajeto antes de solicitar a recompensa"
		end
		if active.TravelledDistance < active.RequiredDistance then
			return false, "Percorra a rota antes de solicitar a recompensa"
		end
		if active.RequiresVehicle and active.DrivenDistance < active.RequiredDistance then
			return false, "Conclua o trajeto dirigindo seu veículo até o destino"
		end
		if (active.ActivityIndex or 1) <= #(job.Activities or {}) then
			return false, "Conclua as atividades da profissão antes de finalizar a rota"
		end

		if not isNearPoint(player, job.FinishPoint) then
			return false, "Vá até o marcador de entrega desta profissão"
		end

		local profile = EconomyService.GetProfile(player)
		if not profile then
			return false, "Perfil do jogador ainda não foi carregado"
		end

		profile.professionCompletions = profile.professionCompletions or {}
		local completions = profile.professionCompletions[job.Id] or 0
		local _, _, rankIndex = getProfessionRank(completions)
		local reward = math.floor(job.Reward * (1 + (rankIndex - 1) * 0.05))
		if job.Id == "world_creator" and not active.CreationSubmitted then
			local choices = active.ActivityChoices or {}
			local submitted, submissionResult =
				CreationService.SubmitWorldConcept(player, active.CreationSubmissionId, choices[1], choices[2])
			if not submitted then
				return false, submissionResult
			end
			active.CreationSubmitted = true
		end
		local paid, reason = EconomyService.AddCredits(player, reward, {
			Type = "JobReward",
			JobId = job.Id,
		})
		if not paid then
			return false, reason
		end

		activeJobs[player.UserId] = nil
		cooldownUntil[player.UserId] = now + WORK_COOLDOWN
		if job.Id == "dj" then
			djBoothAccessUntil[player.UserId] = now + Config.Club.DJBoothAccessDuration
		end
		profile.professionCompletions[job.Id] = math.min(completions + 1, 2_000_000_000)
		AchievementService.RecordJobCompleted(player, job.Id)

		local resultMessage = string.format("Trabalho concluído: +%d Society Credits", reward)
		if active.ActivityChoices and #active.ActivityChoices > 0 then
			resultMessage = resultMessage .. " • Decisões: " .. table.concat(active.ActivityChoices, ", ")
		end
		if job.Id == "world_creator" then
			resultMessage ..= " • Conceito enviado para revisão; publicação depende de aprovação."
		end

		return true,
			{
				Message = resultMessage,
				Reward = reward,
			}
	end

	return false, "Ação de trabalho inválida"
end

task.spawn(function()
	while true do
		task.wait(MOVEMENT_SAMPLE_INTERVAL)
		local now = os.clock()

		for userId, active in pairs(activeJobs) do
			local player = Players:GetPlayerByUserId(userId)
			sampleMovement(player, active, now)
		end
	end
end)

function WorkService.CleanupPlayer(player)
	activeJobs[player.UserId] = nil
	cooldownUntil[player.UserId] = nil
	djBoothAccessUntil[player.UserId] = nil
end

return WorkService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[local WorldBuilder = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Logger = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("Logger"))
local propertyCatalog = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("PropertyCatalog"))

local Config = require(ReplicatedStorage:WaitForChild("HSC"):WaitForChild("Config"))
local WORLD_NAME = Config.Map.WorldName

local COLORS = {
	Asphalt = Color3.fromRGB(39, 43, 52),
	Line = Color3.fromRGB(235, 205, 132),
	Stone = Color3.fromRGB(207, 204, 194),
	White = Color3.fromRGB(232, 229, 218),
	Glass = Color3.fromRGB(121, 177, 191),
	DeepGlass = Color3.fromRGB(52, 94, 112),
	Gold = Color3.fromRGB(218, 180, 91),
	Green = Color3.fromRGB(77, 117, 78),
	DarkGreen = Color3.fromRGB(43, 79, 58),
	Sand = Color3.fromRGB(218, 194, 146),
	Water = Color3.fromRGB(49, 135, 165),
	Wood = Color3.fromRGB(112, 82, 59),
}

local function makePart(parent, name, size, cframe, color, material, transparency, canCollide)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Transparency = transparency or 0
	part.CanCollide = canCollide ~= false
	part.CanTouch = false
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function makeSign(parent, name, text, position, width, color)
	local board = makePart(
		parent,
		name,
		Vector3.new(width, 5, 0.7),
		CFrame.new(position),
		Color3.fromRGB(24, 27, 32),
		Enum.Material.SmoothPlastic
	)
	board.Color = Color3.fromRGB(24, 27, 32)

	local surface = Instance.new("SurfaceGui")
	surface.Name = "SignSurface"
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 32
	surface.Parent = board

	local label = Instance.new("TextLabel")
	label.Name = "Title"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color or COLORS.Gold
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = surface

	return board
end

local function makeBuilding(parent, name, label, center, width, depth, height, accent)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent

	local ground = center.Y
	local wallColor = COLORS.White
	local trimColor = accent or COLORS.Gold

	makePart(
		model,
		"Foundation",
		Vector3.new(width + 4, 1, depth + 4),
		CFrame.new(center.X, ground + 0.5, center.Z),
		COLORS.Stone,
		Enum.Material.Marble
	)
	makePart(
		model,
		"Building",
		Vector3.new(width, height, depth),
		CFrame.new(center.X, ground + height / 2 + 1, center.Z),
		wallColor,
		Enum.Material.SmoothPlastic
	)
	makePart(
		model,
		"Roof",
		Vector3.new(width + 2, 1.2, depth + 2),
		CFrame.new(center.X, ground + height + 1.6, center.Z),
		trimColor,
		Enum.Material.Metal
	)

	local floors = math.max(1, math.floor(height / 10))
	for floorIndex = 0, floors - 1 do
		local y = ground + 5 + floorIndex * 10
		local windowHeight = 5
		local windowWidth = math.max(5, math.min(10, width / 5))

		for _, xDirection in ipairs({ -1, 1 }) do
			local columns = math.max(1, math.floor(width / 15))
			for column = 1, columns do
				local x = center.X - width / 2 + (width / (columns + 1)) * column
				makePart(
					model,
					"Window",
					Vector3.new(windowWidth, windowHeight, 0.25),
					CFrame.new(x, y, center.Z + xDirection * (depth / 2 + 0.14)),
					COLORS.Glass,
					Enum.Material.Glass,
					0.2,
					false
				)
			end
		end
	end

	makePart(
		model,
		"Entrance",
		Vector3.new(6, 8, 0.35),
		CFrame.new(center.X, ground + 4, center.Z - depth / 2 - 0.22),
		COLORS.DeepGlass,
		Enum.Material.Glass,
		0.15,
		false
	)
	makePart(
		model,
		"Canopy",
		Vector3.new(width * 0.48, 0.8, 5),
		CFrame.new(center.X, ground + 8.5, center.Z - depth / 2 - 2),
		trimColor,
		Enum.Material.Metal
	)
	makeSign(
		model,
		"DistrictSign",
		label,
		Vector3.new(center.X, ground + height + 5, center.Z - depth / 2 - 1),
		math.min(width, 36),
		trimColor
	)

	return model
end

local function makeResidence(parent, name, label, propertyId, center, width, depth, accent)
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("PropertyId", propertyId)
	model.Parent = parent

	local wallHeight = 14
	makePart(
		model,
		"Foundation",
		Vector3.new(width + 4, 1, depth + 4),
		CFrame.new(center.X, center.Y + 0.5, center.Z),
		COLORS.Stone,
		Enum.Material.Marble
	)
	makePart(
		model,
		"InteriorFloor",
		Vector3.new(width, 0.35, depth),
		CFrame.new(center.X, center.Y + 1.15, center.Z),
		COLORS.Wood,
		Enum.Material.WoodPlanks
	)

	local wallY = center.Y + 1 + wallHeight / 2
	makePart(
		model,
		"BackWall",
		Vector3.new(width, wallHeight, 0.8),
		CFrame.new(center.X, wallY, center.Z + depth / 2),
		COLORS.White,
		Enum.Material.SmoothPlastic
	)
	local doorwayWidth = 8
	local frontSectionWidth = (width - doorwayWidth) / 2
	for _, side in ipairs({ -1, 1 }) do
		makePart(
			model,
			"FrontWall",
			Vector3.new(frontSectionWidth, wallHeight, 0.8),
			CFrame.new(center.X + side * (doorwayWidth + frontSectionWidth) / 2, wallY, center.Z - depth / 2),
			COLORS.White,
			Enum.Material.SmoothPlastic
		)
	end
	makePart(
		model,
		"DoorLintel",
		Vector3.new(doorwayWidth, wallHeight - 8, 0.8),
		CFrame.new(center.X, center.Y + 1 + 8 + (wallHeight - 8) / 2, center.Z - depth / 2),
		COLORS.White,
		Enum.Material.SmoothPlastic
	)
	for _, side in ipairs({ -1, 1 }) do
		makePart(
			model,
			"SideWall",
			Vector3.new(0.8, wallHeight, depth),
			CFrame.new(center.X + side * width / 2, wallY, center.Z),
			COLORS.White,
			Enum.Material.SmoothPlastic
		)
	end
	makePart(
		model,
		"Roof",
		Vector3.new(width + 2, 1, depth + 2),
		CFrame.new(center.X, center.Y + wallHeight + 1.5, center.Z),
		accent,
		Enum.Material.Metal
	)
	makeSign(
		model,
		"ResidenceSign",
		label,
		Vector3.new(center.X, center.Y + wallHeight + 5, center.Z - depth / 2 - 1),
		math.min(width, 36),
		accent
	)
	local spawnPoint = makePart(
		model,
		"SpawnPoint",
		Vector3.new(2, 0.2, 2),
		CFrame.new(center.X, center.Y + 1.4, center.Z - 2),
		COLORS.Gold,
		Enum.Material.SmoothPlastic,
		1,
		false
	)
	spawnPoint.CastShadow = false
	local exitPrompt = Instance.new("ProximityPrompt")
	exitPrompt.Name = "PropertyExitPrompt"
	exitPrompt.ActionText = "Sair"
	exitPrompt.ObjectText = "Voltar para a cidade"
	exitPrompt.MaxActivationDistance = 10
	exitPrompt.HoldDuration = 0
	exitPrompt.RequiresLineOfSight = false
	exitPrompt.Parent = spawnPoint

	local purchasePoint = makePart(
		model,
		"PropertyPurchasePoint",
		Vector3.new(4, 2, 4),
		CFrame.new(center.X, center.Y + 1, center.Z - depth / 2 - 7),
		accent,
		Enum.Material.Metal
	)
	purchasePoint:SetAttribute("PropertyId", propertyId)
	purchasePoint.CanCollide = false

	makePart(
		model,
		"LuxuryBed",
		Vector3.new(8, 1, 6),
		CFrame.new(center.X + width * 0.27, center.Y + 1.85, center.Z + depth * 0.2),
		COLORS.White,
		Enum.Material.Fabric
	)
	makePart(
		model,
		"Headboard",
		Vector3.new(8.5, 3, 0.6),
		CFrame.new(center.X + width * 0.27, center.Y + 2.7, center.Z + depth * 0.38),
		accent,
		Enum.Material.Wood
	)
	makePart(
		model,
		"LoungeSofa",
		Vector3.new(8, 2, 3),
		CFrame.new(center.X - width * 0.23, center.Y + 2.4, center.Z - depth * 0.22),
		accent,
		Enum.Material.Fabric
	)
	makePart(
		model,
		"LoungeTable",
		Vector3.new(4, 1.2, 3),
		CFrame.new(center.X - width * 0.23, center.Y + 2, center.Z + depth * 0.02),
		COLORS.Wood,
		Enum.Material.Wood
	)

	local ceilingLight = makePart(
		model,
		"CeilingLight",
		Vector3.new(3, 0.25, 3),
		CFrame.new(center.X, center.Y + wallHeight + 0.9, center.Z),
		Color3.fromRGB(255, 235, 190),
		Enum.Material.Neon,
		0,
		false
	)
	local pointLight = Instance.new("PointLight")
	pointLight.Name = "InteriorLight"
	pointLight.Color = Color3.fromRGB(255, 225, 175)
	pointLight.Range = 26
	pointLight.Brightness = 1.5
	pointLight.Parent = ceilingLight

	return model
end

local function makeTree(parent, name, x, groundY, z, scale)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent

	local trunkHeight = 7 * scale
	makePart(
		model,
		"Trunk",
		Vector3.new(1.5 * scale, trunkHeight, 1.5 * scale),
		CFrame.new(x, groundY + trunkHeight / 2, z),
		COLORS.Wood,
		Enum.Material.Wood
	)

	for layer = 1, 3 do
		local size = (9 - layer * 1.4) * scale
		local height = (5 + layer * 2) * scale
		makePart(
			model,
			"Canopy",
			Vector3.new(size, height, size),
			CFrame.new(x, groundY + trunkHeight + layer * 2 * scale, z),
			layer == 1 and COLORS.DarkGreen or COLORS.Green,
			Enum.Material.Grass,
			0,
			false
		).Shape =
			Enum.PartType.Ball
	end
end

local function makeDistrictPath(parent, name, groundY, startX, startZ, endX, endZ, width)
	local midpoint = Vector3.new((startX + endX) / 2, groundY + 0.15, (startZ + endZ) / 2)
	local deltaX = endX - startX
	local deltaZ = endZ - startZ
	local length = math.sqrt(deltaX * deltaX + deltaZ * deltaZ)
	local yaw = math.atan2(deltaZ, deltaX)

	return makePart(
		parent,
		name,
		Vector3.new(length, 0.3, width),
		CFrame.new(midpoint) * CFrame.Angles(0, -yaw, 0),
		COLORS.Stone,
		Enum.Material.Concrete
	)
end

local function makeWorkPoint(parent, name, actionText, objectText, position)
	local point = makePart(parent, name, Vector3.new(4, 3, 4), CFrame.new(position), COLORS.Gold, Enum.Material.Metal)
	point:SetAttribute("InteractionPoint", true)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WorkPrompt"
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false
	prompt.Parent = point

	return point
end

local function makeShopPoint(parent, position)
	local point = makePart(
		parent,
		"ShopPoint",
		Vector3.new(4, 3, 4),
		CFrame.new(position),
		Color3.fromRGB(190, 139, 173),
		Enum.Material.Metal
	)
	point:SetAttribute("InteractionPoint", true)
	point:SetAttribute("ShopId", "fashion_avenue")
	point:SetAttribute("ShopName", "Fashion Avenue")

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ShopPrompt"
	prompt.ActionText = "Abrir loja"
	prompt.ObjectText = "Fashion Avenue"
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false
	prompt.Parent = point

	return point
end

local function ensureVehiclePoint(world, name, actionText, objectText, position)
	local point = workspace:FindFirstChild(name)
	if not point then
		point = world:FindFirstChild(name, true)
	end
	if not point then
		point = makePart(
			world,
			name,
			Vector3.new(4, 2, 4),
			CFrame.new(position),
			COLORS.Gold,
			Enum.Material.Metal,
			0.35,
			false
		)
		point.CanTouch = true
	end

	if not point:IsA("BasePart") then
		error(string.format("%s precisa ser uma BasePart", point:GetFullName()))
	end

	point:SetAttribute("InteractionPoint", true)
	local promptNames = {
		DealershipPurchasePoint = "PurchasePrompt",
		GaragePoint = "GaragePrompt",
		VehicleSpawnPoint = "SpawnVehiclePrompt",
		BoatPurchasePoint = "BoatPurchasePrompt",
		BoatStorePoint = "BoatStorePrompt",
	}
	local promptName = promptNames[name]
	if not promptName then
		error(string.format("Ponto de veículo sem prompt configurado: %s", name))
	end
	local prompt = point:FindFirstChild(promptName)
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = promptName
		prompt.Parent = point
	elseif not prompt:IsA("ProximityPrompt") then
		error(string.format("%s.%s precisa ser um ProximityPrompt", point:GetFullName(), promptName))
	end

	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false
	return point
end

local function ensureVehiclePoints(world, groundY)
	ensureVehiclePoint(
		world,
		"DealershipPurchasePoint",
		"Ver veículos",
		"Automotive Gallery",
		Vector3.new(93, groundY + 2, -132)
	)
	ensureVehiclePoint(world, "GaragePoint", "Abrir garagem", "Garagem do clube", Vector3.new(126, groundY + 2, -112))
	ensureVehiclePoint(
		world,
		"VehicleSpawnPoint",
		"Retirar veículo",
		"Ponto de saída",
		Vector3.new(138, groundY + 1, -112)
	)
	ensureVehiclePoint(world, "BoatPurchasePoint", "Ver lanchas", "Royal Marina", Vector3.new(204, groundY + 2, 202))
	ensureVehiclePoint(world, "BoatStorePoint", "Guardar lancha", "Royal Marina", Vector3.new(204, groundY + 2, 230))

	local spawnPoint = world:FindFirstChild("BoatSpawnPoint", true)
	if not spawnPoint then
		spawnPoint = makePart(
			world,
			"BoatSpawnPoint",
			Vector3.new(2, 0.2, 2),
			CFrame.new(187, groundY + 0.28, 218),
			COLORS.Water,
			Enum.Material.Glass,
			1,
			false
		)
		spawnPoint.CastShadow = false
	elseif not spawnPoint:IsA("BasePart") then
		error("Workspace.HighSocietyWorld.BoatSpawnPoint precisa ser uma BasePart")
	end

	local marina = world:FindFirstChild("ParadiseIslandAndRoyalMarina")
	local water = marina and marina:FindFirstChild("MarinaWater")
	if water and water:IsA("BasePart") then
		water:SetAttribute("HSCWaterSurface", true)
	end
end

local function makeEventPoint(parent, name, eventName, position)
	local point = makePart(parent, name, Vector3.new(4, 2, 4), CFrame.new(position), COLORS.Gold, Enum.Material.Neon)
	point:SetAttribute("EventId", name)
	point.CanCollide = false

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EventPrompt"
	prompt.ActionText = "Participar"
	prompt.ObjectText = eventName
	prompt.MaxActivationDistance = 12
	prompt.HoldDuration = 0.3
	prompt.RequiresLineOfSight = false
	prompt.Parent = point

	local light = Instance.new("PointLight")
	light.Name = "EventGlow"
	light.Color = COLORS.Gold
	light.Range = 14
	light.Brightness = 0.8
	light.Parent = point

	return point
end

